---
import '@fontsource/caveat/400.css';
import { site } from '../config/site';
const notes = [
  {id:'maker',label:'The maker',object:'Mascot',title:'A curious person, a growing experiment.',copy:'I’m the maker behind Smart Mushroom Hub. A fascination with mushrooms led me from small at-home growing experiments to building an automated habitat of my own.',aside:'Start with curiosity. Keep following it.',link:'/documentation/#notebook-idea',action:'Where the idea began'},
  {id:'mushrooms',label:'The fascination',object:'Mushroom',title:'A world worth looking closer at.',copy:'Mushrooms caught my attention because of how distinct they are from plants: how they consume their substrate, and how diverse and colourful they can be. Growing them brought that fascination into my home.',aside:'There is always something new to notice.',link:'/#cultivation',action:'Explore cultivation'},
  {id:'software',label:'The code',object:'Laptop',title:'Connecting the pieces.',copy:'This project brings together a Raspberry Pi, environmental sensors, automation, and scheduled photographs. I’m also exploring YOLO computer vision as another way to observe the mushrooms as they grow.',aside:'Observe. Respond. Record.',link:'/#architecture',action:'Follow the connected system'},
  {id:'building',label:'The build',object:'Tools',title:'Made by hand, one piece at a time.',copy:'I couldn’t find a Martha tent locally in Egypt, so I built the growing structure from PVC. The process involved cutting pipes, adding reinforcement, fitting the covering, and learning through each practical problem.',aside:'Measure, assemble, rethink, repeat.',link:'/documentation/#journey-pvc-pipes',action:'See the build notes'},
  {id:'learning',label:'The learning',object:'Notebook',title:'Leave room for the next question.',copy:'The notebook holds the decisions, tests, and mistakes behind the build. I’m interested in how controlled conditions affect mushroom yield and health, and in what careful observation can teach me along the way.',aside:'The unfinished parts belong here, too.',link:'/documentation/#notebook-journey',action:'Open the journey'},
  {id:'links',label:'Find the work',object:'Envelope',title:'Keep exploring.',copy:'The field notes document the materials, hardware, software, and cultivation journey. Start there for the story behind the experiment, or explore the interactive habitat to see how its pieces fit together.',aside:'A little more of the story, on every page.',link:'/documentation/',action:'Read the field notes'},
];
---
<section class="workspace" data-about-workspace aria-labelledby="workspace-title">
  <header class="workspace-header"><div><p class="eyebrow">BEHIND THE HABITAT</p><h2 id="workspace-title">Welcome to my little corner.</h2></div><button type="button" data-workspace-sound aria-pressed="true" hidden>Paper sound · On</button></header>
  <div class="workspace-layout">
    <div class="workspace-scene" role="group" aria-label="Explore the maker’s illustrated workspace">
      <span class="scene-handwritten">a few things that make me, me</span>
      <svg class="workspace-drawing" viewBox="0 0 800 650" fill="none" aria-hidden="true">
        <path d="M44 570L400 614 758 542M110 490V586M698 461V560" stroke="#a6a58c" stroke-width="3"/>
        <path d="M43 438L576 404 761 469 238 524Z" fill="#ddd1b7" stroke="#a6a58c" stroke-width="2"/>
        <path d="M43 438V454L238 541 761 485V469M238 524V541" stroke="#a6a58c" stroke-width="2"/>
        <path d="M603 133L715 157V320L603 296ZM603 133L559 161V322L603 296M559 161L675 187 715 157M675 187V345L559 322M575 229L699 252M603 202L559 226" stroke="#a5ad94" stroke-width="5" stroke-linejoin="round"/>
        <path d="M559 161L675 187 715 157V320L675 345 559 322Z" fill="#d4dec32a" stroke="#a5ad94"/>
        <path d="M629 194V221M611 229Q628 214 643 230L648 273Q626 286 606 270Z" stroke="#969b80" stroke-width="2" fill="#e4ddc9"/>
        <path d="M92 119Q103 92 134 95M125 87L137 95 125 106M735 379q20 13 5 36" stroke="#bf7854" stroke-width="2" stroke-linecap="round"/>
        <path d="M88 316l8-11m-2 19 15-2M736 106v18m-9-9h18" stroke="#adad8c" stroke-width="2"/>
      </svg>
      <button class="workspace-object mascot" data-note="maker" aria-controls="about-note-maker" aria-pressed="true"><span class="mascot-frame"><img src="/media/about/mascot.png" width="1254" height="1254" alt="Cream-coloured fluffy mascot with small feet and big brown eyes" loading="eager" /></span><span class="object-label">01 · The maker</span></button>
      <button class="workspace-object specimen" data-note="mushrooms" aria-controls="about-note-mushrooms" aria-pressed="false"><svg viewBox="0 0 130 150" aria-hidden="true"><ellipse cx="67" cy="134" rx="47" ry="9" fill="#c5bba5"/><path d="M57 64q7 37-5 57 16 12 31 0-13-28-9-56" fill="#f6ead5" stroke="#887b61" stroke-width="2"/><path d="M13 64Q24 3 65 15q38 4 52 52-46 21-104-3Z" fill="#bd7451" stroke="#887b61" stroke-width="2"/><path d="M25 65q42-12 79 3M47 39l10-8m22 12 9 8" fill="none" stroke="#eac89b" stroke-width="4" stroke-linecap="round"/></svg><span class="object-label">02 · Mushrooms</span></button>
      <button class="workspace-object laptop" data-note="software" aria-controls="about-note-software" aria-pressed="false"><svg viewBox="0 0 210 155" fill="none" aria-hidden="true"><path d="M38 10h141v103H38Z" fill="#657b70" stroke="#42574f" stroke-width="3"/><path d="M48 21h121v80H48Z" fill="#e6ecdb"/><path d="m79 42-15 13 15 12m53-25 15 13-15 12m-18-30-13 39" stroke="#aa684b" stroke-width="4"/><path d="M38 113 9 139q94 15 191 0l-21-26Z" fill="#a5b19e" stroke="#42574f" stroke-width="2"/><path d="M52 122h116m-74 12h29" stroke="#657b70" stroke-width="3"/></svg><span class="object-label">03 · Code & vision</span></button>
      <button class="workspace-object tools" data-note="building" aria-controls="about-note-building" aria-pressed="false"><svg viewBox="0 0 150 95" fill="none" aria-hidden="true"><path d="m19 68 93-46 12 22-93 46Z" fill="#d9bc7d" stroke="#99825e" stroke-width="2"/><path d="m39 59 5 10m11-18 5 10m12-19 5 10m11-18 5 10" stroke="#99825e" stroke-width="2"/><path d="m35 15 67 53" stroke="#8e9b94" stroke-width="9"/><path d="m86 56 28 23" stroke="#ac694e" stroke-width="16" stroke-linecap="round"/></svg><span class="object-label">04 · Built by hand</span></button>
      <button class="workspace-object journal" data-note="learning" aria-controls="about-note-learning" aria-pressed="false"><svg viewBox="0 0 140 130" fill="none" aria-hidden="true"><path d="m25 12 99 9-10 103-99-9Z" fill="#8f9c76" stroke="#657657" stroke-width="2"/><path d="m32 15-10 101m96-5-91-9" stroke="#f1e7cb" stroke-width="3"/><path d="m50 38 53 5-4 36-53-5Z" fill="#efe7d4"/><path d="m54 52 37 3m-38 8 29 3" stroke="#a09a7d" stroke-width="2"/><path d="m91 118-1-27 13 1-2 27-5-6Z" fill="#c07b55"/></svg><span class="object-label">05 · Field notes</span></button>
      <button class="workspace-object envelope" data-note="links" aria-controls="about-note-links" aria-pressed="false"><svg viewBox="0 0 130 100" fill="none" aria-hidden="true"><path d="m12 20 106-6 5 69-106 6Z" fill="#efe1c2" stroke="#a19476" stroke-width="2"/><path d="m12 20 56 38 50-44M17 89l36-40m70 34-42-37" stroke="#a19476" stroke-width="2"/><circle cx="69" cy="57" r="9" fill="#bd7655"/></svg><span class="object-label">06 · Find the work</span></button>
      <span class="scene-caption">A small workspace. A lot of curiosity.</span>
    </div>
    <div class="workspace-notes" aria-live="polite" aria-atomic="true">
      {notes.map((note,i)=><article class="workspace-note" id={`about-note-${note.id}`} data-workspace-note={note.id}>
        <span class="note-tape" aria-hidden="true"></span><p class="note-number">A NOTE ABOUT {note.label.toUpperCase()} <span>0{i+1} / 06</span></p>
        <h3>{note.title}</h3><p class="note-copy">{note.copy}</p><p class="note-aside">{note.aside}</p><a href={note.link}>{note.action} <span aria-hidden="true">↗</span></a>
        {note.id==='links'&&site.githubUrl&&<a href={site.githubUrl}>Explore GitHub <span aria-hidden="true">↗</span></a>}
      </article>)}
    </div>
  </div>
  <nav class="workspace-tabs" aria-label="Workspace notes">{notes.map((note,i)=><button type="button" data-note={note.id} aria-controls={`about-note-${note.id}`} aria-pressed={i===0?'true':'false'}><span>0{i+1}</span>{note.label}</button>)}</nav>
</section>
<script>
  const workspace=document.querySelector<HTMLElement>('[data-about-workspace]');
  if(workspace){
    const buttons=[...workspace.querySelectorAll<HTMLButtonElement>('[data-note]')];
    const notes=[...workspace.querySelectorAll<HTMLElement>('[data-workspace-note]')];
    const soundButton=workspace.querySelector<HTMLButtonElement>('[data-workspace-sound]')!;
    const reduced=matchMedia('(prefers-reduced-motion:reduce)');
    const audio=new Audio('/media/study/paper-swipe.mp3');audio.preload='none';audio.volume=.3;
    let sound=true;let noteAnimation:Animation|undefined;let mascotAnimation:Animation|undefined;
    const select=(id:string,animate=false)=>{
      buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.note===id)));
      notes.forEach(note=>note.hidden=note.dataset.workspaceNote!==id);
      noteAnimation?.cancel();mascotAnimation?.cancel();
      if(animate){
        if(sound){audio.pause();audio.currentTime=0;void audio.play().catch(()=>{});}
        if(!reduced.matches){
          noteAnimation=notes.find(note=>!note.hidden)!.animate([{opacity:.3,transform:'translateY(10px) rotate(-1deg)'},{opacity:1,transform:'translateY(0) rotate(0)'}],{duration:340,easing:'ease-out'});
          if(id==='maker')mascotAnimation=workspace.querySelector('.mascot-frame')!.animate([{transform:'rotate(-3deg)'},{transform:'translateY(-9px) rotate(3deg)'},{transform:'rotate(-3deg)'}],{duration:600,easing:'ease-in-out'});
        }
      }
    };
    buttons.forEach(button=>button.addEventListener('click',()=>select(button.dataset.note!,true)));
    soundButton.hidden=false;soundButton.addEventListener('click',()=>{sound=!sound;soundButton.setAttribute('aria-pressed',String(sound));soundButton.textContent=`Paper sound · ${sound?'On':'Off'}`;if(!sound)audio.pause();});
    select('maker');workspace.dataset.enhanced='true';
  }
</script>
<style>
  .workspace{padding:55px 0 65px;border-bottom:1px solid var(--line)}.workspace-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:35px}.workspace-header .eyebrow{font-size:9px;color:var(--olive);margin-bottom:13px}.workspace-header h2{font-size:clamp(30px,3vw,45px);letter-spacing:-.025em}.workspace-header button{background:transparent;border-bottom:1px solid var(--line);min-height:44px;font-size:11px;color:var(--muted);white-space:nowrap}.workspace-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,1fr);gap:clamp(25px,4vw,65px);align-items:center}.workspace-scene{position:relative;aspect-ratio:800/650;background:radial-gradient(ellipse at 48% 54%,#e9e3d3 0%,#f0ece1 52%,transparent 72%);isolation:isolate}.workspace-drawing{position:absolute;inset:0;width:100%;height:100%}.scene-handwritten,.scene-caption{position:absolute;font-family:'Caveat',cursive;color:#858b70;text-align:center;pointer-events:none}.scene-handwritten{left:12%;top:3%;font-size:clamp(17px,2vw,29px);transform:rotate(-4deg)}.scene-caption{bottom:0;left:0;width:100%;font-size:22px}.workspace-object{position:absolute;padding:0;border:0;background:transparent;cursor:pointer;color:var(--ink);transition:filter .2s,translate .2s;min-height:44px}.workspace-object:hover{translate:0 -5px;filter:drop-shadow(0 5px 4px #66573a25)}.workspace-object svg{display:block;width:100%;overflow:visible}.object-label{display:block;font-family:'Caveat',cursive;font-size:clamp(14px,1.6vw,22px);white-space:nowrap;text-align:center;padding:3px 5px;border-radius:3px;background:#f6f3ebe8}.workspace-object[aria-pressed=true] .object-label{color:#a2593d;text-decoration:underline;text-underline-offset:5px}.mascot{left:28%;top:15%;width:34%;z-index:1}.mascot-frame{display:block;padding:9px 9px 25px;background:#fffaf0;box-shadow:0 9px 20px #54452926;transform:rotate(-3deg)}.mascot img{width:100%;height:auto}.mascot-frame:before{content:'';position:absolute;top:-10px;left:30%;width:43%;height:23px;background:#d4d8baaa;transform:rotate(5deg)}.mascot .object-label{margin-top:12px;background:none}.specimen{left:4%;top:43%;width:17%;transform:rotate(-7deg)}.laptop{left:29%;top:64%;width:26%;z-index:2}.tools{left:4%;top:73%;width:20%;transform:rotate(4deg)}.journal{left:61%;top:65%;width:18%;transform:rotate(8deg);z-index:2}.envelope{right:1%;top:52%;width:17%;transform:rotate(10deg)}.workspace-note{position:relative;padding:38px 33px 30px;background:repeating-linear-gradient(transparent 0 31px,#b6b69526 31px 32px),#f5edda;box-shadow:2px 6px 16px #594d3020;border:1px solid #ded5bc;margin:22px 0}.note-tape{position:absolute;top:-13px;left:33%;height:27px;width:34%;background:#c8cfa99c;transform:rotate(-4deg)}.note-number{display:flex;gap:15px;justify-content:space-between;font-size:8px;letter-spacing:.1em;color:#87816a}.note-number span{white-space:nowrap}.workspace-note h3{font-family:'Caveat',cursive;font-size:clamp(32px,3.2vw,47px);line-height:1.04;margin:30px 0 21px;color:#415447}.note-copy{font-size:14px;line-height:1.95;color:#626653}.note-aside{font-family:'Caveat',cursive;font-size:25px;color:#ab6c4c;margin:23px 0}.workspace-note a{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:44px;border-top:1px solid #ccc5af;text-decoration:none;font-size:11px;color:#53634e}.workspace-tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:35px}.workspace-tabs button{display:flex;gap:10px;align-items:center;min-height:44px;padding:10px 15px;background:#eee9dd;border:1px solid #dcd8c9;color:#707660;font-family:'Caveat',cursive;font-size:21px;border-radius:3px}.workspace-tabs button span{font-family:var(--font-body);font-size:9px;color:#a77155}.workspace-tabs button[aria-pressed=true]{background:#e3e7d5;border-color:#9aa786;color:#334d3c}.workspace:not([data-enhanced]) .workspace-layout{align-items:start}.workspace:not([data-enhanced]) .workspace-tabs{display:none}
  @media(max-width:1000px){.workspace-layout{grid-template-columns:minmax(0,1.2fr) minmax(280px,1fr);gap:20px}.workspace-note{padding:30px 23px}.object-label{font-size:15px}.scene-caption{font-size:18px}}
  @media(max-width:760px){.workspace{padding:40px 0}.workspace-header{align-items:start;gap:10px}.workspace-header h2{font-size:32px}.workspace-header button{font-size:9px}.workspace-layout{grid-template-columns:1fr;gap:12px}.workspace-scene{width:100%;max-width:580px;margin:auto}.workspace-note{margin:20px 0 0;min-height:360px}.workspace-note h3{font-size:37px}.workspace-tabs{margin-top:20px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.workspace-tabs button{font-size:20px}.scene-handwritten{font-size:19px}.scene-caption{font-size:19px}.object-label{font-size:14px}}
  @media(max-width:480px){.object-label{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.scene-caption{font-size:17px;bottom:-12px}.workspace-scene{margin-bottom:18px}.mascot .object-label{margin:-1px}.mascot-frame{padding:5px 5px 13px}.workspace-object[aria-pressed=true]{filter:drop-shadow(0 0 4px #be7a52aa)}}
  @media(prefers-reduced-motion:reduce){.workspace-object{transition:none}.workspace-object:hover{translate:none}}
</style>
