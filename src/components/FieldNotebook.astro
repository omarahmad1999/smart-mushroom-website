---
import '@fontsource/caveat/400.css';
import JourneyNotes from './JourneyNotes.astro';
import BuildPhotos from './BuildPhotos.astro';
import JourneyPhotoCollection from './JourneyPhotoCollection.astro';
import type { MarkdownInstance } from 'astro';
interface Entry { order:number; slug:string; tab:string; kicker?:string; title:string; image:string; alt:string; caption:string; source:string; scribble:string; note:string; annotation:string; x:number; y:number; reference:string }
const entries = Object.values(import.meta.glob<MarkdownInstance<Entry>>('../content/notebook/*.md', { eager:true })).sort((a,b)=>a.frontmatter.order-b.frontmatter.order);
const journeyMedia=[
  {slug:'pvc-pipes',title:'PVC Pipes',heading:'From cut pipe to reinforced frame.'},
  {slug:'transparent-plastic',title:'Transparent Plastic',heading:'Wrapping the growing space.'},
  {slug:'raspberry-pi',title:'Raspberry Pi',heading:'The hardware takes shape.'},
  {slug:'fan',title:'Fan',heading:'Testing the airflow.'},
  {slug:'humidifier',title:'Humidifier',heading:'Preparing a source of moisture.'},
  {slug:'led',title:'LED',heading:'Bringing light into the tent.'},
  {slug:'white-car-vinyl',title:'White Car Vinyl',heading:'Making more of the available light.'},
  {slug:'sensors',title:'Sensors',heading:'From bench tests to the tent.'},
  {slug:'ups',title:'UPS',heading:'Keeping the system powered.'},
];
---
<section class="notebook" data-notebook aria-label="Interactive field notebook">
  <header class="nb-intro">
    <div><p class="eyebrow"><span class="eyebrow-dot"></span> THE PROJECT NOTEBOOK</p><h1>Notes from<br /><em>inside the system.</em></h1></div>
    <p class="nb-intro-note">A few questions.<br />A lot of looking closely.<svg viewBox="0 0 110 50" fill="none" aria-hidden="true"><path d="M8 7Q84 0 84 38M71 29l14 12 13-15" /></svg></p>
  </header>
  <div class="nb-toolbar"><span>FIELD NOTES <span aria-hidden="true">/</span> VOLUME 01</span><button class="nb-show-cover" data-nb-show-cover hidden>View cover</button><details class="nb-contents"><summary>In this notebook <span aria-hidden="true">＋</span></summary><nav aria-label="Notebook contents">{entries.map(({frontmatter:e},i)=><a href={`#notebook-${e.slug}`} data-nb-jump={i}><span>0{i+1}</span>{e.tab}</a>)}<a href="#reference-notes">Full reference notes ↗</a></nav></details></div>
  <nav class="nb-tabs" aria-label="Notebook sections">{entries.map(({frontmatter:e},i)=><a href={`#notebook-${e.slug}`} data-nb-jump={i}><span>0{i+1}</span>{e.tab}</a>)}</nav>
  <div class="nb-binding" data-nb-binding tabindex="-1">
    <div class="nb-cover" data-nb-cover hidden>
      <p class="nb-cover-edition">SMART MUSHROOM HUB <span>/</span> VOLUME 01</p>
      <h2>Field notebook</h2>
      <p class="nb-cover-subtitle">A little growing, a little learning.</p>
      <div class="nb-cover-art"><video data-nb-cover-video muted playsinline loop preload="none" poster="/media/notebook/cover/mushroom-growth-poster.webp" aria-label="Hand-drawn oyster mushrooms growing from tiny pins into open caps"><source src="/media/notebook/cover/mushroom-growth.mp4" type="video/mp4" /></video></div>
      <div class="nb-cover-actions"><button class="nb-open-cover" data-nb-open-cover>Open the notebook <span aria-hidden="true">↗</span></button><button class="nb-cover-pause" data-nb-cover-pause aria-label="Pause cover animation">Pause animation</button></div>
      <p class="nb-cover-caption">An illustrated growth sequence · Pencil & coloured pencil</p>
    </div>
    <div class="nb-spreads">
      {entries.map(({frontmatter:e,Content},i)=><article class="nb-spread" id={`notebook-${e.slug}`} data-nb-spread={i} aria-label={e.tab}>
        <div class="nb-page nb-photo-page" data-nb-page={i*2}>
          <div class="nb-running"><span>SMART MUSHROOM HUB</span><span>COLLECTED OBSERVATIONS</span></div>
          <p class="nb-scribble">{e.scribble}</p>
          {e.slug==='build' ? <BuildPhotos /> : <figure class:list={['nb-photo',{'nb-portrait':e.slug==='build'||e.slug==='lessons'}]}>
            <a href={e.image} data-nb-image data-caption={`${e.caption}. ${e.source}.`} aria-label={`Enlarge photograph: ${e.caption}`}><img src={e.image} alt={e.alt} loading={i===0?'eager':'lazy'} width={e.slug==='build'||e.slug==='lessons'?1200:1600} height={e.slug==='build'||e.slug==='lessons'?1600:900} /></a>
            <details class="nb-annotation" style={`--pin-x:${e.x}%;--pin-y:${e.y}%`}><summary aria-label={`Photo note: ${e.tab}`}>1</summary><p>{e.annotation}</p></details>
            <figcaption>{e.caption}</figcaption>
          </figure>}
          <p class="nb-source">{e.source}</p>
          <p class="nb-margin-note"><span aria-hidden="true">↳</span> {e.note}</p>
          {e.slug==='journey' && journeyMedia.map(media=><aside class="nb-journey-photo-board" data-journey-photo-board={media.slug} hidden aria-label={`${media.title} build photographs`}><p class="nb-journey-photo-kicker">THE JOURNEY / {media.title.toUpperCase()}</p><h2>{media.heading}</h2><JourneyPhotoCollection section={media.slug} interactive /></aside>)}
          <div class="nb-folio"><span>CLICK THE PHOTO TO LOOK CLOSER</span><span>{String(i*2+1).padStart(2,'0')}</span></div>
        </div>
        <div class:list={["nb-page", "nb-writing-page", {"nb-without-kicker": ["idea", "build"].includes(e.slug),"nb-journey-page":e.slug==='journey'}]} data-nb-page={i*2+1}>
          <div class="nb-running"><span>0{i+1} / {e.tab.toUpperCase()}</span><span>RESEARCH IN PROGRESS</span></div>
          {e.slug!=='journey' && <>{!["idea", "build"].includes(e.slug) && <p class="nb-kicker">{e.kicker}</p>}<h2>{e.title}</h2></>}
          {e.slug==='journey' ? <JourneyNotes /> : <div class="nb-entry"><Content /></div>}
          {!['idea','build','journey'].includes(e.slug) && <div class="nb-reference nb-reference-placeholder" aria-hidden="true"><span>&#160;</span><span>↗</span></div>}
          {["idea", "build"].includes(e.slug) && <div class="nb-kicker nb-kicker-spacer" aria-hidden="true">&#160;</div>}
          <div class="nb-folio"><span>SMART MUSHROOM HUB / FIELD NOTES</span><span>{String(i*2+2).padStart(2,'0')}</span></div>
        </div>
      </article>)}
    </div>
    <div class="nb-fold" data-nb-fold aria-hidden="true"></div>
    <button class="nb-corner nb-corner-prev" data-nb-prev aria-label="Turn to previous page" hidden></button><button class="nb-corner nb-corner-next" data-nb-next aria-label="Turn to next page" hidden></button>
  </div>
  <div class="nb-controls" data-nb-controls hidden><button data-nb-prev aria-label="Previous notebook page">← <span>Previous</span></button><p data-nb-status role="status" aria-live="polite" aria-atomic="true"></p><button data-nb-next aria-label="Next notebook page"><span>Turn the page</span> →</button></div>
  <p class="nb-hint" data-nb-hint hidden>Choose a tab, turn a corner, or use the arrow keys. <span>On your phone, swipe across the paper.</span></p>
  <dialog class="nb-design-dialog" data-initial-design-dialog aria-labelledby="nb-design-title">
    <button class="nb-design-close" data-initial-design-close aria-label="Close initial design">Close <span aria-hidden="true">×</span></button>
    <article class="nb-design-sheet">
      <header><p>CRAFTY AMIGO / FIRST DRAFT</p><h2 id="nb-design-title">Initial design</h2></header>
      <div class="nb-design-grid">
        <figure><img src="/media/notebook/journey/pvc/00-initial-tent-design.webp" alt="Initial three-dimensional PVC tent design created in Crafty Amigo" width="1200" height="1104" /></figure>
        <section aria-labelledby="nb-cut-list-title">
          <p class="nb-design-note">The first calculation</p>
          <h3 id="nb-cut-list-title">PVC cut list</h3>
          <table aria-label="Initial PVC design parts list">
            <thead><tr><th scope="col">Quantity</th><th scope="col">Part</th></tr></thead>
            <tbody>
              <tr><td>42</td><td>T joints</td></tr>
              <tr><td>42</td><td>6-inch pieces</td></tr>
              <tr><td>14</td><td>18-inch pieces</td></tr>
              <tr><td>4</td><td>12-inch pieces</td></tr>
              <tr><td>2</td><td>28-inch pieces</td></tr>
              <tr><td>4</td><td>16.75-inch pieces</td></tr>
            </tbody>
          </table>
        </section>
      </div>
    </article>
  </dialog>
  <dialog class="nb-journey-photos-dialog" data-journey-photos-dialog aria-labelledby="nb-journey-photos-title">
    <button class="nb-journey-photos-close" data-journey-photos-close aria-label="Close Journey photographs">Close <span aria-hidden="true">×</span></button>
    <article><p>THE JOURNEY / <span data-journey-photos-name></span></p><h2 id="nb-journey-photos-title">Photos &amp; dates</h2>{journeyMedia.map(media=><div data-journey-photos-panel={media.slug} hidden><JourneyPhotoCollection section={media.slug} /></div>)}</article>
  </dialog>
  <dialog class="nb-lightbox" aria-labelledby="nb-photo-caption"><button class="nb-photo-close" aria-label="Close enlarged photograph">Close <span aria-hidden="true">×</span></button><figure><img alt="" /><figcaption id="nb-photo-caption"></figcaption></figure></dialog>
</section>
<script>import '../scripts/notebook';</script>
<style>
.nb-without-kicker h2{margin-top:12px}.nb-without-kicker .nb-kicker-spacer{margin-top:20px}.nb-reference-placeholder{visibility:hidden}
.nb-journey-photo-board{position:absolute;z-index:2;inset:70px 28px 52px;padding:8px 12px 0;background-color:#fbf7ec;background-image:radial-gradient(#9a886b19 .6px,transparent .8px);background-size:5px 5px}.nb-journey-photo-kicker{font-size:7px;letter-spacing:1.1px;color:#787a68}.nb-journey-photo-board>h2{font-family:var(--hand);font-size:31px;line-height:1.05;color:var(--nb-rust);margin:8px 0 18px;transform:rotate(-1.5deg)}
.nb-journey-photos-dialog{width:min(760px,calc(100% - 24px));max-height:92dvh;padding:12px;border:1px solid #857963;border-radius:3px;background:#d8cfb9;color:var(--nb-ink);box-shadow:0 24px 70px #1c241d55;overflow:auto}.nb-journey-photos-dialog::backdrop{background:#18211bd9;backdrop-filter:blur(5px)}.nb-journey-photos-close{display:flex;align-items:center;gap:20px;margin-left:auto;padding:3px 6px 10px;background:transparent;font-size:11px;color:#4a5748}.nb-journey-photos-close span{font-size:25px;line-height:1}.nb-journey-photos-dialog article{position:relative;padding:20px 18px 26px;background-color:#fbf7ec;background-image:radial-gradient(#9a886b1b .6px,transparent .8px);background-size:5px 5px}.nb-journey-photos-dialog article>p{font-size:7px;letter-spacing:1.1px;color:#787a68}.nb-journey-photos-dialog article>h2{font-family:var(--hand);font-size:39px;line-height:1;margin:9px 0 20px;color:var(--nb-rust)}
.nb-design-dialog{width:min(980px,calc(100% - 28px));max-height:92dvh;padding:15px;border:1px solid #857963;border-radius:3px;background:#d8cfb9;color:var(--nb-ink);box-shadow:0 24px 70px #1c241d55;overflow:auto}.nb-design-dialog::backdrop{background:#18211bd9;backdrop-filter:blur(5px)}.nb-design-close{display:flex;align-items:center;gap:20px;margin-left:auto;padding:3px 6px 12px;background:transparent;font-size:11px;color:#4a5748}.nb-design-close span{font-size:25px;line-height:1}.nb-design-sheet{position:relative;padding:26px 28px 30px;background-color:#fbf7ec;background-image:radial-gradient(#9a886b1b .6px,transparent .8px);background-size:5px 5px;box-shadow:1px 3px 7px #49381e24;transform:rotate(-.15deg)}.nb-design-sheet:before{content:'';position:absolute;top:-9px;left:calc(50% - 47px);width:94px;height:22px;background:#cbbb9170;transform:rotate(-2deg)}.nb-design-sheet header>p{font-size:8px;letter-spacing:1.3px;color:#777966}.nb-design-sheet header h2{font-family:var(--hand);font-size:45px;line-height:1;margin:12px 0 24px;color:#41523f}.nb-design-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(250px,.65fr);gap:30px;align-items:center}.nb-design-grid figure{margin:0;padding:11px;background:#fffdfa;box-shadow:2px 6px 14px #49381e29;transform:rotate(-1.3deg)}.nb-design-grid img{display:block;width:100%;max-height:58dvh;object-fit:contain}.nb-design-grid section{padding:6px 4px}.nb-design-note{font-family:var(--hand);font-size:20px;color:var(--nb-rust);transform:rotate(-2deg);margin-bottom:4px}.nb-design-grid h3{font-family:var(--hand);font-size:31px;line-height:1.05;margin-bottom:16px}.nb-design-grid table{width:100%;border-collapse:collapse;font-family:var(--hand);font-size:22px;line-height:1.15;background:#fffdf76b;transform:rotate(.4deg)}.nb-design-grid th,.nb-design-grid td{text-align:left;padding:9px 10px;border-bottom:1px dashed #7a806c80}.nb-design-grid th{font-family:var(--font-body);font-size:8px;letter-spacing:.8px;color:#747766;border-bottom-style:solid}.nb-design-grid td:first-child{width:34%;color:#9b4f34}.nb-design-grid tbody tr:last-child td{border-bottom:0}
@media(max-width:700px){.nb-design-dialog{padding:9px}.nb-design-sheet{padding:20px 17px 24px}.nb-design-sheet header h2{font-size:39px;margin-bottom:18px}.nb-design-grid{grid-template-columns:1fr;gap:19px}.nb-design-grid img{max-height:35dvh}.nb-design-grid section{padding:0}.nb-design-note{font-size:18px}.nb-design-grid h3{font-size:28px;margin-bottom:9px}.nb-design-grid table{font-size:19px}.nb-design-grid th,.nb-design-grid td{padding:7px 8px}}

.nb-entry :global(.hardware-notebook){width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed;border:1.5px solid #6c7156;border-radius:5px 3px 7px 2px;font-family:var(--hand);font-size:19px;line-height:1.08;background:#fcf8ed90;box-shadow:1px 1px 0 #8d92774d,-1px 0 0 #8d927730;transform:rotate(-.25deg)}
.nb-entry :global(.hardware-notebook th),.nb-entry :global(.hardware-notebook td){text-align:left;vertical-align:top;padding:7px 8px;border-bottom:1px solid #8d92778c;overflow-wrap:break-word}
.nb-entry :global(.hardware-notebook th){width:24%;font-weight:400;color:#9a5134;border-right:1.5px solid #8d92779c;background:#e8e6ce35}
.nb-entry :global(.hardware-notebook tr:nth-child(even) th),.nb-entry :global(.hardware-notebook tr:nth-child(even) td){border-bottom-style:dashed}
.nb-entry :global(.hardware-notebook tr:last-child th),.nb-entry :global(.hardware-notebook tr:last-child td){border-bottom:0}
.nb-entry :global(.hardware-notebook strong){font-weight:400;text-decoration:underline;text-decoration-color:#b881566e;text-underline-offset:3px}
@media(min-width:761px) and (max-width:1100px){.nb-entry :global(.hardware-notebook){font-size:17px;line-height:1.08}.nb-entry :global(.hardware-notebook th),.nb-entry :global(.hardware-notebook td){padding:6px}.nb-entry :global(.hardware-notebook th){width:26%}}
@media(max-width:760px){.nb-entry :global(.hardware-notebook col:first-child){width:34%!important}.nb-entry :global(.hardware-notebook col:last-child){width:66%!important}.nb-entry :global(.hardware-notebook th){font-size:16px}.nb-entry :global(.hardware-notebook){font-size:17px;line-height:1.08}.nb-entry :global(.hardware-notebook th),.nb-entry :global(.hardware-notebook td){padding:7px 6px}.nb-entry :global(.hardware-notebook th){width:26%}}

/* Keep the accepted open-spread geometry underneath the closed cover. */
.notebook[data-cover] .nb-binding{background:transparent;box-shadow:none}
.notebook[data-cover] .nb-spreads,.notebook[data-cover] .nb-tabs{visibility:hidden;pointer-events:none}
.notebook[data-cover] .nb-cover{border:7px solid #6b7560;border-left:12px solid #58644d;border-radius:5px 11px 11px 5px;box-shadow:inset 7px 0 13px #6b574222,3px 3px 0 #eee4cf,6px 6px 0 #cec5b1,8px 9px 0 #6b7560,12px 22px 35px #40372326}
@media(min-width:761px){.notebook[data-cover] .nb-cover{left:25%;right:auto;top:0;bottom:0;width:50%}.notebook[data-cover] .nb-cover h2{font-size:clamp(42px,4.4vw,64px)}}

.nb-show-cover{background:transparent;font-size:11px;text-decoration:underline;text-underline-offset:4px;padding:10px;color:#745a3d;letter-spacing:0}
.nb-cover{position:absolute;inset:7px 7px 12px;z-index:9;background:#fbf7ec;box-shadow:inset 8px 0 18px #6b57421a;border:1px solid #d7cbb4;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:35px 24px;border-radius:3px}
.nb-cover:before{content:'';position:absolute;inset:16px;border:1px solid #bdc2a5;pointer-events:none}.nb-cover-edition{font-size:9px;letter-spacing:2px;color:#747e60}.nb-cover-edition span{margin:0 12px;color:#bd9471}.nb-cover h2{font-family:var(--hand);font-size:64px;line-height:1.1;margin:20px 0 5px;color:#45553b}.nb-cover-subtitle{font-family:var(--hand);font-size:25px;color:#a3613d}.nb-cover-art{height:48%;max-height:420px;aspect-ratio:312/418;max-width:85%;margin:0 0 16px}.nb-cover-art video{width:100%;height:100%;object-fit:contain;display:block}.nb-cover-actions{display:flex;flex-direction:column;align-items:center;gap:10px}.nb-open-cover{background:#536145;color:#fff9e9;padding:13px 23px;border-radius:3px;font-size:12px;display:flex;gap:28px;align-items:center}.nb-open-cover:hover{background:#394a30}.nb-cover-pause{background:transparent;font-size:10px;color:#76694f;padding:8px;text-decoration:underline;text-underline-offset:4px}.nb-cover-caption{font-size:8px;color:#81836f;margin-top:15px;letter-spacing:.3px}
.notebook[data-cover] .nb-corner,.notebook[data-cover] :global(.journey-tabs){visibility:hidden}.notebook[data-cover] .nb-controls,.notebook[data-cover] .nb-hint{visibility:hidden}
@media(max-width:760px){.nb-cover{inset:5px 5px 10px;padding-inline:20px}.nb-cover h2{font-size:48px}.nb-cover-subtitle{font-size:22px}.nb-cover-edition{font-size:7px;letter-spacing:1px}.nb-cover-edition span{margin:0 6px}.nb-cover-art{height:36%;max-width:90%}.nb-show-cover{font-size:10px;padding:8px 5px}}
@media print{.nb-cover,.nb-show-cover{display:none!important}}

.nb-entry :global(.idea-gallery){display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:18px 0 16px}
.nb-entry :global(.idea-gallery figure){position:relative;margin:0;padding:6px 6px 8px;background:#fffdf7;box-shadow:1px 4px 7px #49381e22;transform:rotate(-2deg)}
.nb-entry :global(.idea-gallery figure:nth-child(even)){transform:rotate(2deg)}
.nb-entry :global(.idea-gallery figure:before){content:'';position:absolute;top:-7px;left:28%;width:44%;height:15px;background:#d3be8b65;transform:rotate(-5deg);pointer-events:none}
.nb-entry :global(.idea-gallery a){display:block;cursor:zoom-in}
.nb-entry :global(.idea-gallery img){display:block;width:100%;height:90px;object-fit:cover}
.nb-entry :global(.idea-gallery figcaption){font-family:var(--hand);font-size:17px;text-align:center;line-height:1.2;margin-top:7px;white-space:nowrap}
@media(max-width:1100px){.nb-entry :global(.idea-gallery){gap:6px}.nb-entry :global(.idea-gallery figure){padding:4px 4px 6px}.nb-entry :global(.idea-gallery img){height:85px}.nb-entry :global(.idea-gallery figcaption){font-size:14px;white-space:normal}}

.nb-tabs{flex-wrap:wrap}.nb-tabs>a:nth-child(6){background:#e5c9b9}.nb-tabs>a:nth-child(5){background:#d6d6bd}
