---
import '@fontsource/caveat/400.css';
import type { MarkdownInstance } from 'astro';
interface Entry { order:number; slug:string; tab:string; kicker:string; title:string; image:string; alt:string; caption:string; source:string; scribble:string; note:string; annotation:string; x:number; y:number; reference:string }
const entries = Object.values(import.meta.glob<MarkdownInstance<Entry>>('../content/notebook/*.md', { eager:true })).sort((a,b)=>a.frontmatter.order-b.frontmatter.order);
---
<section class="notebook" data-notebook aria-label="Interactive field notebook">
  <header class="nb-intro">
    <div><p class="eyebrow"><span class="eyebrow-dot"></span> THE PROJECT NOTEBOOK</p><h1>Notes from<br /><em>inside the system.</em></h1></div>
    <p class="nb-intro-note">A few questions.<br />A lot of looking closely.<svg viewBox="0 0 110 50" fill="none" aria-hidden="true"><path d="M8 7Q84 0 84 38M71 29l14 12 13-15" /></svg></p>
  </header>
  <div class="nb-toolbar"><span>FIELD NOTES <span aria-hidden="true">/</span> VOLUME 01</span><details class="nb-contents"><summary>In this notebook <span aria-hidden="true">＋</span></summary><nav aria-label="Notebook contents">{entries.map(({frontmatter:e},i)=><a href={`#notebook-${e.slug}`} data-nb-jump={i}><span>0{i+1}</span>{e.tab}</a>)}<a href="#reference-notes">Full reference notes ↗</a></nav></details></div>
  <nav class="nb-tabs" aria-label="Notebook sections">{entries.map(({frontmatter:e},i)=><a href={`#notebook-${e.slug}`} data-nb-jump={i}><span>0{i+1}</span>{e.tab}</a>)}</nav>
  <div class="nb-binding" data-nb-binding>
    <div class="nb-spreads">
      {entries.map(({frontmatter:e,Content},i)=><article class="nb-spread" id={`notebook-${e.slug}`} data-nb-spread={i} aria-label={e.tab}>
        <div class="nb-page nb-photo-page" data-nb-page={i*2}>
          <div class="nb-running"><span>SMART MUSHROOM HUB</span><span>COLLECTED OBSERVATIONS</span></div>
          <p class="nb-scribble">{e.scribble}</p>
          <figure class:list={['nb-photo',{'nb-portrait':e.slug==='build'||e.slug==='lessons'}]}>
            <a href={e.image} data-nb-image data-caption={`${e.caption}. ${e.source}.`} aria-label={`Enlarge photograph: ${e.caption}`}><img src={e.image} alt={e.alt} loading={i===0?'eager':'lazy'} width={e.slug==='build'||e.slug==='lessons'?1200:1600} height={e.slug==='build'||e.slug==='lessons'?1600:900} /></a>
            <details class="nb-annotation" style={`--pin-x:${e.x}%;--pin-y:${e.y}%`}><summary aria-label={`Photo note: ${e.tab}`}>1</summary><p>{e.annotation}</p></details>
            <figcaption>{e.caption}</figcaption>
          </figure>
          <p class="nb-source">{e.source}</p>
          <p class="nb-margin-note"><span aria-hidden="true">↳</span> {e.note}</p>
          <div class="nb-folio"><span>CLICK THE PHOTO TO LOOK CLOSER</span><span>{String(i*2+1).padStart(2,'0')}</span></div>
        </div>
        <div class="nb-page nb-writing-page" data-nb-page={i*2+1}>
          <div class="nb-running"><span>0{i+1} / {e.tab.toUpperCase()}</span><span>RESEARCH IN PROGRESS</span></div>
          <p class="nb-kicker">{e.kicker}</p><h2>{e.title}</h2>
          <div class="nb-entry"><Content /></div>
          <a class="nb-reference" href={`#${e.reference}`}>Open the reference notes <span aria-hidden="true">↗</span></a>
          <div class="nb-folio"><span>SMART MUSHROOM HUB / FIELD NOTES</span><span>{String(i*2+2).padStart(2,'0')}</span></div>
        </div>
      </article>)}
    </div>
    <div class="nb-fold" data-nb-fold aria-hidden="true"></div>
    <button class="nb-corner nb-corner-prev" data-nb-prev aria-label="Turn to previous page" hidden></button><button class="nb-corner nb-corner-next" data-nb-next aria-label="Turn to next page" hidden></button>
  </div>
  <div class="nb-controls" data-nb-controls hidden><button data-nb-prev aria-label="Previous notebook page">← <span>Previous</span></button><p data-nb-status role="status" aria-live="polite" aria-atomic="true"></p><button data-nb-next aria-label="Next notebook page"><span>Turn the page</span> →</button></div>
  <p class="nb-hint" data-nb-hint hidden>Choose a tab, turn a corner, or use the arrow keys. <span>On your phone, swipe across the paper.</span></p>
  <dialog class="nb-lightbox" aria-labelledby="nb-photo-caption"><button class="nb-photo-close" aria-label="Close enlarged photograph">Close <span aria-hidden="true">×</span></button><figure><img alt="" /><figcaption id="nb-photo-caption"></figcaption></figure></dialog>
</section>
<script>import '../scripts/notebook';</script>
<style>
.notebook{--nb-ink:#39473c;--nb-rust:#a64e30;--hand:'Caveat',cursive;margin:45px 0 85px;color:var(--nb-ink)}.nb-intro{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:48px}.nb-intro h1{font-size:clamp(46px,5.5vw,74px);line-height:1.02;letter-spacing:-.045em;margin-top:20px}.nb-intro h1 em{color:var(--olive)}.nb-intro-note{font-family:var(--hand);font-size:27px;line-height:1.15;transform:rotate(-5deg);color:var(--nb-rust);padding-right:55px}.nb-intro-note svg{display:block;width:95px;height:48px;margin:10px 0 0 60px;stroke:currentColor;stroke-width:1.5;stroke-linecap:round}.nb-toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;font-size:9px;letter-spacing:1.5px}.nb-toolbar>span span{margin:0 10px;color:#a6a28e}.nb-contents{position:relative;z-index:8;letter-spacing:0;font-size:12px}.nb-contents summary{cursor:pointer;padding:12px 0 12px 18px;list-style:none}.nb-contents summary span{margin-left:15px}.nb-contents nav{position:absolute;right:0;top:100%;min-width:255px;background:#fffaf0;border:1px solid #d7cdb8;box-shadow:0 12px 32px #46342320;padding:12px}.nb-contents a{display:flex;gap:20px;padding:13px;text-decoration:none}.nb-contents a:hover{background:#efe7d8}.nb-tabs{display:flex;gap:6px;position:relative;z-index:2;padding:0 20px}.nb-tabs>a{display:flex;align-items:center;gap:12px;padding:15px 20px 17px;border-radius:7px 7px 0 0;background:#dedfcd;color:#465444;text-decoration:none;font-size:11px;border:1px solid #bcc1ac;border-bottom:0;transition:background .2s,transform .2s}.nb-tabs>a:nth-child(2){background:#e6d3b6}.nb-tabs>a:nth-child(3){background:#d3dccc}.nb-tabs>a:nth-child(4){background:#d4dcda}.nb-tabs>a:nth-child(5){background:#e5c9b9}.nb-tabs>a span{font-size:9px;opacity:.65}.nb-tabs>a[aria-current=page]{background:#fbf6e9;transform:translateY(-5px);box-shadow:0 5px 0 #fbf6e9;color:#a34a2c}.nb-binding{scroll-margin-top:115px;position:relative;padding:7px 7px 12px;background:#6b7560;border-radius:7px 7px 12px 9px;box-shadow:0 3px 0 #a5a08e,0 7px 0 -2px #ece1ca,0 10px 0 -2px #7a8169,0 22px 42px -15px #4e453a50;perspective:1900px}.nb-spread{display:grid;grid-template-columns:1fr 1fr;scroll-margin-top:125px}.nb-page{position:relative;min-width:0;min-height:690px;padding:35px 38px 60px;background-color:#fbf7ec;background-image:radial-gradient(#9a886b19 .6px,transparent .8px);background-size:5px 5px;display:flex;flex-direction:column}.nb-photo-page{border-radius:3px 0 0 4px;background-image:linear-gradient(90deg,transparent 92%,#65554012 99%,#65554028),radial-gradient(#9a886b19 .6px,transparent .8px);background-size:100% 100%,5px 5px}.nb-writing-page{border-radius:0 3px 4px 0;background-image:linear-gradient(90deg,#65554024,transparent 8%),repeating-linear-gradient(transparent 0 29px,#97a49a18 29px 30px);background-size:100% 100%;border-left:1px solid #c7baa2}.nb-running,.nb-folio{display:flex;justify-content:space-between;gap:15px;font-size:7px;letter-spacing:1.2px;color:#868776}.nb-running{padding-bottom:14px;border-bottom:1px solid #d8d2c2}.nb-scribble{font-family:var(--hand);font-size:29px;line-height:1.08;margin:35px 0 27px;transform:rotate(-3deg);max-width:320px;color:var(--nb-rust)}.nb-photo{margin:8px 0 0;padding:12px 12px 13px;background:#fffdfa;box-shadow:2px 7px 15px #42351f25;transform:rotate(-2deg);position:relative}.nb-photo:before,.nb-photo:after{content:'';position:absolute;width:88px;height:27px;background:#d3be8b65;z-index:2;top:-12px;left:calc(50% - 44px);transform:rotate(4deg);clip-path:polygon(2% 0,100% 4%,97% 100%,0 92%);pointer-events:none}.nb-photo:after{top:auto;bottom:-10px;left:20px;width:65px;transform:rotate(-17deg)}.nb-photo img{width:100%;height:auto;aspect-ratio:16/10;object-fit:cover}.nb-portrait{max-width:290px;align-self:center;transform:rotate(2deg)}.nb-portrait img{aspect-ratio:4/4.2;object-position:center 65%}.nb-photo>a{display:block;cursor:zoom-in}.nb-photo figcaption{font-family:var(--hand);font-size:21px;line-height:1.15;text-align:center;margin-top:13px}.nb-source{font-size:8px;color:#757766;text-align:center;margin:24px 0 0;letter-spacing:.2px}.nb-margin-note{font-family:var(--hand);font-size:26px;line-height:1.2;color:#747e5c;transform:rotate(2deg);margin:26px 12px 25px}.nb-margin-note>span{color:var(--nb-rust);font-size:35px}.nb-folio{position:absolute;bottom:23px;left:38px;right:38px;padding-top:12px;border-top:1px solid #d8d2c2}.nb-folio>span:last-child{font-family:var(--hand);font-size:18px;line-height:1}.nb-kicker{font-size:9px;letter-spacing:.8px;color:var(--nb-rust);margin:32px 0 10px}.nb-writing-page h2{font-family:var(--hand);font-size:42px;line-height:1.02;letter-spacing:-.02em;max-width:360px;margin-bottom:22px}.nb-entry{font-family:var(--font-display);font-size:17px;line-height:1.6}.nb-entry :global(p){margin-bottom:15px}.nb-entry :global(h3){font-family:var(--hand);font-size:25px;color:var(--nb-rust);margin:18px 0 8px;line-height:1.2}.nb-entry :global(ul),.nb-entry :global(ol){padding-left:22px;margin:12px 0 18px}.nb-entry :global(li){padding-left:2px;margin-bottom:7px}.nb-entry :global(strong){font-weight:600}.nb-entry :global(a){text-decoration-color:#c98567;text-underline-offset:4px}.nb-entry :global(em){color:#647254}.nb-reference{font-size:10px;display:flex;align-items:center;gap:15px;margin-top:auto;padding-top:18px;text-underline-offset:4px;color:#6b705f}.nb-annotation{position:absolute;left:var(--pin-x);top:var(--pin-y);z-index:3}.nb-annotation summary{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;border:1px solid #fff8e3;box-shadow:0 0 0 4px #a64e3030;background:#a64e30;color:#fff8ec;list-style:none;cursor:pointer;font-family:var(--hand);font-size:23px}.nb-annotation summary::-webkit-details-marker{display:none}.nb-annotation p{position:absolute;bottom:43px;left:50%;transform:translateX(-50%);width:210px;max-width:60vw;background:#fff2cb;padding:15px;box-shadow:0 5px 18px #42351f35;font-size:12px;line-height:1.6;border:1px solid #d8c797}.nb-controls{display:flex;justify-content:space-between;align-items:center;gap:15px;margin:28px 0 0}.nb-controls button{font-size:11px;display:flex;gap:15px;align-items:center;background:transparent;min-height:44px;padding:8px 12px;color:var(--nb-rust)}.nb-controls button:disabled{opacity:.3}.nb-controls p{font-size:10px;color:#747b69;letter-spacing:.4px;text-align:center}.nb-hint{text-align:center;font-family:var(--hand);font-size:20px;color:#868673;margin-top:12px}.nb-hint span{display:none}.nb-corner{position:absolute;bottom:12px;width:45px;height:45px;z-index:4;background:linear-gradient(135deg,transparent 49%,#e7d9bc 50%,#fffaef 75%);opacity:.65}.nb-corner:hover{opacity:1}.nb-corner-next{right:7px}.nb-corner-prev{left:7px;transform:scaleX(-1)}.nb-corner:disabled{visibility:hidden}.nb-fold{position:absolute;inset:7px 7px 12px;pointer-events:none;z-index:5;perspective:1900px}:global(.nb-leaf){position:absolute;width:50%;top:0;bottom:0;right:0;transform-origin:left;transform-style:preserve-3d}:global(.nb-leaf.is-backward){right:auto;left:0;transform-origin:right}:global(.nb-leaf-front),:global(.nb-leaf-back){position:absolute;inset:0;backface-visibility:hidden;overflow:hidden;background:#fbf7ec}:global(.nb-leaf-back){transform:rotateY(180deg);background:linear-gradient(90deg,#cabda2,#fbf7ec 14%,#fbf7ec 85%,#ded3bf);box-shadow:6px 0 25px #372b2130}:global(.nb-leaf-front) :global(.nb-page){height:100%}.notebook[data-enhanced] .nb-spread:not([data-active]){display:none}.nb-lightbox{max-width:1100px;width:calc(100% - 32px);max-height:92dvh;padding:18px;background:#fffaf0;border:1px solid #ccbea5;border-radius:4px;color:var(--nb-ink)}.nb-lightbox::backdrop{background:#18211be0;backdrop-filter:blur(5px)}.nb-photo-close{display:flex;gap:24px;align-items:center;justify-self:end;background:transparent;padding:5px 8px 15px;font-size:12px}.nb-photo-close span{font-size:25px}.nb-lightbox figure{margin:0}.nb-lightbox img{max-height:73dvh;width:100%;object-fit:contain}.nb-lightbox figcaption{text-align:center;font-family:var(--hand);font-size:24px;line-height:1.2;padding:18px 10px 5px}
@media(min-width:761px) and (max-width:1100px){.nb-page{padding:25px 25px 60px;min-height:750px}.nb-tabs>a{padding:14px 13px;gap:7px}.nb-writing-page h2{font-size:35px}.nb-entry{font-size:16px}.nb-folio{left:25px;right:25px}.nb-running{font-size:6px}}
@media(max-width:760px){.notebook{margin:30px 0 60px}.nb-intro{margin-bottom:30px}.nb-intro h1{font-size:47px}.nb-intro-note{display:none}.nb-toolbar{font-size:8px;letter-spacing:1px;margin-bottom:15px}.nb-contents{font-size:11px}.nb-tabs{padding:0 3px;gap:4px;overflow-x:auto;scrollbar-width:thin;align-items:end}.nb-tabs>a{white-space:nowrap;font-size:10px;padding:15px 12px;gap:7px;flex-shrink:0}.nb-tabs>a[aria-current=page]{transform:none;background:#fbf6e9}.nb-binding{padding:5px 5px 10px}.nb-spread{grid-template-columns:1fr}.nb-page{min-height:620px;padding:27px 24px 65px;border-radius:2px;border-left:0}.notebook[data-enhanced] .nb-page:not([data-active]){display:none}.nb-writing-page{background-image:repeating-linear-gradient(transparent 0 29px,#97a49a18 29px 30px)}.nb-photo-page{background-image:radial-gradient(#9a886b19 .6px,transparent .8px);background-size:5px 5px}.nb-running{font-size:6px;letter-spacing:.8px}.nb-scribble{font-size:29px;margin-top:35px;margin-bottom:25px}.nb-photo{padding:9px}.nb-photo img{aspect-ratio:4/3}.nb-portrait{max-width:240px}.nb-portrait img{aspect-ratio:4/4.2}.nb-photo figcaption{font-size:21px}.nb-source{font-size:8px;line-height:1.5}.nb-margin-note{font-size:26px;margin-top:25px}.nb-writing-page h2{font-size:38px}.nb-entry{font-size:17px;line-height:1.55}.nb-folio{left:24px;right:24px;font-size:6px}.nb-controls{gap:5px;margin-top:24px}.nb-controls button{padding:7px 0;gap:7px;font-size:10px}.nb-controls p{font-size:9px;max-width:115px;line-height:1.5}.nb-hint{font-size:19px;margin-top:8px}.nb-hint span{display:block}.nb-fold{inset:5px 5px 10px}:global(.nb-leaf){width:100%}.nb-corner-next{right:5px}.nb-corner-prev{left:5px}}
@media(prefers-reduced-motion:reduce){.nb-tabs>a{transition:none}.nb-fold{display:none}}
@media print{.nb-toolbar,.nb-tabs,.nb-controls,.nb-hint,.nb-corner,.nb-fold,.nb-annotation,.nb-lightbox{display:none!important}.notebook[data-enhanced] .nb-spread:not([data-active]){display:grid}.notebook[data-enhanced] .nb-page:not([data-active]){display:flex}.nb-spread{break-after:page}.nb-binding{box-shadow:none;padding:0}.nb-page{min-height:0;break-inside:avoid}.nb-folio{display:none}}
</style>
