---
import '@fontsource/caveat/400.css';
import thermometer from '@phosphor-icons/core/duotone/thermometer-duotone.svg?raw';
import cloud from '@phosphor-icons/core/duotone/cloud-duotone.svg?raw';
import broadcast from '@phosphor-icons/core/duotone/broadcast-duotone.svg?raw';
import pencil from '@phosphor-icons/core/duotone/pencil-line-duotone.svg?raw';
import database from '@phosphor-icons/core/duotone/database-duotone.svg?raw';
import chart from '@phosphor-icons/core/duotone/chart-line-duotone.svg?raw';

interface Props { pathway: 'observe' }
const { pathway } = Astro.props;
type Point = [number, number];

// Phosphor duotone icons: the translucent layer becomes a watercolour wash, the rest is the ink line.
function glyph(raw: string) {
  const paths = [...raw.matchAll(/<path d="([^"]+)"( opacity="[^"]+")?\s*\/>/g)];
  return { wash: paths.filter(path => path[2]).map(path => path[1]), line: paths.filter(path => !path[2]).map(path => path[1]) };
}
// A slightly uneven wash behind each part: a closed Catmull-Rom curve through jittered points, seeded per part.
function blob(seed: number, radius: number) {
  let n = seed; const rand = () => (n = n * 16807 % 2147483647) / 2147483647;
  const points = Array.from({ length: 9 }, (_, i) => { const angle = i / 9 * Math.PI * 2, reach = radius * (.9 + rand() * .2); return [Math.cos(angle) * reach, Math.sin(angle) * reach]; });
  const at = (i: number) => points[(i + points.length) % points.length], f = (v: number) => v.toFixed(1);
  let d = `M${f(points[0][0])} ${f(points[0][1])}`;
  for (let i = 0; i < points.length; i++) {
    const [p0, p1, p2, p3] = [at(i - 1), at(i), at(i + 1), at(i + 2)];
    d += `C${f(p1[0] + (p2[0] - p0[0]) / 6)} ${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)} ${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])} ${f(p2[1])}`;
  }
  return `${d}Z`;
}

const nodes = [
  { id: 'sht31', name: 'SHT31', detail: 'temperature, humidity', icon: glyph(thermometer), sensor: true },
  { id: 'scd41', name: 'SCD41', detail: 'CO₂', icon: glyph(cloud), sensor: true },
  { id: 'mqtt', name: 'Mosquitto', detail: 'MQTT broker', icon: glyph(broadcast) },
  { id: 'writer', name: 'Database writer', detail: 'Python service', icon: glyph(pencil) },
  { id: 'timescale', name: 'TimescaleDB', detail: 'experiment history', icon: glyph(database) },
  { id: 'grafana', name: 'Grafana', detail: 'dashboards', icon: glyph(chart) },
];
const lastId = nodes.at(-1)!.id;
const steps = [
  'The SHT31 and SCD41 sensors send their readings together. The two paths merge before Mosquitto, the MQTT broker.',
  'Mosquitto carries the published measurements to the database writer.',
  'The database writer stores the measurements in TimescaleDB.',
  'Grafana visualizes the stored measurements from TimescaleDB.',
];
type Layout = {
  id: 'wide' | 'narrow'; viewBox: string; at: Record<string, Point>; junction: Point; entry: Point; nameSize: number; noteSize: number;
  routes: { id: string; to: string; d: string }[];
  notes: { id: string; x: number; y: number; anchor: 'middle' | 'end'; lines: string[] }[];
  scribble: string; spark: string;
};
// Wide: a left-to-right zigzag with names under each part. Narrow: one column that fits a phone screen,
// names to the right of each part and the handwritten notes to the left of the thread.
const layouts: Layout[] = [
  {
    id: 'wide', viewBox: '0 0 1160 440', entry: [-34, 0], nameSize: 13, noteSize: 19,
    at: { sht31: [110, 110], scd41: [110, 322], mqtt: [398, 216], writer: [624, 110], timescale: [842, 306], grafana: [1030, 188] },
    junction: [238, 216],
    routes: [
      { id: 'sht31', to: 'junction', d: 'M146 110C200 110 200 216 238 216' },
      { id: 'scd41', to: 'junction', d: 'M146 322C200 322 200 216 238 216' },
      { id: 'merged', to: 'mqtt', d: 'M238 216H356' },
      { id: 'published', to: 'writer', d: 'M440 216C520 216 500 110 582 110' },
      { id: 'stored', to: 'timescale', d: 'M666 110C750 110 718 306 800 306' },
      { id: 'visualized', to: 'grafana', d: 'M884 306C960 306 916 188 988 188' },
    ],
    notes: [
      { id: 'readings', x: 300, y: 196, anchor: 'middle', lines: ['send readings'] },
      { id: 'published', x: 562, y: 250, anchor: 'middle', lines: ['carries published', 'measurements'] },
      { id: 'stored', x: 802, y: 170, anchor: 'middle', lines: ['stores', 'measurements'] },
      { id: 'visualized', x: 1002, y: 300, anchor: 'middle', lines: ['visualizes stored', 'measurements'] },
    ],
    scribble: 'M-32 82c5-6 9 3 14-2s8-6 13 0 7 4 12-1 7-5 12 1 6 3 10-1', spark: 'M58 8L68-2L76 4L86-10L96-4L108-16',
  },
  {
    id: 'narrow', viewBox: '0 0 384 690', entry: [0, -34], nameSize: 14, noteSize: 17,
    at: { sht31: [68, 56], scd41: [252, 56], mqtt: [160, 236], writer: [160, 366], timescale: [160, 496], grafana: [160, 626] },
    junction: [160, 150],
    routes: [
      { id: 'sht31', to: 'junction', d: 'M104 56C150 56 160 100 160 150' },
      { id: 'scd41', to: 'junction', d: 'M216 56C170 56 160 100 160 150' },
      { id: 'merged', to: 'mqtt', d: 'M160 150V194' },
      { id: 'published', to: 'writer', d: 'M160 278C182 296 138 306 160 324' },
      { id: 'stored', to: 'timescale', d: 'M160 408C182 426 138 436 160 454' },
      { id: 'visualized', to: 'grafana', d: 'M160 538C182 556 138 566 160 584' },
    ],
    notes: [
      { id: 'readings', x: 136, y: 178, anchor: 'end', lines: ['send readings'] },
      { id: 'published', x: 132, y: 297, anchor: 'end', lines: ['carries published', 'measurements'] },
      { id: 'stored', x: 132, y: 427, anchor: 'end', lines: ['stores', 'measurements'] },
      { id: 'visualized', x: 132, y: 557, anchor: 'end', lines: ['visualizes stored', 'measurements'] },
    ],
    scribble: 'M42 30c5-6 9 3 14-2s8-6 13 0 7 4 12-1 7-5 12 1 6 3 10-1', spark: 'M50 40L60 32L68 37L78 26L88 31L100 20',
  },
];
const prefix = `ink-${pathway}`;
const loop = 'M-40-4C-42-34-6-44 22-36C46-28 48 8 30 28C10 46-30 42-40 14C-44 2-40-12-30-20';
---
<div class="ink-flow" data-system-flow={pathway} data-flow-style="ink" data-flow-name="Observe" data-flow-completion="Grafana displays the stored measurements." data-flow-state="static" data-flow-stage="all" role="group" aria-label="Observe Pathway Illustration">
  <ol class="sr-only">{steps.map(step => <li>{step}</li>)}</ol>
  <div class="ink-canvas" data-pathway-canvas>
    {layouts.map(layout => {
      const id = (name: string) => `${prefix}-${layout.id}-${name}`;
      const below = (node: typeof nodes[number]) => layout.id === 'wide' || node.sensor;
      return (
        <svg class={`ink-diagram ink-${layout.id}`} data-flow-layout={layout.id} viewBox={layout.viewBox} aria-hidden="true">
          <defs>
            <radialGradient id={id('soft')}><stop offset=".6" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></radialGradient>
            <linearGradient id={id('feather')}><stop offset="0" stop-color="#fff" /><stop offset=".8" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
            {nodes.map(node => { const [x, y] = node.sensor ? [0, 0] : layout.entry; return <mask id={id(`reveal-${node.id}`)}><circle class="ink-reveal" data-ink-reveal={node.id} data-origin={`${x} ${y}`} cx={x} cy={y} r="72" fill={`url(#${id('soft')})`} /></mask>; })}
            {layout.notes.flatMap(note => note.lines.map((_, row) => <mask id={id(`note-${note.id}-${row}`)}><rect class="ink-note-reveal" data-ink-note-reveal={`${note.id}-${row}`} x="-4000" y="-4000" width="8000" height="8000" fill={`url(#${id('feather')})`} /></mask>))}
          </defs>
          <g class="ink-routes">
            {layout.routes.map(route => <g data-ink-route-group={route.id}>
              <path class="ink-route" d={route.d} data-ink-route={route.id} data-ink-to={route.to} />
              <path class="ink-trail" d={route.d} pathLength="1" data-ink-trail={route.id} />
            </g>)}
            <circle class="ink-junction" data-ink-junction cx={layout.junction[0]} cy={layout.junction[1]} r="3.2" />
          </g>
          {nodes.map((node, index) => {
            const [x, y] = layout.at[node.id], [ex, ey] = node.sensor ? [0, 0] : layout.entry;
            const name = below(node) ? { x: 0, y: 51, anchor: 'middle' } : { x: 50, y: -1, anchor: 'start' };
            return (
              <g class:list={['ink-node', { 'ink-node-final': node.id === lastId }]} data-ink-node={node.id} data-state="ink" transform={`translate(${x} ${y})`}>
                <path class="ink-wash" data-ink-wash d={blob(31 + index * 17, 36)} />
                {node.sensor && [0, 1].map(() => <circle class="ink-ripple" data-ink-ripple r="30" />)}
                {!node.sensor && <circle class="ink-splash" data-ink-splash data-origin={`${ex} ${ey}`} cx={ex} cy={ey} r="11" />}
                <g class="ink-icon" data-ink-icon>
                  <g class="ink-glyph-pencil" transform="translate(-26 -26) scale(.203125)">{node.icon.line.map(d => <path d={d} />)}</g>
                  <g mask={`url(#${id(`reveal-${node.id}`)})`}>
                    <g class="ink-glyph-ink" transform="translate(-26 -26) scale(.203125)">{node.icon.wash.map(d => <path class="ink-glyph-wash" d={d} />)}{node.icon.line.map(d => <path class="ink-glyph-line" d={d} />)}</g>
                  </g>
                  {node.id === 'scd41' && <text class="ink-badge" x="0" y="9" text-anchor="middle">CO₂</text>}
                </g>
                <text class="ink-name" data-ink-label x={name.x} y={name.y} text-anchor={name.anchor} font-size={layout.nameSize}>{node.name}</text>
                <text class="ink-detail" data-ink-label x={name.x} y={name.y + layout.nameSize + 3} text-anchor={name.anchor} font-size={layout.nameSize - 2}>{node.detail}</text>
                {node.id === 'mqtt' && <g class="ink-stamp" transform="translate(-31 -31)"><g class="ink-stamp-body" data-ink-stamp><circle r="15" /><circle class="ink-stamp-inner" r="11.5" /><text y="2.6" text-anchor="middle">MQTT</text></g></g>}
                {node.id === 'writer' && <path class="ink-mark" data-ink-mark d={layout.scribble} pathLength="1" />}
                {node.id === 'timescale' && <path class="ink-mark" data-ink-mark d="M-22 32Q0 42 22 32" pathLength="1" />}
                {node.id === 'grafana' && <><path class="ink-mark" data-ink-mark d={layout.spark} pathLength="1" /><path class="ink-loop" data-ink-loop d={loop} pathLength="1" transform={layout.id === 'narrow' ? 'scale(.86)' : undefined} /></>}
              </g>
            );
          })}
          <g class="ink-notes">
            {layout.notes.map(note => <g data-ink-note={note.id}>
              {note.lines.map((line, row) => <text x={note.x} y={note.y + row * (layout.noteSize + 1)} text-anchor={note.anchor} font-size={layout.noteSize} mask={`url(#${id(`note-${note.id}-${row}`)})`} data-ink-note-line={`${note.id}-${row}`}>{line}</text>)}
            </g>)}
          </g>
          <g class="ink-drops">
            {layout.routes.map(route => <g class="ink-drop" data-ink-drop={route.id}><circle class="ink-drop-halo" r="9.5" /><circle class="ink-drop-body" r="4.8" /><circle class="ink-drop-shine" cx="-1.5" cy="-1.6" r="1.4" /></g>)}
          </g>
        </svg>
      );
    })}
  </div>
  <div class="ink-bar">
    <button type="button" class="ink-crosslink" data-flow-goto="respond" hidden>These readings also feed the controllers <span aria-hidden="true">→</span> Respond</button>
    <div class="ink-playback" data-pathway-controls hidden>
      <button type="button" data-pathway-pause aria-label="Pause Observe Animation"><span data-pathway-pause-icon aria-hidden="true">Ⅱ</span><span data-pathway-pause-label>Pause</span></button>
      <button type="button" data-pathway-replay aria-label="Replay Observe Animation"><span aria-hidden="true">↺</span>Replay</button>
    </div>
  </div>
  <p class="sr-only" data-pathway-status role="status" aria-live="polite"></p>
</div>

<style>
  /* Ink on paper: pencil routes wait, an ink drop carries each message and inks the route behind it. */
  .ink-flow{--ink:#24332f;--pencil:#c3beae;--accent:#c8602a;--wash:#eea77c;--final:#6f7957;--final-wash:#b6c29a;--note:#9a5b36;position:relative;min-width:0;margin:8px -10px 0}
  .ink-canvas{position:relative;border-radius:4px;background-color:#fbf9f2;background-image:radial-gradient(circle,#dcd6c2 .85px,transparent 1.15px);background-size:22px 22px;background-position:11px 11px}
  .ink-diagram{display:block;width:100%;height:auto;overflow:visible}
  .ink-narrow{display:none}
  .ink-route{fill:none;stroke:var(--pencil);stroke-width:1.4;stroke-linecap:round}
  .ink-trail{fill:none;stroke:var(--ink);stroke-width:2.1;stroke-linecap:round;stroke-dasharray:1 1.05}
  .ink-junction{fill:var(--ink)}
  .ink-wash{fill:var(--wash);fill-opacity:.24}
  .ink-node-final .ink-wash{fill:var(--final-wash);fill-opacity:.38}
  .ink-glyph-pencil{fill:var(--pencil)}
  .ink-glyph-line{fill:var(--ink)}
  .ink-glyph-wash{fill:var(--accent);fill-opacity:.32}
  .ink-node-final .ink-glyph-wash{fill:var(--final)}
  .ink-badge{font:600 8px var(--font-body,sans-serif);fill:var(--ink)}
  .ink-name{font-family:var(--font-body,sans-serif);font-weight:500;fill:var(--ink);letter-spacing:.01em}
  .ink-detail{font-family:var(--font-body,sans-serif);fill:#7c8276}
  .ink-node-final .ink-name{fill:#4f5a3c}
  .ink-ripple,.ink-splash{fill:none;stroke:var(--accent);stroke-width:1.2;opacity:0}
  .ink-stamp-body circle{fill:none;stroke:#b4521f;stroke-width:1.5}
  .ink-stamp-body .ink-stamp-inner{stroke-width:.8;stroke-dasharray:2 2.4}
  .ink-stamp-body text{font:700 6.6px var(--font-body,sans-serif);letter-spacing:.08em;fill:#b4521f}
  .ink-stamp-body{opacity:.8}
  .ink-mark{fill:none;stroke:var(--ink);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1 1.05}
  .ink-loop{fill:none;stroke:var(--final);stroke-width:1.7;stroke-linecap:round;stroke-dasharray:1 1.05}
  .ink-notes text{font-family:'Caveat',cursive;fill:var(--note)}
  .ink-drop{visibility:hidden}
  .ink-drop-halo{fill:var(--accent);fill-opacity:.16}
  .ink-drop-body{fill:var(--accent)}
  .ink-drop-shine{fill:#fff;fill-opacity:.75}
  .ink-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:8px 14px 2px;min-height:48px}
  .ink-crosslink{display:inline-block;min-height:44px;padding:9px 4px;border:0;background:none;color:var(--note);font:20px/1.1 'Caveat',cursive;text-align:left;cursor:pointer;text-decoration:underline;text-decoration-color:#9a5b3640;text-underline-offset:4px;transition:color .2s,text-decoration-color .2s}
  .ink-crosslink:hover{color:#7a4424;text-decoration-color:currentColor}
  .ink-crosslink:focus-visible,.ink-playback button:focus-visible{outline:2px solid #d45b36;outline-offset:3px}
  .ink-playback{display:flex;align-items:center;gap:9px;flex:none;margin-left:auto}
  .ink-playback button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;border:0;border-radius:3px;background:transparent;color:#69785f;padding:0 10px;font:11px var(--font-body,sans-serif);cursor:pointer}
  .ink-playback button>span[aria-hidden]{font-size:16px;line-height:1}
  .ink-playback button:hover{color:var(--note)}
  .ink-playback button:disabled{opacity:.45;cursor:default}
  @media(max-width:760px){.ink-flow{margin:0 -5px}.ink-wide{display:none}.ink-narrow{display:block;max-width:430px;margin:auto}.ink-bar{flex-wrap:wrap;padding:6px 8px 0;gap:0 8px}.ink-crosslink{flex:1 1 100%;font-size:19px}.ink-playback{gap:4px}.ink-playback button{padding-inline:8px;font-size:10px}}
  @media(prefers-reduced-motion:reduce){.ink-playback{display:none}.ink-crosslink{transition:none}}
</style>
