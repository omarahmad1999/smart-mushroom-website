};
const flow = flows[pathway];
const prefix = `ink-${pathway}`;
const loop = 'M-40-4C-42-34-6-44 22-36C46-28 48 8 30 28C10 46-30 42-40 14C-44 2-40-12-30-20';
const label = (side: Side, size: number) => ({
  below: { x: 0, y: 51, anchor: 'middle' }, above: { x: 0, y: -46 - size, anchor: 'middle' },
  right: { x: 50, y: -1, anchor: 'start' }, left: { x: -50, y: -1, anchor: 'end' },
})[side];
---
<div class="ink-flow" data-system-flow={pathway} data-flow-style="ink" data-flow-name={flow.name} data-flow-completion={flow.completion} data-flow-state="static" data-flow-stage="all" role="group" aria-label={`${flow.name} Pathway Illustration`}>
  <ol class="sr-only">{flow.steps.map(step => <li>{step}</li>)}</ol>
  <div class="ink-canvas" data-pathway-canvas>
    {flow.layouts.map(layout => {
      const id = (name: string) => `${prefix}-${layout.id}-${name}`;
      return (
        <svg class={`ink-diagram ink-${layout.id}`} data-flow-layout={layout.id} viewBox={layout.viewBox} aria-hidden="true">
          <defs>
            <radialGradient id={id('soft')}><stop offset=".6" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></radialGradient>
            <radialGradient id={id('glow')}><stop offset="0" stop-color="#ffd27a" stop-opacity=".95" /><stop offset=".55" stop-color="#ffc45c" stop-opacity=".45" /><stop offset="1" stop-color="#ffc45c" stop-opacity="0" /></radialGradient>
            <linearGradient id={id('feather')}><stop offset="0" stop-color="#fff" /><stop offset=".8" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
            {flow.parts.map(part => <mask id={id(`reveal-${part.id}`)}><circle class="ink-reveal" data-ink-reveal={part.id} r="72" fill={`url(#${id('soft')})`} /></mask>)}
            {layout.notes.flatMap(note => note.lines.map((_, row) => <mask id={id(`note-${note.id}-${row}`)}><rect class="ink-note-reveal" data-ink-note-reveal={`${note.id}-${row}`} x="-4000" y="-4000" width="8000" height="8000" fill={`url(#${id('feather')})`} /></mask>))}
          </defs>
          <g class="ink-routes">
            {flow.links.map(link => <g class:list={{ 'ink-link-dashed': link.dashed }} data-ink-route-group={link.id}>
              <path class="ink-route" d={layout.routes[link.id]} data-ink-route={link.id} data-ink-to={link.to} data-ink-kind={link.kind} />
              <path class="ink-trail" d={layout.routes[link.id]} pathLength="1" data-ink-trail={link.id} />
            </g>)}
            {layout.junction && <circle class="ink-junction" data-ink-junction cx={layout.junction[0]} cy={layout.junction[1]} r="3.2" />}
          </g>
          {flow.parts.map((part, index) => {
            const [x, y] = layout.at[part.id];
            const name = label(layout.sides?.[part.id] ?? (layout.id === 'wide' ? 'below' : 'right'), layout.nameSize);
            const stamp = layout.stamp ?? [-31, -31];
            return (
              <g class:list={['ink-node', { 'ink-node-final': part.final }]} data-ink-node={part.id} data-verb={part.verb} data-source={part.source ? 'true' : undefined} data-final={part.final ? 'true' : undefined} data-state="ink" transform={`translate(${x} ${y})`}>
                <path class="ink-wash" data-ink-wash d={blob(31 + index * 17, 36)} />
                {part.verb === 'glow' && <circle class="ink-glow" data-ink-glow r="40" fill={`url(#${id('glow')})`} />}
                {part.verb === 'ripple' && [0, 1].map(() => <circle class="ink-ripple" data-ink-ripple r="30" />)}
                {!part.source && <circle class="ink-splash" data-ink-splash r="11" />}
                <g class="ink-icon" data-ink-icon>
                  <g class="ink-glyph-pencil" transform="translate(-26 -26) scale(.203125)">{part.icon.line.map(d => <path d={d} />)}</g>
                  <g mask={`url(#${id(`reveal-${part.id}`)})`}>
                    <g class="ink-glyph-ink" transform="translate(-26 -26) scale(.203125)">{part.icon.wash.map(d => <path class="ink-glyph-wash" d={d} />)}{part.icon.line.map(d => <path class="ink-glyph-line" d={d} />)}</g>
                  </g>
                  {part.badge && <text class="ink-badge" x="0" y="9" text-anchor="middle">{part.badge}</text>}
                </g>
                <text class="ink-name" data-ink-label x={name.x} y={name.y} text-anchor={name.anchor} font-size={layout.nameSize}>{part.name}</text>
                <text class="ink-detail" data-ink-label x={name.x} y={name.y + layout.nameSize + 3} text-anchor={name.anchor} font-size={layout.nameSize - 2}>{part.detail}</text>
                {part.verb === 'stamp' && <g class="ink-stamp" transform={`translate(${stamp[0]} ${stamp[1]})`}><g class="ink-stamp-body" data-ink-stamp><circle r="15" /><circle class="ink-stamp-inner" r="11.5" /><text y="2.6" text-anchor="middle">MQTT</text></g></g>}
                {part.verb === 'flash' && <circle class="ink-flash" data-ink-flash r="14" />}
                {part.verb === 'mist' && [[-10, -30, 3.4], [2, -36, 4.2], [12, -29, 3]].map(([cx, cy, r]) => <circle class="ink-mist" data-ink-mist cx={cx} cy={cy} r={r} />)}
                {layout.marks[part.id] && <path class="ink-mark" data-ink-mark d={layout.marks[part.id]} pathLength="1" />}
                {part.final && !layout.groupLoop && <path class="ink-loop" data-ink-loop d={loop} pathLength="1" transform={layout.id === 'narrow' ? 'scale(.86)' : undefined} />}
              </g>
            );
          })}
          {layout.groupLoop && <path class="ink-loop" data-ink-group-loop d={layout.groupLoop} pathLength="1" />}
          <g class="ink-notes">
            {layout.notes.map(note => <g data-ink-note={note.id}>
              {note.lines.map((line, row) => <text x={note.x} y={note.y + row * (layout.noteSize + 1)} text-anchor={note.anchor} font-size={layout.noteSize} mask={`url(#${id(`note-${note.id}-${row}`)})`} data-ink-note-line={`${note.id}-${row}`}>{line}</text>)}
            </g>)}
          </g>
          <g class="ink-drops">
            {flow.links.map(link => <g class="ink-drop" data-ink-drop={link.id}>
              {link.kind === 'command' ? <><path class="ink-drop-halo" d="M-11-8L9 0L-11 8Z" /><path class="ink-drop-body" d="M-6-4.6L6 0L-6 4.6L-3.4 0Z" /></>
                : link.kind === 'photo' ? <><rect class="ink-drop-halo" x="-10" y="-8" width="20" height="16" rx="3" /><rect class="ink-drop-body" x="-6" y="-4.5" width="12" height="9" rx="1.5" /><rect class="ink-drop-shine" x="-3.6" y="-2.2" width="7.2" height="4.4" rx=".8" /></>
                : <><circle class="ink-drop-halo" r="9.5" /><circle class="ink-drop-body" r="4.8" /><circle class="ink-drop-shine" cx="-1.5" cy="-1.6" r="1.4" /></>}
            </g>)}
          </g>
        </svg>
      );
    })}
  </div>
  <div class="ink-bar">
    {flow.crosslink && <button type="button" class="ink-crosslink" data-flow-goto={flow.crosslink.to} hidden>{flow.crosslink.text} <span aria-hidden="true">→</span> {flows[flow.crosslink.to].name}</button>}
    <div class="ink-playback" data-pathway-controls hidden>
      <button type="button" data-pathway-pause aria-label={`Pause ${flow.name} Animation`}><span data-pathway-pause-icon aria-hidden="true">Ⅱ</span><span data-pathway-pause-label>Pause</span></button>
      <button type="button" data-pathway-replay aria-label={`Replay ${flow.name} Animation`}><span aria-hidden="true">↺</span>Replay</button>
    </div>
  </div>
  <p class="sr-only" data-pathway-status role="status" aria-live="polite"></p>
</div>

<style>
