---
import '@fontsource/caveat/400.css';
import thermometer from '@phosphor-icons/core/duotone/thermometer-duotone.svg?raw';
import cloud from '@phosphor-icons/core/duotone/cloud-duotone.svg?raw';
import broadcast from '@phosphor-icons/core/duotone/broadcast-duotone.svg?raw';
import pencil from '@phosphor-icons/core/duotone/pencil-line-duotone.svg?raw';
import database from '@phosphor-icons/core/duotone/database-duotone.svg?raw';
import chart from '@phosphor-icons/core/duotone/chart-line-duotone.svg?raw';
import sliders from '@phosphor-icons/core/duotone/sliders-horizontal-duotone.svg?raw';
import scales from '@phosphor-icons/core/duotone/scales-duotone.svg?raw';
import house from '@phosphor-icons/core/duotone/house-duotone.svg?raw';
import toggle from '@phosphor-icons/core/duotone/toggle-right-duotone.svg?raw';
import fan from '@phosphor-icons/core/duotone/fan-duotone.svg?raw';
import drop from '@phosphor-icons/core/duotone/drop-duotone.svg?raw';
import lightbulb from '@phosphor-icons/core/duotone/lightbulb-duotone.svg?raw';
import timer from '@phosphor-icons/core/duotone/timer-duotone.svg?raw';
import camera from '@phosphor-icons/core/duotone/camera-duotone.svg?raw';
import images from '@phosphor-icons/core/duotone/images-duotone.svg?raw';
import film from '@phosphor-icons/core/duotone/film-strip-duotone.svg?raw';

type Pathway = 'observe' | 'respond' | 'record';
interface Props { pathway: Pathway }
const { pathway } = Astro.props;
type Point = [number, number];
type Side = 'below' | 'above' | 'right' | 'left';

// Phosphor duotone icons: the translucent layer becomes a watercolour wash, the rest is the ink line.
function glyph(raw: string) {
  const paths = [...raw.matchAll(/<path d="([^"]+)"( opacity="[^"]+")?\s*\/>/g)];
  return { wash: paths.filter(path => path[2]).map(path => path[1]), line: paths.filter(path => !path[2]).map(path => path[1]) };
}
// A slightly uneven wash behind each part: a closed Catmull-Rom curve through jittered points, seeded per part.
function blob(seed: number, radius: number) {
  let n = seed; const rand = () => (n = n * 16807 % 2147483647) / 2147483647;
  const points = Array.from({ length: 9 }, (_, i) => { const angle = i / 9 * Math.PI * 2, reach = radius * (.9 + rand() * .2); return [Math.cos(angle) * reach, Math.sin(angle) * reach]; });
  const at = (i: number) => points[(i + points.length) % points.length], f = (v: number) => v.toFixed(1);
  let d = `M${f(points[0][0])} ${f(points[0][1])}`;
  for (let i = 0; i < points.length; i++) {
    const [p0, p1, p2, p3] = [at(i - 1), at(i), at(i + 1), at(i + 2)];
    d += `C${f(p1[0] + (p2[0] - p0[0]) / 6)} ${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)} ${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])} ${f(p2[1])}`;
  }
  return `${d}Z`;
}

// Each part does one small thing when a message arrives (its verb); sources start the path, the final part is circled.
type Part = { id: string; name: string; detail: string; icon: ReturnType<typeof glyph>; verb: string; source?: boolean; final?: boolean; badge?: string };
type Link = { id: string; to: string; kind: 'reading' | 'command' | 'photo'; dashed?: boolean };
type Layout = {
  id: 'wide' | 'narrow'; viewBox: string; nameSize: number; noteSize: number;
  at: Record<string, Point>; sides?: Record<string, Side>; junction?: Point; stamp?: Point;
  routes: Record<string, string>; notes: { id: string; x: number; y: number; anchor: 'middle' | 'end' | 'start'; lines: string[] }[];
  marks: Record<string, string>;
  // One hand-drawn loop around several final parts, instead of a loop around each.
  groupLoop?: string;
};
const flows: Record<Pathway, { name: string; completion: string; steps: string[]; parts: Part[]; links: Link[]; layouts: Layout[]; crosslink?: { to: Pathway; text: string } }> = {
  observe: {
    name: 'Observe', completion: 'Grafana displays the stored measurements.',
    steps: [
      'The SHT31 and SCD41 sensors send their readings together. The two paths merge before Mosquitto, the MQTT broker.',
      'Mosquitto carries the published measurements to the database writer.',
      'The database writer stores the measurements in TimescaleDB.',
      'Grafana visualizes the stored measurements from TimescaleDB.',
    ],
    parts: [
      { id: 'sht31', name: 'SHT31', detail: 'temperature, humidity', icon: glyph(thermometer), verb: 'ripple', source: true },
      { id: 'scd41', name: 'SCD41', detail: 'CO₂', icon: glyph(cloud), verb: 'ripple', source: true, badge: 'CO₂' },
      { id: 'mqtt', name: 'Mosquitto', detail: 'MQTT broker', icon: glyph(broadcast), verb: 'stamp' },
      { id: 'writer', name: 'Database writer', detail: 'Python service', icon: glyph(pencil), verb: 'scribble' },
      { id: 'timescale', name: 'TimescaleDB', detail: 'experiment history', icon: glyph(database), verb: 'layer' },
      { id: 'grafana', name: 'Grafana', detail: 'dashboards', icon: glyph(chart), verb: 'chart', final: true },
    ],
    links: [
      { id: 'sht31', to: 'junction', kind: 'reading' }, { id: 'scd41', to: 'junction', kind: 'reading' }, { id: 'merged', to: 'mqtt', kind: 'reading' },
      { id: 'published', to: 'writer', kind: 'reading' }, { id: 'stored', to: 'timescale', kind: 'reading' }, { id: 'visualized', to: 'grafana', kind: 'reading' },
    ],
    // Wide: a left-to-right zigzag with names under each part. Narrow: one column that fits a phone screen,
    // names to the right of each part and the handwritten notes to the left of the thread.
    layouts: [
      {
        id: 'wide', viewBox: '0 0 1160 440', nameSize: 13, noteSize: 19,
        at: { sht31: [110, 110], scd41: [110, 322], mqtt: [398, 216], writer: [624, 110], timescale: [842, 306], grafana: [1030, 188] },
        junction: [238, 216],
        routes: {
          sht31: 'M146 110C200 110 200 216 238 216', scd41: 'M146 322C200 322 200 216 238 216', merged: 'M238 216H356',
          published: 'M440 216C520 216 500 110 582 110', stored: 'M666 110C750 110 718 306 800 306', visualized: 'M884 306C960 306 916 188 988 188',
        },
        notes: [
          { id: 'readings', x: 300, y: 196, anchor: 'middle', lines: ['send readings'] },
          { id: 'published', x: 562, y: 250, anchor: 'middle', lines: ['carries published', 'measurements'] },
          { id: 'stored', x: 802, y: 170, anchor: 'middle', lines: ['stores', 'measurements'] },
          { id: 'visualized', x: 1002, y: 300, anchor: 'middle', lines: ['visualizes stored', 'measurements'] },
        ],
        marks: { writer: 'M-32 82c5-6 9 3 14-2s8-6 13 0 7 4 12-1 7-5 12 1 6 3 10-1', timescale: 'M-22 32Q0 42 22 32', grafana: 'M58 8L68-2L76 4L86-10L96-4L108-16' },
      },
      {
        id: 'narrow', viewBox: '0 0 384 690', nameSize: 14, noteSize: 17,
        at: { sht31: [68, 56], scd41: [252, 56], mqtt: [160, 236], writer: [160, 366], timescale: [160, 496], grafana: [160, 626] },
        sides: { sht31: 'below', scd41: 'below' }, junction: [160, 150],
        routes: {
          sht31: 'M104 56C150 56 160 100 160 150', scd41: 'M216 56C170 56 160 100 160 150', merged: 'M160 150V194',
          published: 'M160 278C182 296 138 306 160 324', stored: 'M160 408C182 426 138 436 160 454', visualized: 'M160 538C182 556 138 566 160 584',
        },
        notes: [
          { id: 'readings', x: 136, y: 178, anchor: 'end', lines: ['send readings'] },
          { id: 'published', x: 132, y: 297, anchor: 'end', lines: ['carries published', 'measurements'] },
          { id: 'stored', x: 132, y: 427, anchor: 'end', lines: ['stores', 'measurements'] },
          { id: 'visualized', x: 132, y: 557, anchor: 'end', lines: ['visualizes stored', 'measurements'] },
        ],
        marks: { writer: 'M42 30c5-6 9 3 14-2s8-6 13 0 7 4 12-1 7-5 12 1 6 3 10-1', timescale: 'M-22 32Q0 42 22 32', grafana: 'M50 40L60 32L68 37L78 26L88 31L100 20' },
      },
    ],
    crosslink: { to: 'respond', text: 'These readings also feed the controllers' },
  },
  respond: {
    name: 'Respond', completion: 'The actuator services drive ventilation, moisture and lighting in the tent.',
    steps: [
      'Readings and phase settings provide the context for a decision.',
      'The controllers, Python services, evaluate the configured conditions and publish commands through Mosquitto, the MQTT broker.',
      'Home Assistant adds manual control, sending its commands the same way.',
      'Mosquitto routes the commands to the actuator services.',
      'The actuator services drive the fan, humidifier and LEDs.',
    ],
    parts: [
      { id: 'inputs', name: 'Readings & phase settings', detail: 'the context for a decision', icon: glyph(sliders), verb: 'ripple', source: true },
      { id: 'controllers', name: 'Controllers', detail: 'environment & lighting', icon: glyph(scales), verb: 'tilt' },
      { id: 'mqtt', name: 'Mosquitto', detail: 'MQTT broker', icon: glyph(broadcast), verb: 'stamp' },
      { id: 'ha', name: 'Home Assistant', detail: 'manual control', icon: glyph(house), verb: 'ripple', source: true },
      { id: 'actuators', name: 'Actuator services', detail: 'Python services', icon: glyph(toggle), verb: 'toggle' },
      { id: 'fan', name: 'Fan', detail: 'ventilation', icon: glyph(fan), verb: 'spin', final: true },
      { id: 'humidifier', name: 'Humidifier', detail: 'moisture', icon: glyph(drop), verb: 'mist', final: true },
      { id: 'leds', name: 'LEDs', detail: 'lighting', icon: glyph(lightbulb), verb: 'glow', final: true },
    ],
    links: [
      { id: 'evaluate', to: 'controllers', kind: 'reading' }, { id: 'commands', to: 'mqtt', kind: 'command' }, { id: 'manual', to: 'mqtt', kind: 'command', dashed: true },
      { id: 'route', to: 'actuators', kind: 'command' },
      { id: 'drive-fan', to: 'fan', kind: 'command' }, { id: 'drive-humidifier', to: 'humidifier', kind: 'command' }, { id: 'drive-leds', to: 'leds', kind: 'command' },
    ],
    layouts: [
      {
        id: 'wide', viewBox: '0 0 1160 480', nameSize: 13, noteSize: 19,
        at: { inputs: [110, 280], controllers: [330, 120], mqtt: [560, 250], ha: [560, 400], actuators: [790, 120], fan: [1030, 120], humidifier: [1030, 250], leds: [1030, 380] },
        sides: { mqtt: 'above', fan: 'right', humidifier: 'right', leds: 'right' }, stamp: [31, 31],
        routes: {
          evaluate: 'M152 280C230 280 210 120 288 120', commands: 'M372 120C450 120 440 250 518 250', manual: 'M560 358V292',
          route: 'M602 250C680 250 670 120 748 120',
          'drive-fan': 'M832 120H988', 'drive-humidifier': 'M832 120C900 120 920 250 988 250', 'drive-leds': 'M832 120C900 120 900 380 988 380',
        },
        notes: [
          { id: 'evaluate', x: 180, y: 162, anchor: 'middle', lines: ['evaluate', 'conditions'] },
          { id: 'commands', x: 500, y: 150, anchor: 'middle', lines: ['publish commands'] },
          { id: 'manual', x: 578, y: 330, anchor: 'start', lines: ['manual control'] },
          { id: 'route', x: 716, y: 236, anchor: 'middle', lines: ['route', 'commands'] },
          { id: 'drive', x: 910, y: 106, anchor: 'middle', lines: ['drive devices'] },
        ],
        marks: {},
        groupLoop: 'M998 80C1016 64 1048 66 1062 86C1072 150 1074 300 1066 400C1058 424 1006 428 994 402C984 330 984 160 992 96C996 84 1004 74 1016 70',
      },
      {
        id: 'narrow', viewBox: '0 0 384 716', nameSize: 14, noteSize: 17,
        at: { inputs: [140, 60], controllers: [140, 190], mqtt: [140, 330], ha: [320, 330], actuators: [140, 470], fan: [60, 612], humidifier: [180, 612], leds: [300, 612] },
        sides: { mqtt: 'left', ha: 'below', fan: 'below', humidifier: 'below', leds: 'below' },
        routes: {
          evaluate: 'M140 102C162 120 118 130 140 148', commands: 'M140 232C162 256 118 270 140 288', manual: 'M278 330H182',
          route: 'M140 372C162 396 118 410 140 428',
          'drive-fan': 'M140 512C140 548 60 540 60 570', 'drive-humidifier': 'M140 512C140 548 180 540 180 570', 'drive-leds': 'M140 512C140 548 300 530 300 570',
        },
        notes: [
          { id: 'evaluate', x: 112, y: 121, anchor: 'end', lines: ['evaluate', 'conditions'] },
          { id: 'commands', x: 112, y: 256, anchor: 'end', lines: ['publish', 'commands'] },
          { id: 'manual', x: 230, y: 316, anchor: 'middle', lines: ['manual control'] },
          { id: 'route', x: 112, y: 396, anchor: 'end', lines: ['route', 'commands'] },
          { id: 'drive', x: 192, y: 506, anchor: 'start', lines: ['drive devices'] },
        ],
        marks: {},
        // Names sit under the devices here, so the loop circles each device together with its name.
        groupLoop: 'M22 592C28 570 92 565 180 567S338 564 352 588C362 616 362 664 350 684C338 694 262 696 180 695S34 698 20 682C8 664 10 612 20 596C24 588 34 580 50 575',
      },
    ],
    crosslink: { to: 'observe', text: 'The sensors notice the change' },
  },
  record: {
    name: 'Record', completion: 'Selected photographs and completed timelapses form the visual record.',
    steps: [
      'The capture schedule uses a systemd timer, with timing following the cultivation phase.',
      'Two cameras photograph the tent and ambient view using Camera Module 3 Wide cameras.',
      'Image storage keeps the captured still photographs as local media files.',
      'Media preparation selects images and produces completed timelapses.',
    ],
    parts: [
      { id: 'schedule', name: 'Capture schedule', detail: 'systemd timer', icon: glyph(timer), verb: 'tick', source: true },
      { id: 'cameras', name: 'Two cameras', detail: 'Camera Module 3 Wide', icon: glyph(camera), verb: 'flash' },
      { id: 'storage', name: 'Image storage', detail: 'local media files', icon: glyph(images), verb: 'stack' },
      { id: 'media', name: 'Media preparation', detail: 'timelapses', icon: glyph(film), verb: 'film', final: true },
    ],
    links: [{ id: 'trigger', to: 'cameras', kind: 'command' }, { id: 'save', to: 'storage', kind: 'photo' }, { id: 'prepare', to: 'media', kind: 'photo' }],
    layouts: [
      {
        id: 'wide', viewBox: '0 0 1160 440', nameSize: 13, noteSize: 19,
        at: { schedule: [130, 150], cameras: [430, 310], storage: [740, 110], media: [1030, 270] },
        routes: { trigger: 'M172 150C280 150 280 310 388 310', save: 'M472 310C590 310 580 110 698 110', prepare: 'M782 110C890 110 880 270 988 270' },
        notes: [
          { id: 'trigger', x: 345, y: 196, anchor: 'middle', lines: ['trigger capture'] },
          { id: 'save', x: 650, y: 250, anchor: 'middle', lines: ['save images'] },
          { id: 'prepare', x: 950, y: 150, anchor: 'middle', lines: ['produce timelapses'] },
        ],
        marks: { storage: 'M-14-20h30v22' },
      },
      {
        id: 'narrow', viewBox: '0 0 384 510', nameSize: 14, noteSize: 17,
        at: { schedule: [160, 60], cameras: [160, 190], storage: [160, 320], media: [160, 450] },
        routes: { trigger: 'M160 102C182 120 138 130 160 148', save: 'M160 232C182 250 138 260 160 278', prepare: 'M160 362C182 380 138 390 160 408' },
        notes: [
          { id: 'trigger', x: 132, y: 129, anchor: 'end', lines: ['trigger capture'] },
          { id: 'save', x: 132, y: 259, anchor: 'end', lines: ['save images'] },
          { id: 'prepare', x: 132, y: 389, anchor: 'end', lines: ['produce timelapses'] },
        ],
        marks: { storage: 'M-14-20h30v22' },
      },
    ],
