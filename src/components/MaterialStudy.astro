---
import { components, categories } from '../scripts/study/content';
import ResourceLink from './ResourceLink.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';
---
<section id="material-study" class="material-study" aria-labelledby="study-heading" data-material-study>
  <div class="ms-container">
    <div class="ms-eyebrow"><span class="ms-marker" aria-hidden="true"></span>STEP INSIDE<span class="ms-rule" aria-hidden="true"></span>THE HABITAT, IN DETAIL</div>
    <header class="ms-heading"><h1 id="study-heading">A small habitat.<br /><em>A whole system.</em></h1><div class="ms-introduction"><p>Every piece has a part to play. Turn the tent, peel back its covering, and explore the hardware from the growing space to the workbench.</p><span class="ms-model-label"><span aria-hidden="true">✳</span> An interactive illustration of the experiment</span></div></header>
    <div class="ms-pairing">
      <div class="ms-photo-column">
        <figure class="ms-mushroom-photo"><img src="/media/study/mushroom-960.webp" srcset="/media/study/mushroom-480.webp 480w, /media/study/mushroom-960.webp 960w" sizes="(max-width: 1000px) 90vw, 27vw" width="4000" height="6000" loading="eager" fetchpriority="high" decoding="async" alt="Small orange mushrooms emerging among dark leaves and branches." /></figure>
        <div class="ms-pairing-caption"><p>A closer look at the world we grow.</p><a href="#experiment" class="button button-dark ms-explore">Explore the experiment <Icon name="arrow-down" /></a></div>
      </div>
      <div class="ms-interactive-column">
    <div class="ms-scene-shell">
      <div class="ms-region-bar" role="group" aria-label="Choose a view of the setup"><button type="button" disabled data-study-region="overview" aria-pressed="true">Whole setup</button><button type="button" disabled data-study-region="tent" aria-pressed="false">Inside the tent</button><button type="button" disabled data-study-region="workbench" aria-pressed="false">The workbench</button></div>
      <div class="ms-viewport" data-study-viewport aria-label="Interactive three-dimensional mushroom tent and hardware workbench" aria-describedby="study-instructions"><div class="ms-fallback" data-study-fallback><picture><source media="(max-width: 700px)" srcset="/media/full-habitat-poster-mobile.webp" /><img src="/media/full-habitat-poster.webp" alt="Illustrated mushroom tent with hanging oyster bags, a PVC frame, ventilation, sensors, cameras and a Fresh air cooler with a high duct, beside an expanded workbench with a monitor, keyboard, mouse and breadboard." width="1029" height="661" loading="eager" decoding="async" /></picture></div></div>
      <div class="ms-scene-caption"><span>SMART MUSHROOM HUB</span><span data-study-status role="status" aria-live="polite">Still view · Illustrative model</span></div>
      <aside class="ms-detail" id="study-component-detail" data-study-detail hidden aria-live="polite" aria-atomic="true">
        <button type="button" disabled class="ms-detail-close" data-study-close aria-label="Close component explanation"><Icon name="close" size={16} /></button>
        <span class="ms-detail-category" data-study-detail-category>THE HABITAT / 01</span><h3 data-study-detail-title>A place for life to take hold.</h3><p data-study-detail-copy>Two smaller cultivation bags hang on short ties from the upper and middle PVC racks.</p><table class="ms-terminal-table" data-study-terminals hidden><thead><tr><th>Hole</th><th>Left · <span data-study-load-label>Fan</span></th><th>Right · <span data-study-supply-label>12 V</span></th></tr></thead><tbody><tr><th>1st from top</th><td>Black</td><td>Black</td></tr><tr><th>2nd from top</th><td>Red</td><td>Red</td></tr><tr><th>Bottom</th><td>Red → T-cobbler</td><td>Black → T-cobbler</td></tr></tbody></table><p class="ms-detail-note" data-study-detail-note hidden></p>
        <div class="ms-screen-preview" data-study-screen-preview hidden><img src="/media/study/grafana-mockup.svg" width="1280" height="800" alt="Grafana dashboard mock-up displayed on the monitor." loading="lazy" /><ResourceLink href={site.grafanaUrl} resource="Grafana dashboard" class="ms-screen-link">View Data in Grafana</ResourceLink></div>
        <button type="button" disabled class="ms-demo-button" data-study-action="mushrooms" aria-pressed="true"><span data-study-action-label>Hide illustrated mushrooms</span><span aria-hidden="true">↗</span></button><a class="ms-detail-link" data-study-detail-link href="#cultivation">Explore cultivation phases <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
    <div class="ms-toolbar" role="group" aria-label="3D scene controls"><div class="ms-primary-controls">
      <button type="button" disabled class="ms-control ms-reset" data-study-reset aria-label="Reset the scene view"><span aria-hidden="true">↺</span> Reset</button>
      <div class="ms-menu" data-study-menu="layers">
        <button type="button" disabled class="ms-control ms-menu-button" data-study-menu-toggle aria-expanded="false" aria-controls="ms-layers-panel">Layers <span class="ms-menu-count" data-study-layer-count>2 on</span><span class="ms-menu-mark" aria-hidden="true">▾</span></button>
        <div class="ms-menu-panel" id="ms-layers-panel" role="group" aria-label="Layers" hidden>
          <button type="button" disabled class="ms-control ms-state-control" data-study-cover aria-pressed="false">Cover<span class="ms-switch" aria-hidden="true"></span></button>
          <button type="button" disabled class="ms-control ms-state-control" data-study-wiring aria-pressed="false">Wiring<span class="ms-switch" aria-hidden="true"></span></button>
          <button type="button" disabled class="ms-control ms-state-control" data-study-mushrooms aria-pressed="true">Mushrooms<span class="ms-switch" aria-hidden="true"></span></button>
          <button type="button" disabled class="ms-control ms-state-control" data-study-labels aria-pressed="true">Markers<span class="ms-switch" aria-hidden="true"></span></button>
          <button type="button" disabled class="ms-control ms-state-control" data-study-every aria-pressed="false">Number every part<span class="ms-switch" aria-hidden="true"></span></button>
        </div>
      </div>
      <div class="ms-menu" data-study-menu="play">
        <button type="button" disabled class="ms-control ms-menu-button" data-study-menu-toggle aria-expanded="false" aria-controls="ms-play-panel">Play<span class="ms-menu-mark" aria-hidden="true">▾</span></button>
        <div class="ms-menu-panel" id="ms-play-panel" role="group" aria-label="Play" hidden>
          <button type="button" disabled class="ms-control ms-play-item" data-study-build>Replay the build <span aria-hidden="true">↗</span></button>
        </div>
      </div>
      <button type="button" disabled class="ms-control ms-state-control" data-study-rotate aria-pressed="false">Rotate<span class="ms-switch" aria-hidden="true"></span></button>
      <button type="button" disabled class="ms-control ms-state-control" data-study-sound aria-pressed="true" aria-label="Sound effects">Sound<span class="ms-switch" aria-hidden="true"></span></button>
    </div><div class="ms-zoom-controls" role="group" aria-label="Zoom the scene"><button type="button" disabled class="ms-zoom-button" data-study-zoom="out" aria-label="Zoom out">−</button><span class="ms-zoom-divider" aria-hidden="true"></span><button type="button" disabled class="ms-zoom-button" data-study-zoom="in" aria-label="Zoom in">+</button></div></div>
    <p class="ms-instructions" id="study-instructions">Drag to turn <span aria-hidden="true">·</span> Click a component to explore <span aria-hidden="true">·</span> + / − to zoom</p>
      </div>
    </div>
    <details class="ms-exploration"><summary class="ms-picker-heading"><span class="ms-small-label">EVERY PIECE HAS A PURPOSE</span><span class="ms-picker-hint">Explore the components <span class="ms-disclosure-mark" aria-hidden="true">+</span></span></summary><div class="ms-component-groups">{categories.map(category => <div class="ms-component-group"><h3>{category}</h3><div role="group" aria-label={category}>{components.filter(component => component.category === category).map(component => <button type="button" disabled data-study-select={component.id} aria-pressed={component.id === 'bag' ? 'true' : 'false'} aria-controls="study-component-detail"><span class="ms-component-index" aria-hidden="true">{component.number}</span><span>{component.label}</span><span class="ms-component-arrow" aria-hidden="true">↗</span></button>)}</div></div>)}</div></details>
    <noscript><p class="ms-nojs">The illustration and experiment chapters are available on this page. The 3D controls need JavaScript.</p></noscript>
  </div>
</section>
<script>import '../scripts/material-study';</script>
<style>
.material-study{padding-top:45px!important}.ms-explore{display:flex;width:max-content;max-width:100%;margin-top:10px;margin-left:auto;font-family:var(--font-body);font-style:normal;font-size:11px}.ms-picker-heading{cursor:pointer;list-style:none;min-height:56px}.ms-picker-heading::-webkit-details-marker{display:none}.ms-disclosure-mark{display:inline-block;font-size:21px;margin-left:12px;transition:transform .2s}.ms-exploration[open] .ms-disclosure-mark{transform:rotate(45deg)}.ms-exploration[open] .ms-component-groups{padding-top:20px}

.material-study{--ms-ink:#172b29;--ms-muted:#697361;--ms-olive:#738060;--ms-accent:#ce5b39;--ms-line:#d4d9c9;background:#f6f3eb;color:var(--ms-ink);padding-block:clamp(75px,8vw,120px);scroll-margin-top:100px}.ms-container{width:min(var(--page-width),calc(100% - 2 * var(--page-pad,5vw)));margin-inline:auto}.ms-eyebrow{display:flex;align-items:center;gap:12px;font-size:9px;font-weight:500;letter-spacing:.14em;line-height:1.5;color:#68755e}.ms-marker{width:5px;height:5px;background:var(--ms-accent);flex:0 0 5px}.ms-rule{height:1px;background:var(--ms-line);flex:1;margin-inline:12px}.ms-heading{display:grid;grid-template-columns:1fr .8fr;align-items:end;gap:90px;margin:45px 0 40px}.ms-heading h1{font-family:var(--font-display);font-size:clamp(45px,5.5vw,76px);line-height:1.02;letter-spacing:-.045em}.ms-heading h1 em{color:var(--ms-olive)}.ms-introduction{justify-self:end;max-width:380px;padding-bottom:4px}.ms-introduction p{font-size:13px;line-height:1.85;color:var(--ms-muted)}.ms-model-label{display:flex;align-items:center;gap:10px;margin-top:19px;font-size:10px;color:var(--ms-olive)}.ms-model-label>span{font-size:23px;line-height:1;color:#94a07e}
.ms-scene-shell{position:relative;background:#eeece2;border:1px solid #dedfd4}.ms-region-bar{display:flex;justify-content:center;gap:5px;padding:15px 12px 0;position:relative;z-index:3}.ms-region-bar button{min-height:44px;padding:9px 17px;background:transparent;border:1px solid transparent;border-radius:25px;font-size:10px;color:var(--ms-muted)}.ms-region-bar button[aria-pressed=true]{background:#f8f6ee;border-color:#d2d8c5;color:#526044}.ms-viewport{position:relative;width:100%;height:clamp(560px,44vw,660px);overflow:hidden;isolation:isolate}.ms-viewport :global(canvas){position:absolute;inset:0;display:block;width:100%;height:100%;max-width:100%;touch-action:pan-y}.ms-fallback{position:absolute;inset:0;background:#eeece2;pointer-events:none}.ms-fallback :global(img){display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:contain}.ms-viewport :global([data-study-hotspot]){position:absolute;z-index:2;transform:translate(-50%,-50%);width:44px;height:44px;border:0;border-radius:50%;background:transparent;color:#59674d;font-size:8px;font-weight:500;cursor:pointer;isolation:isolate;opacity:.58;transition:opacity .18s}.ms-viewport :global([data-study-hotspot]::before){content:'';position:absolute;inset:11px;z-index:-1;border-radius:50%;background:#f6f3ebd9;border:1px solid #abb49c;box-shadow:0 2px 7px #36432b14;transition:transform .2s,background .2s}.ms-viewport :global([data-study-hotspot]:hover),.ms-viewport :global([data-study-hotspot]:focus),.ms-viewport :global([data-study-hotspot][aria-pressed=true]){opacity:1}.ms-viewport :global([data-study-hotspot]:hover::before){transform:scale(1.10)}.ms-viewport :global([data-study-hotspot][aria-pressed=true]::before){background:#758266;border-color:#758266}.ms-viewport :global([data-study-hotspot][aria-pressed=true]){color:#fffdf5}.ms-viewport :global([data-study-hotspot]::after){content:attr(data-label);position:absolute;bottom:39px;left:50%;transform:translateX(-50%);padding:7px 9px;white-space:nowrap;background:#f8f6ee;border:1px solid #d4d9c9;border-radius:3px;pointer-events:none;font-size:10px;color:#526044;opacity:0;transition:opacity .15s}.ms-viewport :global([data-study-hotspot]:hover::after),.ms-viewport :global([data-study-hotspot]:focus-visible::after){opacity:1}.ms-scene-caption{display:flex;justify-content:space-between;align-items:center;padding:0 22px 17px;gap:20px;font-size:8px;line-height:1.6;letter-spacing:.1em;color:#68745e}.ms-scene-caption>span:last-child{letter-spacing:.025em;text-align:right;max-width:60%;min-height:3.2em}
.ms-detail{position:absolute;z-index:5;right:18px;top:67px;width:275px;padding:28px 23px 21px;background:#faf8eff5;border:1px solid #d6dccb;border-radius:7px;box-shadow:0 12px 40px #4e5a3520;backdrop-filter:blur(8px)}.ms-detail-close{position:absolute;right:8px;top:8px;width:35px;height:35px;display:grid;place-items:center;background:transparent;color:#697361}.ms-detail-category{font-size:8px;letter-spacing:.12em;color:var(--ms-olive);display:block;padding-right:15px;margin-bottom:19px}.ms-detail h3{font-family:var(--font-display);font-size:29px;line-height:1.08;letter-spacing:-.025em;margin:0 0 14px}.ms-detail p{font-size:11px;line-height:1.8;color:#586451}.ms-detail .ms-detail-note{font-size:9px;border-left:2px solid #cbd1bc;padding-left:9px;margin:15px 0 20px;color:#7a816f}.ms-demo-button{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#e4e8d9;color:#526044;border:1px solid #cbd3bb;padding:11px 12px;min-height:44px;border-radius:3px;font-size:10px;text-align:left}.ms-demo-button[aria-pressed=true]{background:#77866b;color:#fffdf5;border-color:#77866b}.ms-detail-link{display:flex;justify-content:space-between;gap:10px;font-size:10px;line-height:1.5;text-decoration:none;padding-top:17px;color:#55694d}.ms-detail[hidden]{display:none}.material-study:not([data-study-state=ready]) .ms-viewport :global(canvas),.material-study:not([data-study-state=ready]) .ms-viewport :global([data-study-hotspot]),.material-study:not([data-study-state=ready]) .ms-viewport :global([data-study-leaders]){visibility:hidden}
.ms-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--ms-line);padding:9px 0}.ms-primary-controls{display:flex;align-items:center;gap:1px;flex-wrap:wrap}.ms-control{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 11px;background:transparent;color:#4e5f49;font-size:10px;white-space:nowrap}.ms-control:hover{color:var(--ms-accent)}.ms-reset{padding-left:1px;padding-right:17px}.ms-switch{display:block;width:22px;height:12px;flex:0 0 22px;border-radius:20px;background:#c6cdbb;position:relative}.ms-switch::after{content:'';position:absolute;width:6px;height:6px;left:3px;top:3px;border-radius:50%;background:#f6f3eb;transition:transform .2s}.ms-state-control[aria-pressed=true] .ms-switch{background:#7e8d6b}.ms-state-control[aria-pressed=true] .ms-switch::after{transform:translateX(10px)}.ms-zoom-controls{display:flex;align-items:center;flex:none}.ms-zoom-button{display:grid;place-items:center;width:44px;min-height:44px;font-size:22px;color:#52624b;background:transparent}.ms-zoom-button:hover{background:#eeeee3}.ms-zoom-divider{width:1px;height:15px;background:var(--ms-line)}.material-study button:focus-visible{outline:2px solid var(--ms-accent);outline-offset:3px}.material-study button:disabled{opacity:.4;cursor:default}.ms-instructions{font-size:10px;line-height:1.8;text-align:right;color:var(--ms-muted);margin-top:12px}.ms-instructions>span{margin-inline:8px;color:#a4ad95}
.ms-exploration{margin-top:40px}.ms-picker-heading{display:flex;justify-content:space-between;gap:20px;padding-bottom:19px;border-bottom:1px solid var(--ms-line)}.ms-small-label{font-size:9px;letter-spacing:.13em;color:var(--ms-muted)}.ms-picker-hint{font-size:10px;color:#8a937f}.ms-component-groups{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:28px;margin-top:22px}.ms-component-group h3{font-family:var(--font-display);font-size:23px;color:#5e7053;margin-bottom:10px}.ms-component-group button{display:flex;align-items:center;gap:9px;min-height:44px;width:100%;padding:10px 0;border-bottom:1px solid #dce0d3;background:transparent;font-size:10px;color:var(--ms-muted);text-align:left}.ms-component-index{font-size:8px;color:#899779;flex:none}.ms-component-arrow{color:var(--ms-accent);font-size:17px;opacity:0;margin-left:auto;flex:none}.ms-component-group button[aria-pressed=true]{border-color:var(--ms-accent);color:var(--ms-ink)}.ms-component-group button[aria-pressed=true] .ms-component-arrow{opacity:1}.ms-component-group button:hover{color:var(--ms-accent)}.ms-nojs{font-size:12px;line-height:1.7;color:var(--ms-muted);margin-top:25px}
.ms-menu{position:relative}.ms-menu-button{gap:7px}.ms-menu-count{font-size:8px;letter-spacing:.04em;color:#8a937f}.ms-menu-mark{font-size:9px;color:#8a937f;transition:transform .2s}.ms-menu-button[aria-expanded=true] .ms-menu-mark{transform:rotate(180deg)}
.ms-menu-panel{position:absolute;z-index:6;left:0;bottom:calc(100% + 8px);display:grid;min-width:210px;padding:6px;background:#faf8ef;border:1px solid #d6dccb;border-radius:8px;box-shadow:0 14px 34px #4e5a3526}
.ms-menu-panel .ms-control{justify-content:space-between;width:100%;padding:0 10px;border-radius:5px}.ms-menu-panel .ms-control:hover{background:#eeeee3;color:#4e5f49}
.ms-play-item span{color:var(--ms-accent)}
@media(prefers-reduced-motion:reduce){.ms-menu-mark{transition:none}}
.ms-viewport :global([data-study-leaders]){position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none;stroke:#849076;stroke-width:.8}.ms-viewport :global(.ms-group-marker){position:absolute;z-index:3;transform:translate(-50%,-50%);display:flex;align-items:center;gap:8px;min-height:36px;padding:6px 7px 6px 13px;background:#f8f6eef0;border:1px solid #cfd6c2;border-radius:20px;box-shadow:0 4px 14px #36432b1f;color:#4f5f48;font-size:10px;white-space:nowrap;cursor:pointer;transition:transform .2s cubic-bezier(.2,.8,.25,1),box-shadow .2s,background .2s}
.ms-viewport :global(.ms-group-marker b){display:grid;place-items:center;min-width:22px;height:22px;padding:0 5px;border-radius:11px;background:#e3e8d8;color:#58674f;font-size:9px;font-weight:500}
.ms-viewport :global(.ms-group-marker:hover),.ms-viewport :global(.ms-group-marker:focus-visible){transform:translate(-50%,-50%) translateY(-2px);box-shadow:0 8px 20px #36432b2e;background:#fffdf5}
.material-study[data-study-lighting=tent] .ms-viewport :global(.ms-group-marker){background:#f8f6eed9}
@media(max-width:700px){.ms-viewport :global(.ms-group-marker){font-size:9px;min-height:32px;padding:4px 5px 4px 10px;gap:6px}.ms-viewport :global(.ms-group-marker b){min-width:20px;height:20px}}
@media(prefers-reduced-motion:reduce){.ms-viewport :global(.ms-group-marker){transition:none}}
.ms-viewport :global(.ms-hover-label){position:absolute;z-index:4;left:0;top:0;padding:6px 9px;background:#f8f6eef2;border:1px solid #d4d9c9;border-radius:3px;box-shadow:0 4px 12px #36432b1f;font-size:10px;color:#526044;white-space:nowrap;pointer-events:none}
@media(prefers-reduced-motion:no-preference){.ms-viewport :global([data-study-hotspot]),.ms-viewport :global(.ms-group-marker){transition:opacity .25s,transform .2s,box-shadow .2s,background .2s,display .25s allow-discrete}@starting-style{.ms-viewport :global([data-study-hotspot]),.ms-viewport :global(.ms-group-marker){opacity:0}}}
