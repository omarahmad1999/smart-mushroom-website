---
import { Image } from 'astro:assets';
import character from '../assets/about/myko-left-empty.png';
---
<section class="myko" data-myko data-mood="neutral" data-tracking="true" aria-label="Myko, a little mushroom explorer">
  <svg class="myko-floor" viewBox="0 0 1254 1254" aria-hidden="true">
    <path d="M250 1192L727 1144 1080 1193 1080 1210 604 1251 250 1210Z" fill="#c0b79e" stroke="#b0a88e" stroke-width="2"/>
    <path d="M250 1192L727 1144 1080 1193 604 1235Z" fill="#dfd8c5" stroke="#c2baa4" stroke-width="2"/>
    <path d="M410 1176L766 1220M576 1160L925 1207M419 1215L888 1167" fill="none" stroke="#c9c1ac" stroke-width="2"/>
    <ellipse cx="696" cy="1200" rx="305" ry="25" fill="#756d51" opacity=".14"/>
    <ellipse cx="471" cy="1175" rx="98" ry="13" fill="#756d51" opacity=".2"/>
    <ellipse cx="805" cy="1214" rx="119" ry="14" fill="#756d51" opacity=".2"/>
  </svg>
  <button class="myko-stage" type="button" aria-label="Say hello to Myko" aria-describedby="myko-hint" data-myko-hello>
    <Image src={character} width={650} format="webp" quality={90} alt="Myko, a cream robot covered in mushrooms, facing left" loading="eager" />
    <svg class="myko-face" viewBox="0 0 1254 1254" aria-hidden="true">
      <g class="gaze"><g class="eyes neutral"><ellipse cx="403" cy="480" rx="16" ry="40" transform="rotate(-12 403 480)"/><ellipse cx="554" cy="455" rx="28" ry="44" transform="rotate(-12 554 455)"/></g>
      <g class="eyes curious"><ellipse cx="403" cy="480" rx="17" ry="36" transform="rotate(-16 403 480)"/><ellipse cx="554" cy="455" rx="30" ry="48" transform="rotate(-12 554 455)"/></g>
      <g class="eyes happy" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round"><path d="M388 479Q400 449 418 474M528 456Q549 415 579 446"/></g>
      <g class="eyes melancholic"><path d="M387 474L419 468Q423 507 404 505Q391 503 387 474M525 452L581 440Q585 480 559 481Q536 487 525 452"/></g>
      <g class="eyes sleepy" fill="none" stroke="currentColor" stroke-width="11" stroke-linecap="round"><path d="M388 482Q405 501 420 475M531 461Q561 484 579 450"/></g>
      <g class="eyes surprised"><ellipse cx="403" cy="480" rx="20" ry="45" transform="rotate(-12 403 480)"/><ellipse cx="554" cy="455" rx="33" ry="52" transform="rotate(-12 554 455)"/></g></g>
    </svg>
    <span class="emotion-symbol" aria-hidden="true" data-emotion-symbol></span>
  </button>
  <p id="myko-hint" data-myko-hint>Myko · say hello</p>
  <button class="motion-toggle" type="button" data-myko-motion aria-pressed="true" hidden>Motion on</button>
</section>
<style>
.myko{text-align:center;min-width:0}.myko-stage{display:block;position:relative;width:100%;aspect-ratio:1;padding:0;border:0;background:none;cursor:pointer;transform-origin:50% 90%;transition:transform .3s;border-radius:20px}.myko-stage img{width:100%;height:auto;pointer-events:none}.myko-face{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;color:#ffdb92}.gaze{transform:translate(var(--eye-x,0px),var(--eye-y,0px));transition:transform .18s ease-out}.eyes{display:none;fill:currentColor;filter:drop-shadow(0 0 11px #ffb54b);transform-origin:480px 468px}.eyes.happy,.eyes.sleepy{fill:none}.myko[data-mood=neutral] .neutral,.myko[data-mood=happy] .happy,.myko[data-mood=curious] .curious,.myko[data-mood=melancholic] .melancholic,.myko[data-mood=sleepy] .sleepy,.myko[data-mood=surprised] .surprised{display:block}.surprised{color:#b4f7ff;filter:drop-shadow(0 0 15px #59ddeb)}.myko[data-blinking] .neutral{transform:scaleY(.1)}.emotion-symbol{position:absolute;left:14%;top:8%;font:37px/1 'Caveat',cursive;transform:rotate(-14deg);color:#8e8368;text-shadow:0 1px 2px var(--paper);pointer-events:none}.myko[data-mood=surprised] .emotion-symbol{color:#429ca8}.myko[data-mood=sleepy] .emotion-symbol{font-size:25px;letter-spacing:3px}.myko[data-mood=happy] .emotion-symbol{left:18%;top:15%;font-size:35px}.myko p{font:18px/1.2 'Caveat',cursive;color:#7f8971;margin:-2px 0 0;min-height:22px}.motion-toggle{font:9px var(--font-body);background:none;color:var(--muted);min-height:30px;padding:4px 9px}@media(prefers-reduced-motion:reduce){.myko-stage{animation:none!important;transition:none}.gaze{transition:none}}
</style>
<style>
.myko-floor{position:absolute;top:12px;left:-58px;width:440px;height:440px;max-width:none;pointer-events:none;z-index:0}.myko-stage{z-index:1}.myko p,.motion-toggle{position:relative;z-index:2}@media(max-width:650px){.myko-floor{left:-50px;width:380px;height:380px}}@media(max-height:580px){.myko-floor{left:-38px;width:290px;height:290px}}
</style>
<style>
.myko{position:fixed;right:0;bottom:max(0px,env(safe-area-inset-bottom));z-index:25;width:320px;pointer-events:none;overflow:clip;padding-top:12px}.myko-stage{width:440px;margin-left:-58px;pointer-events:auto;transform:none}.myko p{font-size:16px;margin-top:-8px}.motion-toggle{pointer-events:auto;min-height:30px}.emotion-symbol{left:30%;top:10%}@media(max-width:650px){.myko{width:276px}.myko-stage{width:380px;margin-left:-50px}.myko p{font-size:15px}}@media(max-height:580px){.myko{width:210px}.myko-stage{width:290px;margin-left:-38px}}@media(prefers-reduced-motion:reduce){.myko-stage{transform:none!important}}
</style>
