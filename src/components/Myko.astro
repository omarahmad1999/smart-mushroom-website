---
import { Image } from 'astro:assets';
import body from '../assets/about/myko-body.png';
import head from '../assets/about/myko-head.png';
import eyes from '../assets/about/myko-eyes.png';
---
<section class="myko" data-myko data-mood="neutral" aria-label="Myko, a little mushroom explorer">
  <p class="myko-note">Meet Myko.<span>A little companion for a growing experiment.</span></p>
  <button class="myko-stage" type="button" aria-label="Say hello to Myko" aria-describedby="myko-hint" data-myko-hello>
    <span class="myko-breathe"><Image class="myko-body" src={body} width={900} format="webp" quality={90} alt="" loading="eager" /><span class="myko-head-group"><Image class="myko-head" src={head} width={900} format="webp" quality={90} alt="" loading="eager" /><span class="myko-gaze"><span class="myko-blink"><Image class="myko-eyes" src={eyes} width={900} format="webp" quality={90} alt="" loading="eager" /><svg class="myko-expressions" viewBox="0 0 1254 1254" aria-hidden="true"><g class="happy-eyes" fill="none" stroke="#ffdc91" stroke-width="18" stroke-linecap="round"><path d="M523 458 Q548 414 573 458M722 458 Q747 414 772 458"/></g><g class="sleepy-eyes" fill="none" stroke="#ffdc91" stroke-width="13" stroke-linecap="round"><path d="M523 449 Q548 473 573 449M722 449 Q747 473 772 449"/></g></svg></span></span></span></span>
  </button>
  <p id="myko-hint" class="myko-hint" data-myko-hint>Move your cursor, or tap to say hello.</p>
  <div class="myko-controls" hidden><button type="button" data-myko-mood="happy" aria-label="Make Myko happy">Happy</button><button type="button" data-myko-mood="curious" aria-label="Make Myko curious">Curious</button><button type="button" data-myko-mood="sleepy" aria-label="Make Myko sleepy">Sleepy</button><button type="button" data-myko-motion aria-pressed="true">Motion on</button></div>
</section>
<style>
.myko{text-align:center;min-width:0;align-self:center}.myko-note{font:32px/1.2 'Caveat',cursive;color:#79866c;transform:rotate(-3deg)}.myko-note span{display:block;font-size:20px;color:#92947f;margin-top:5px}.myko-stage{position:relative;display:block;width:100%;aspect-ratio:1;background:transparent;padding:0;margin:10px 0 0;border:0;cursor:pointer;border-radius:30px}.myko-breathe,.myko-head-group,.myko-gaze,.myko-blink{position:absolute;inset:0;display:block}.myko-stage img{position:absolute;height:auto;pointer-events:none}.myko-body{inset:0;width:100%}.myko-head-group{transform-origin:51% 44%;transform:rotate(var(--tilt,0deg));transition:transform .35s ease-out}.myko-head{width:72%;left:13.55%;top:-.3%}.myko-gaze{transform:translate(var(--eye-x,0px),var(--eye-y,0px));transition:transform .2s ease-out}.myko-eyes{width:83.3%;left:8.15%;top:-.72%}.myko-expressions{position:absolute;inset:0;width:100%;height:100%;filter:drop-shadow(0 0 6px #ffb351)}.happy-eyes,.sleepy-eyes{display:none}.myko[data-mood=happy] .myko-eyes,.myko[data-mood=sleepy] .myko-eyes{visibility:hidden}.myko[data-mood=happy] .happy-eyes{display:block}.myko[data-mood=sleepy] .sleepy-eyes{display:block}.myko[data-mood=curious] .myko-head-group{transform:rotate(calc(var(--tilt,0deg) + 3deg))}.myko[data-mood=curious] .myko-blink{scale:1 1.07}.myko-blink{transform-origin:51.5% 36%;transition:scale .18s}.myko[data-blinking] .myko-blink{scale:1 .08}.myko-hint{font-size:11px;color:var(--muted);margin-top:10px}.myko-controls{display:flex;justify-content:center;gap:15px;flex-wrap:wrap;margin-top:8px}.myko-controls button{background:none;padding:6px 0;min-height:44px;font:19px 'Caveat',cursive;color:#89917a;border-bottom:1px solid transparent}.myko-controls button[aria-pressed=true]{color:#ac6d48;border-color:#c5a386}.myko-controls [data-myko-motion]{font:10px var(--font-body);color:var(--muted);margin-left:10px}.myko[data-animate] .myko-breathe{animation:myko-idle 4.8s ease-in-out infinite;transform-origin:50% 95%}@keyframes myko-idle{0%,100%{transform:translateY(0) rotate(-.3deg)}50%{transform:translateY(-3px) rotate(.3deg)}}@media(max-width:650px){.myko{width:min(420px,100%);margin:auto}.myko-note{font-size:28px}.myko-note span{font-size:18px}.myko-stage{margin-top:0}.myko-hint{margin-top:3px}}@media(prefers-reduced-motion:reduce){.myko-breathe{animation:none!important}.myko-head-group,.myko-gaze,.myko-blink{transition:none}}
</style>
