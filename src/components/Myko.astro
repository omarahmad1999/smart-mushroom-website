---
import { Image } from 'astro:assets';
import character from '../assets/about/myko-left-empty.png';
import mailMyko from '../assets/about/myko-with-mail.png';
// Dizzy eyes: a spiral centred on each eye, in the visor's own coordinates.
const spiral=(cx:number,cy:number,rx:number,ry:number)=>Array.from({length:61},(_,i)=>{const t=i/60,a=t*Math.PI*5;return `${i?'L':'M'}${(cx+Math.cos(a)*rx*t).toFixed(1)} ${(cy+Math.sin(a)*ry*t).toFixed(1)}`;}).join('');
---
<section class="myko" data-myko data-mood="neutral" data-tracking="true" aria-label="Myko, a little mushroom explorer">
  <p id="myko-hint" data-myko-hint>Myko · say hello</p>
  <span class="sr-only" aria-live="polite" data-myko-say></span>
  <button class="myko-contact" type="button" data-myko-contact aria-haspopup="dialog" aria-controls="myko-contact-dialog">Contact me</button>
  <svg class="myko-floor" viewBox="0 0 1254 1254" aria-hidden="true">
    <defs>
      <radialGradient id="myko-moss"><stop stop-color="#b6bc78"/><stop offset=".65" stop-color="#8d9d60"/><stop offset="1" stop-color="#667d4b"/></radialGradient>
    </defs>
    <ellipse cx="668" cy="1218" rx="386" ry="29" fill="#635c3b" opacity=".13"/>
    <path d="M279 1204Q265 1187 318 1182Q330 1166 396 1170Q470 1142 551 1152Q638 1135 706 1150Q783 1134 852 1156Q933 1149 973 1175Q1055 1177 1058 1199L1033 1216Q973 1231 925 1227Q850 1251 783 1238Q693 1255 623 1240Q536 1252 476 1234Q390 1240 350 1225Q292 1227 279 1204Z" fill="#766b46"/>
    <path d="M279 1198Q265 1181 318 1176Q330 1160 396 1164Q470 1136 551 1146Q638 1129 706 1144Q783 1128 852 1150Q933 1143 973 1169Q1055 1171 1058 1193Q1044 1207 1010 1208Q971 1227 925 1221Q850 1245 783 1232Q693 1249 623 1234Q536 1246 476 1228Q390 1234 350 1219Q292 1221 279 1198Z" fill="url(#myko-moss)" stroke="#74844f" stroke-width="2"/>
    <g fill="#c3c88a" opacity=".45"><ellipse cx="361" cy="1198" rx="46" ry="7"/><ellipse cx="586" cy="1216" rx="62" ry="9"/><ellipse cx="938" cy="1203" rx="59" ry="8"/></g>
    <ellipse cx="471" cy="1175" rx="98" ry="13" fill="#36482b" opacity=".24"/>
    <ellipse cx="805" cy="1214" rx="119" ry="14" fill="#36482b" opacity=".24"/>
    {[[300,1195,1],[350,1181,.8],[376,1213,.8],[446,1220,.7],[524,1204,.8],[585,1230,.9],[654,1225,.7],[709,1240,.8],[927,1220,1],[985,1200,.9],[1030,1190,.8],[920,1165,.8],[625,1152,.7]].map(([x,y,scale]) => (
      <g transform={`translate(${x} ${y}) scale(${scale})`}>
        <path d="M0 0Q-15-10-18-26Q-5-18 1-6Q0-27 7-36Q11-19 6-5Q17-20 26-20Q17-7 8 1Z" fill="#526d3c"/>
        <path d="M2 0Q-5-14-7-23M5 0Q9-15 16-20" fill="none" stroke="#b9c180" stroke-width="2" stroke-linecap="round"/>
      </g>
    ))}
  </svg>
  <button class="myko-stage" type="button" aria-label="Say hello to Myko" aria-describedby="myko-hint" data-myko-hello>
    <Image src={character} width={650} format="webp" quality={90} alt="Myko, a cream robot covered in mushrooms, facing left" loading="eager" />
    <svg class="myko-face" viewBox="0 0 1254 1254" aria-hidden="true">
      <defs><clipPath id="myko-visor"><path d="M478 307C415 304 374 365 370 425C363 482 389 536 431 553C497 570 591 538 623 493C650 446 616 357 568 328C537 309 506 305 478 307Z"/></clipPath></defs>
      <g clip-path="url(#myko-visor)"><g class="gaze"><g transform="translate(96 -18) scale(.8 1)"><g class="eyes neutral"><ellipse cx="403" cy="480" rx="16" ry="40" transform="rotate(-12 403 480)"/><ellipse cx="554" cy="455" rx="28" ry="44" transform="rotate(-12 554 455)"/></g>
      <g class="eyes curious"><ellipse cx="403" cy="480" rx="17" ry="36" transform="rotate(-16 403 480)"/><ellipse cx="554" cy="455" rx="30" ry="48" transform="rotate(-12 554 455)"/></g>
      <g class="eyes happy" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round"><path d="M388 479Q400 449 418 474M528 456Q549 415 579 446"/></g>
      <g class="eyes melancholic"><path d="M387 474L419 468Q423 507 404 505Q391 503 387 474M525 452L581 440Q585 480 559 481Q536 487 525 452"/></g>
      <g class="eyes sleepy" fill="none" stroke="currentColor" stroke-width="11" stroke-linecap="round"><path d="M388 482Q405 501 420 475M531 461Q561 484 579 450"/></g>
      <g class="eyes surprised"><ellipse cx="403" cy="480" rx="20" ry="45" transform="rotate(-12 403 480)"/><ellipse cx="554" cy="455" rx="33" ry="52" transform="rotate(-12 554 455)"/></g>
      <g class="eyes peek"><path d="M388 482Q405 501 420 475" fill="none" stroke="currentColor" stroke-width="11" stroke-linecap="round"/><ellipse cx="554" cy="455" rx="28" ry="44" transform="rotate(-12 554 455)"/></g>
      <g class="eyes squint" fill="none" stroke="currentColor" stroke-width="13" stroke-linecap="round" stroke-linejoin="round"><path d="M384 456L420 481L384 506M574 430L536 456L574 482"/></g>
      <g class="eyes dizzy" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"><path d={spiral(403,480,24,38)} style="transform-origin:403px 480px"/><path d={spiral(554,455,34,44)} style="transform-origin:554px 455px"/></g></g></g></g>
    </svg>
    <span class="emotion-symbol" aria-hidden="true" data-emotion-symbol></span>
    <span class="myko-spores" aria-hidden="true" data-myko-spores></span>
    <span class="myko-dream" aria-hidden="true" data-myko-dream>
      <svg viewBox="0 0 120 96">
        <circle class="dream-dot" cx="104" cy="90" r="3.5"/><circle class="dream-dot" cx="94" cy="77" r="5.5"/>
        <path class="cloud" d="M22 64C8 64 3 50 13 43C5 31 17 16 32 22C36 8 58 3 67 15C77 5 97 11 95 27C107 32 106 52 93 56C93 67 77 72 67 65C58 73 38 73 32 65C28 67 24 66 22 64Z"/>
        <g class="doodle mushroom"><path d="M34 45Q35 25 54 24Q73 25 74 45Z"/><path d="M48 45Q47 52 45 57H63Q61 52 60 45M38 58H70"/><circle cx="47" cy="33" r="2.4"/><circle cx="60" cy="30" r="1.8"/><circle cx="66" cy="38" r="1.8"/></g>
        <g class="doodle pi"><rect x="29" y="26" width="46" height="30" rx="3"/><path d="M33 30.5H70" stroke-dasharray="1.6 2.6"/><rect x="43" y="36" width="12" height="12" rx="1"/><path d="M75 36H81V44H75M75 47H81V53H75"/><circle cx="33" cy="52" r="1"/><circle cx="70" cy="52" r="1"/></g>
        <g class="doodle peacock"><path d="M58 52L28.5 57A30 30 0 0 1 60.6 22ZM58 52L34 52M58 52L36 42M58 52L43 34M58 52L52 29"/><circle cx="34" cy="52" r="2.8"/><circle cx="36.2" cy="41.9" r="2.8"/><circle cx="42.6" cy="33.6" r="2.8"/><circle cx="51.8" cy="28.8" r="2.8"/><path class="solid" d="M54 55Q55 45 63 44Q70 46 68 54Q64 60 56 59Z"/><path d="M65 45Q63 36 70 31M59 59L58 64M63 59L64 64M74 30L77 31M71 27L70 22M73 27L75 23M69 28L66 24"/><circle class="solid" cx="71.5" cy="30" r="2.6"/></g>
      </svg>
    </span>
  </button>
</section>
<dialog class="contact-dialog" id="myko-contact-dialog" data-contact-dialog aria-labelledby="contact-dialog-title">
  <button class="contact-close" type="button" data-contact-close aria-label="Close contact form">×</button>
  <div class="contact-heading"><span aria-hidden="true">✦</span><div><p>WRITE A LITTLE NOTE</p><h2 id="contact-dialog-title">Say hello to Omar.</h2></div></div>
  <form class="contact-form" data-contact-form>
    <div class="contact-field-row"><label>Your name<input name="name" autocomplete="name" maxlength="80" required /></label><label>Your email<input name="email" type="email" autocomplete="email" maxlength="254" required /></label></div>
    <label>Subject<input name="subject" maxlength="150" required value="Hello from Smart Mushroom Hub" /></label>
    <label>Your message<textarea name="message" rows="5" maxlength="5000" required></textarea></label>
    <label class="contact-trap" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
    <p class="contact-privacy">Your details are used only to deliver and reply to this message.</p>
    <div class="contact-lower">
      <div class="contact-actions">
        <p class="contact-status" data-contact-status aria-live="polite">Myko is ready when you are.</p>
        <button class="contact-submit" type="submit"><span data-contact-submit-label>Send message</span> <span aria-hidden="true">↗</span></button>
      </div>
      <Image class="contact-myko-mail" src={mailMyko} width={190} format="webp" quality={90} alt="Myko holding a letter for Omar" loading="lazy" />
    </div>
  </form>
</dialog>
<style>
.myko{text-align:center;min-width:0}.myko-stage{display:block;position:relative;width:100%;aspect-ratio:1;padding:0;border:0;background:none;cursor:pointer;transform-origin:50% 90%;transition:transform .3s;border-radius:20px}.myko-stage img{width:100%;height:auto;pointer-events:none}.myko-face{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;color:#ffdb92}.gaze{transform:translate(var(--eye-x,0px),var(--eye-y,0px));transition:transform .18s ease-out}.eyes{display:none;fill:currentColor;filter:drop-shadow(0 0 11px #ffb54b);transform-origin:480px 468px}.eyes.happy,.eyes.sleepy,.eyes.dizzy,.eyes.squint{fill:none}.myko[data-mood=neutral] .neutral,.myko[data-mood=happy] .happy,.myko[data-mood=curious] .curious,.myko[data-mood=melancholic] .melancholic,.myko[data-mood=sleepy] .sleepy,.myko[data-mood=surprised] .surprised,.myko[data-mood=dizzy] .dizzy,.myko[data-mood=squint] .squint,.myko[data-mood=peek] .peek{display:block}.myko-spores{position:absolute;inset:0;pointer-events:none;z-index:2}.myko-dream{position:absolute;left:14%;top:-24%;width:30%;pointer-events:none;opacity:0;z-index:2}.myko-dream[data-dream]{opacity:1}.myko-dream svg{display:block;width:100%;height:auto;overflow:visible}.myko-dream .cloud,.myko-dream .dream-dot{fill:#fffdf7;stroke:#cfc4a6;stroke-width:1.5}.doodle{display:none;fill:none;stroke:#7b6f55;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}.doodle .solid{fill:#fffdf7}.myko-dream[data-dream=mushroom] .mushroom,.myko-dream[data-dream=pi] .pi,.myko-dream[data-dream=peacock] .peacock{display:inline}.myko-spores :global(i){position:absolute;border-radius:50%;background:radial-gradient(circle,#f2ffff 0 25%,#8fe0e9 55%,#46aebd);box-shadow:0 0 6px 1px #59ddeb8c;opacity:0}.myko[data-mood=dizzy] .dizzy path{animation:myko-spin 1.1s linear infinite}@keyframes myko-spin{to{transform:rotate(-360deg)}}.surprised{color:#b4f7ff;filter:drop-shadow(0 0 15px #59ddeb)}.myko[data-blinking] .neutral{transform:scaleY(.1)}.emotion-symbol{position:absolute;left:14%;top:8%;font:37px/1 'Caveat',cursive;transform:rotate(-14deg);color:#8e8368;text-shadow:0 1px 2px var(--paper);pointer-events:none}.myko[data-mood=surprised] .emotion-symbol{color:#429ca8}.myko[data-mood=sleepy] .emotion-symbol{font-size:25px;letter-spacing:3px}.myko[data-mood=happy] .emotion-symbol{left:18%;top:15%;font-size:35px}.myko p{font:16px/1.05 'Caveat',cursive;color:#7f8971;margin:0;text-shadow:0 0 2px var(--paper),0 0 5px var(--paper),0 0 9px var(--paper)}@media(prefers-reduced-motion:reduce){.myko-stage,.dizzy path{animation:none!important;transition:none}.gaze{transition:none}}
</style>
<style>
.myko-floor{position:absolute;top:35px;left:-44px;width:330px;height:330px;max-width:none;pointer-events:none;z-index:0}.myko-stage{z-index:1}.myko p{z-index:2}@media(max-width:650px){.myko-floor{top:35px;left:-37.5px;width:285px;height:285px}}@media(max-height:580px){.myko-floor{top:30px;left:-28.5px;width:217.5px;height:217.5px}}
</style>
<style>
.myko{position:fixed;right:0;bottom:max(0px,env(safe-area-inset-bottom));z-index:25;width:240px;height:365px;pointer-events:none;overflow:visible}.myko-stage{position:absolute;top:35px;left:-44px;width:330px;pointer-events:auto;transform:none}.myko p{position:absolute;bottom:calc(100% - 31px);right:9px;width:172px;text-align:right;transform:rotate(-3deg);min-height:24px}.myko-contact{position:absolute;z-index:4;left:-29px;top:50px;display:grid;place-items:center;width:82px;min-height:45px;padding:8px 9px;background:#213a35;border:2px solid #f5d6ad;border-radius:50%;box-shadow:0 6px 16px #172b2940;color:#fffaf0;font:17px/1 'Caveat',cursive;text-shadow:0 1px #0005;transform:rotate(-5deg);pointer-events:auto;transition:transform .2s,background .2s,border-color .2s}.myko-contact:after{content:'';position:absolute;right:-9px;bottom:2px;width:18px;height:15px;background:#213a35;border-right:2px solid #f5d6ad;transform:skew(-30deg) rotate(17deg);z-index:-1}.myko-contact:hover{background:#b95532;border-color:#fff0d9;transform:translateY(-2px) rotate(-2deg)}.myko-contact:hover:after{background:#b95532;border-color:#fff0d9}.emotion-symbol{left:30%;top:10%}@media(max-width:650px){.myko{width:207px;height:320px}.myko-stage{top:35px;left:-37.5px;width:285px}.myko p{bottom:calc(100% - 32px);right:7px;width:146px;font-size:15px}.myko-contact{left:-18px;top:30px;width:70px;min-height:41px;font-size:15px}}@media(max-height:580px){.myko{width:157.5px;height:247.5px}.myko-stage{top:30px;left:-28.5px;width:217.5px}.myko p{bottom:calc(100% - 28px);right:4px;width:100px;font-size:13px}.myko-contact{left:-5px;top:4px;width:57px;min-height:35px;padding:6px;font-size:12px}}@media(prefers-reduced-motion:reduce){.myko-stage{transform:none!important}.myko-contact{transition:none}}
</style>
<style>
.contact-dialog{width:min(650px,calc(100% - 30px));max-height:none;padding:37px;border:1px solid #bcc5ad;border-radius:10px;background:#f8f5eb;color:#172b29;box-shadow:0 24px 90px #10231f59;overflow:hidden}.contact-dialog::backdrop{background:#10231fa8;backdrop-filter:blur(5px)}.contact-close{position:absolute;right:14px;top:12px;display:grid;place-items:center;width:38px;height:38px;border:1px solid #cad0c0;border-radius:50%;background:transparent;color:#52624b;font-size:23px}.contact-heading{display:flex;align-items:start;gap:15px;padding-right:35px;margin-bottom:28px}.contact-heading>span{color:#bd5837;font-size:24px}.contact-heading p{font-size:8px;letter-spacing:.15em;color:#738060;margin:0 0 8px}.contact-heading h2{font:36px/1.05 var(--font-display);letter-spacing:-.025em}.contact-form{display:grid;gap:16px}.contact-field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.contact-form label{display:grid;gap:7px;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:#66705f}.contact-form input,.contact-form textarea{width:100%;border:1px solid #ccd2c3;border-radius:4px;background:#fffdf7;color:#172b29;padding:12px 13px;font:13px/1.55 var(--font-body);text-transform:none;letter-spacing:0;outline:0}.contact-form textarea{resize:vertical;min-height:120px}.contact-form input:focus,.contact-form textarea:focus{border-color:#9caa87;box-shadow:0 0 0 3px #cdd6bf66}.contact-trap{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}.contact-privacy{font-size:10px;line-height:1.6;color:#747b70}.contact-lower{display:grid;grid-template-columns:minmax(0,1fr) 170px;align-items:end;gap:2px;margin:-8px -60px -30px 0}.contact-actions{display:grid;align-self:stretch;align-content:space-between;justify-items:start;gap:18px;padding:20px 0 38px}.contact-status{position:relative;display:grid;place-items:center;justify-self:end;width:min(270px,100%);height:64px;margin-right:-8px;padding:10px 14px;border:1px solid #d1c7ae;border-radius:48% 52% 47% 53%;background:#fffdf7;box-shadow:0 4px 13px #5a4c3320;font:18px/1.18 'Caveat',cursive;color:#a05437;text-align:center;transform:rotate(-2deg)}.contact-status:after{content:'';position:absolute;right:-7px;bottom:11px;width:14px;height:14px;background:#fffdf7;border-top:1px solid #d1c7ae;border-right:1px solid #d1c7ae;transform:rotate(45deg)}.contact-status[data-state=success]{color:#526f45}.contact-status[data-state=error]{color:#a53f2b}.contact-myko-mail{display:block;align-self:end;width:170px;height:auto;margin:0 -24px -8px 0;filter:drop-shadow(0 9px 10px #3e3a2e26)}.contact-submit{display:inline-flex;align-items:center;justify-content:center;gap:18px;width:max-content;min-height:45px;padding:11px 14px;border-radius:4px;background:#213a35;color:#fffaf0;font-size:11px}.contact-submit:disabled{cursor:wait;opacity:.65}.contact-submit:not(:disabled):hover{background:#b95532}@media(max-width:520px){.contact-dialog{padding:31px 21px 24px}.contact-field-row{grid-template-columns:1fr}.contact-heading h2{font-size:31px}.contact-lower{grid-template-columns:minmax(0,1fr) 120px;gap:0;margin:-5px -37px -23px 0}.contact-actions{padding:15px 0 31px}.contact-status{width:min(205px,100%);height:60px;margin-right:-4px;padding:9px 11px;font-size:16px}.contact-myko-mail{width:120px;margin:0 -18px -6px 0}.contact-submit{gap:14px;padding:10px 12px}}@media(max-height:760px),(max-width:700px){.contact-dialog{max-height:calc(100dvh - 30px);overflow-x:hidden;overflow-y:auto}}
</style>
<script>
  const initializeContactDialog=()=>{
    const dialog=document.querySelector<HTMLDialogElement>('[data-contact-dialog]');
    if(!dialog||dialog.dataset.initialized==='true')return;
    dialog.dataset.initialized='true';
    const opener=document.querySelector<HTMLButtonElement>('[data-myko-contact]');
    const close=dialog.querySelector<HTMLButtonElement>('[data-contact-close]');
    const form=dialog.querySelector<HTMLFormElement>('[data-contact-form]');
    opener?.addEventListener('click',()=>dialog.showModal());
    close?.addEventListener('click',()=>dialog.close());
    dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
    form?.addEventListener('submit',async event=>{
      event.preventDefault();
      const submit=form.querySelector<HTMLButtonElement>('[type="submit"]');
      const submitLabel=form.querySelector<HTMLElement>('[data-contact-submit-label]');
      const status=form.querySelector<HTMLElement>('[data-contact-status]');
      if(!submit||!submitLabel||!status)return;
      const data=new FormData(form);
      const payload=Object.fromEntries(['name','email','subject','message','website'].map(key=>[key,String(data.get(key)||'')]));
      submit.disabled=true;submitLabel.textContent='Sending…';status.textContent='Myko is carrying your message…';status.dataset.state='sending';
      try{
        const response=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(payload)});
        const result=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(typeof result?.message==='string'?result.message:'Your note could not be sent. Please try again.');
        form.reset();status.textContent='Myko will make sure your message reaches Omar';status.dataset.state='success';submit.disabled=false;submitLabel.textContent='Send another note';
      }catch(error){
        status.textContent=error instanceof Error?error.message:'Your note could not be sent. Please try again.';status.dataset.state='error';submit.disabled=false;submitLabel.textContent='Try again';
      }
    });
  };
  initializeContactDialog();document.addEventListener('astro:page-load',initializeContactDialog);
</script>
