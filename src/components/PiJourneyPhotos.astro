---
interface Props { interactive?: boolean; className?: string }
const {interactive=false,className=''}=Astro.props;
const photos=[
  {src:'/media/notebook/journey/raspberry-pi/01-initial-hardware-setup.webp',width:1400,height:1050,title:'Initial hardware setup',date:'17 May 2026',iso:'2026-05-17',alt:'Initial Raspberry Pi setup connected to a display, keyboard, mouse, and SSD'},
  {src:'/media/notebook/journey/raspberry-pi/02-pi-case-cropped.webp',width:849,height:1508,title:'KSSB-style case',date:'22 June 2026',iso:'2026-06-22',alt:'Black KSSB-style Raspberry Pi case held in one hand'},
  {src:'/media/notebook/journey/raspberry-pi/03-pi-breadboard-and-camera.webp',width:1050,height:1400,title:'Pi, breadboard & camera',date:'28 June 2026',iso:'2026-06-28',alt:'Raspberry Pi case wired to a breadboard and camera hardware'},
];
---
<div class:list={['pi-photo-collection',className]}>
  {photos.map(photo=><div class="pi-photo-card">
    <figure>
      {interactive ? <a href={photo.src} data-nb-image data-caption={`${photo.title} · ${photo.date}`} aria-label={`Enlarge photograph: ${photo.title}`}><img src={photo.src} alt={photo.alt} loading="lazy" width={photo.width} height={photo.height} /></a> : <img src={photo.src} alt={photo.alt} loading="lazy" width={photo.width} height={photo.height} />}
      <figcaption>{photo.title}</figcaption>
    </figure>
    <p class="pi-photo-date"><time datetime={photo.iso}>{photo.date}</time></p>
  </div>)}
</div>
<style>
.pi-photo-collection{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 18px;align-items:start}.pi-photo-card{min-width:0;transform:rotate(-1.8deg);transform-origin:center top}.pi-photo-card:first-child{grid-column:1/-1;width:78%;justify-self:center}.pi-photo-card:nth-child(2){transform:rotate(1.7deg)}.pi-photo-card:nth-child(3){transform:rotate(-1deg)}figure{position:relative;margin:0;padding:7px 7px 8px;background:#fffdf7;box-shadow:2px 6px 12px #49381e2b}figure:before{content:'';position:absolute;z-index:1;top:-8px;left:30%;width:40%;height:16px;background:#d3be8b73;transform:rotate(3deg);pointer-events:none}a{display:block;cursor:zoom-in}img{display:block;width:100%;height:145px;object-fit:cover}.pi-photo-card:first-child img{height:165px}.pi-photo-card:nth-child(2) img{object-position:center 38%}figcaption{font-family:var(--hand);font-size:19px;line-height:1.05;text-align:center;margin-top:7px}.pi-photo-date{position:relative;width:max-content;max-width:92%;margin:5px auto 0;padding:3px 10px 4px;background:#fff0ba;box-shadow:1px 2px 3px #49381e20;font-family:var(--font-body);font-size:8px;line-height:1.2;letter-spacing:.55px;text-transform:uppercase;color:#765640;transform:rotate(.8deg)}.pi-photo-card:nth-child(2) .pi-photo-date{background:#e9d6cb;transform:rotate(-1.2deg)}.pi-photo-card:nth-child(3) .pi-photo-date{background:#d8e3d4;transform:rotate(1deg)}
:global(.nb-pi-photos-dialog) .pi-photo-collection{gap:18px;max-width:660px;margin:auto}:global(.nb-pi-photos-dialog) img{height:min(25dvh,210px)}:global(.nb-pi-photos-dialog) .pi-photo-card:first-child img{height:min(27dvh,230px)}
@media(min-width:761px) and (max-width:1000px){.pi-photo-collection{gap:12px}.pi-photo-card:first-child{width:86%}img{height:125px}.pi-photo-card:first-child img{height:145px}figcaption{font-size:17px}.pi-photo-date{font-size:7px}}
@media(max-width:760px){.pi-photo-collection{gap:14px 10px}.pi-photo-card:first-child{width:90%}figure{padding:5px}img{height:min(22dvh,155px)}.pi-photo-card:first-child img{height:min(23dvh,170px)}figcaption{font-size:17px}.pi-photo-date{font-size:7px}}
</style>
