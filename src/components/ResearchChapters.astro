---
import ResourceLink from './ResourceLink.astro';
import { site } from '../config/site';

const photographs = [
  { date: '2026-08-19', label: '19 August 2026', shortLabel: '19 AUG 2026', image: '/media/photo-incubation-2026-08-19.webp' },
  { date: '2026-08-27', label: '27 August 2026', shortLabel: '27 AUG 2026', image: '/media/photo-incubation-2026-08-27.webp' },
  { date: '2026-09-04', label: '4 September 2026', shortLabel: '04 SEP 2026', image: '/media/photo-incubation-2026-09-04.webp' },
];

const [first, last] = [photographs[0], photographs[photographs.length - 1]];
const captureDetails = [
  ['CAMERA', 'Raspberry Pi Camera Module 3 Wide'],
  ['WHICH CAMERA', 'The controlled tent camera'],
  ['INTERVAL', 'A still every six hours during incubation; schedules change by phase'],
  ['RESOLUTION', 'Captured at full resolution; published here at 1600 × 900'],
];

// What the experiment measures, what it adjusts, and what it keeps.
const ledger = [
  { label: 'MEASURED', what: 'Temperature, humidity and CO₂', detail: 'In the tent and in the room around it.' },
  { label: 'CONTROLLED', what: 'Fan, humidifier and LEDs', detail: 'Adjusted to the cultivation phase.' },
  { label: 'RECORDED', what: 'Photographs and timelapses', detail: 'A still every six hours during incubation.' },
];
// Parts that can be picked out on the workbench photograph, with where they sit on it (percent of the shown crop).
const workbench = [
  { id: 'pi', name: 'Raspberry Pi 5', x: 67.9, y: 40 },
  { id: 'cobbler', name: 'Breadboard & T-cobbler', x: 65.8, y: 62.3 },
  { id: 'wago-red', name: 'Wago junctions', x: 40, y: 71.4 },
  { id: 'ups', name: 'APC UPS', x: 50, y: 30.9 },
];
const facts = [
  ['THE SPECIES', 'Oyster mushrooms'],
  ['THE SUBSTRATE', 'Pasteurized straw'],
  ['THE FIRST RUN', 'Incubation began 28 July 2026'],
  ['THE TENT', '185 × 82 × 55 cm'],
  ['THE SENSORS', 'Two SHT31 and two SCD41: one of each in the tent and in the room'],
  ['THE CAMERAS', 'Two Raspberry Pi Camera Module 3 Wide'],
];

const phases = [
  {
    id: 'incubation',
    number: '01',
    name: 'Incubation',
    title: 'Much of the work happens out of sight.',
    description: 'Mycelium spreads through the straw inside each bag. What is visible on the surface is only part of the story, so a quiet-looking bag does not tell us everything about colonization.',
    focus: 'Observe patiently. Follow the developing mycelium and the surrounding conditions.',
    image: '/media/cultivation/stage-incubation.webp',
    alt: 'Rendered illustration of a hanging bag of chopped straw in clear plastic, with white mycelium beginning to spread through it.',
  },
  {
    id: 'pinning',
    number: '02',
    name: 'Pinning',
    title: 'The first small signs become visible.',
    description: 'Tiny mushroom initials mark a visible transition. This is a useful moment to look closely at the relationship between the growing environment and what the cameras can actually observe.',
    focus: 'Look for the transition. Environmental settings and observation schedules can change by phase.',
    image: '/media/cultivation/stage-pinning.webp',
    alt: 'Rendered illustration of the same bag, now white with mycelium, with clusters of tiny grey-tipped mushroom pins at three cuts in the plastic.',
  },
  {
    id: 'fruiting',
    number: '03',
    name: 'Fruiting & growth',
    title: 'Slow changes start to take shape.',
    description: 'Oyster mushrooms develop into their recognizable clusters. Scheduled photographs can make gradual changes easier to see, while environmental measurements provide a separate record in Grafana.',
    focus: 'Observe shape and development. A visual impression alone is not a measurement of yield.',
    image: '/media/cultivation/stage-fruiting.webp',
    alt: 'Rendered illustration of the bag with grey-brown oyster mushroom clusters growing from its three openings.',
  },
  {
    id: 'harvest',
    number: '04',
    name: 'Harvest',
    title: 'An endpoint, and a new set of questions.',
    description: 'Harvest offers a moment to document the outcome and review the run. Any conclusions need to account for the actual observations, the conditions, and the gaps in the record.',
    focus: 'Reflect on the evidence. This conceptual stage does not indicate that a harvest has been completed.',
    image: '/media/cultivation/stage-harvest.webp',
    alt: 'Rendered illustration of the bag with cut stems at its openings and the harvested oyster clusters in a dish below; not evidence of an actual harvest.',
  },
];


---

<div class="research-chapters" data-research-chapters>
  <section id="experiment" class="rc-section rc-experiment" aria-labelledby="experiment-heading">
    <div class="rc-container">
      <div class="rc-section-label"><span class="rc-marker"></span> THE EXPERIMENT <span class="rc-label-rule"></span> FIELD NOTES / 01</div>
      <div class="rc-experiment-grid">
        <div class="rc-experiment-copy">
          <h2 id="experiment-heading">A small environment.<br /><em>A bigger question.</em></h2>
          <p class="rc-lead">What can we learn when we make the growing environment observable?</p>
          <p>Smart Mushroom Hub brings oyster mushroom cultivation, environmental sensing, and a little automation into one carefully observed space. A Raspberry Pi connects the physical experiment to its digital record.</p>
          <dl class="rc-ledger">
            {ledger.map(entry => (
              <div><dt><span class="rc-ledger-mark" aria-hidden="true"></span>{entry.label}</dt><dd><strong>{entry.what}</strong><span>{entry.detail}</span></dd></div>
            ))}
          </dl>
          <ResourceLink href={site.grafanaUrl} resource="Grafana" class="rc-grafana-link" label="See the measurements in Grafana" />
        </div>
        <figure class="rc-hardware-figure">
          <div class="rc-photo-wrap">
            <img src="/media/hardware-setup.webp" alt="The project's workbench from above: the APC UPS, the Raspberry Pi 5 in its case, the breadboard with its T-cobbler and ribbon cable, and the Wago junctions joining the sensor wires." loading="lazy" width="1200" height="1600" />
            {/* Numbered markers on the photograph; the list beneath carries the same links for keyboards and screen readers. */}
            {workbench.map((part, index) => (
              <a class="rc-photo-marker" href={`#study-${part.id}`} style={`left:${part.x}%;top:${part.y}%`} tabindex="-1" aria-hidden="true">
                <span>{index + 1}</span><span class="rc-marker-label">{part.name}</span>
              </a>
            ))}
          </div>
          <ol class="rc-photo-key" aria-label="Parts on the workbench, each shown in the interactive habitat">
            {workbench.map((part, index) => (
              <li><a href={`#study-${part.id}`}><span class="rc-key-number">{index + 1}</span><span>{part.name}</span><span class="rc-key-arrow" aria-hidden="true">↗</span></a></li>
            ))}
          </ol>
          <figcaption><span>01 / FROM THE WORKBENCH</span><span>Real hardware. Select a part to find it in the habitat.</span></figcaption>
        </figure>
      </div>
      <div class="rc-experiment-band">
        <figure class="rc-comparison">
          <svg viewBox="0 0 340 214" role="img" aria-labelledby="rc-comparison-title rc-comparison-text">
            <title id="rc-comparison-title">The tent and the room around it</title>
            <desc id="rc-comparison-text">The growing tent stands inside the room. One pair of sensors measures the air in the tent and a matching pair measures the room, so the two can be compared. The fan, humidifier and LEDs act on the tent only.</desc>
            <rect class="rc-room" x="6" y="8" width="328" height="198" rx="6" />
            <text class="rc-sketch-label" x="20" y="28">THE ROOM · REFERENCE</text>
            <rect class="rc-tent" x="28" y="44" width="150" height="148" rx="5" />
            <text class="rc-sketch-label" x="40" y="62">THE TENT · GROWING SPACE</text>
            <path class="rc-bag" d="M58 76v8M52 84h12a6 6 0 0 1 6 6v46a8 8 0 0 1-8 8h-8a8 8 0 0 1-8-8V90a6 6 0 0 1 6-6Z" />
            <path class="rc-bag" d="M94 76v8M88 84h12a6 6 0 0 1 6 6v46a8 8 0 0 1-8 8h-8a8 8 0 0 1-8-8V90a6 6 0 0 1 6-6Z" />
            <circle class="rc-sensor" cx="154" cy="96" r="4.5" /><circle class="rc-sensor rc-sensor-two" cx="154" cy="110" r="4.5" />
            <text class="rc-sketch-note" x="170" y="128" text-anchor="end">SHT31 · SCD41</text>
            <text class="rc-sketch-act" x="40" y="178">fan · humidifier · LEDs act here</text>
            <circle class="rc-sensor" cx="270" cy="104" r="4.5" /><circle class="rc-sensor rc-sensor-two" cx="270" cy="118" r="4.5" />
            <text class="rc-sketch-note" x="270" y="138" text-anchor="middle">SHT31 · SCD41</text>
            <path class="rc-sketch-link" d="M163 103C200 86 230 88 261 104" />
            <path class="rc-sketch-head" d="M255 98l7 6-9 3" />
            <text class="rc-sketch-act" x="212" y="82" text-anchor="middle">compared</text>
          </svg>
          <figcaption><p class="rc-kicker">THE COMPARISON</p><p>The tent is read against the room around it: the same pair of sensors sits in each, so a change inside can be told apart from a change in the room. Only the tent is ventilated, humidified and lit.</p></figcaption>
        </figure>
        <div class="rc-facts-block">
          <p class="rc-kicker">AT A GLANCE</p>
          <dl class="rc-experiment-facts">
            {facts.map(([name, value]) => <div><dt>{name}</dt><dd>{value}</dd></div>)}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section id="cultivation" class="rc-section rc-cultivation" aria-labelledby="cultivation-heading">
    <div class="rc-container">
      <div class="rc-section-label"><span class="rc-marker"></span> THE CULTIVATION CYCLE <span class="rc-label-rule"></span> EXPLORE THE PHASES</div>
      <div class="rc-section-intro">
        <h2 id="cultivation-heading">Growth has<br /><em>its own rhythm.</em></h2>
        <p>The needs of a living system change as it develops. These are conceptual stages of cultivation, with different reasons to observe, illuminate, humidify, or ventilate.</p>
      </div>
      <div class="rc-phase-explorer" data-phase-explorer>
        <div class="rc-phase-tabs" role="tablist" aria-label="Conceptual cultivation stages" hidden>
          {phases.map((phase, index) => (
            <button type="button" class="rc-phase-tab" id={`rc-tab-${phase.id}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`rc-panel-${phase.id}`} tabindex={index === 0 ? 0 : -1} data-phase-tab>
              <span class="rc-tab-number">{phase.number}</span><span>{phase.name}</span><span class="rc-tab-arrow" aria-hidden="true">↗</span>
            </button>
          ))}
        </div>
        {phases.map((phase) => (
          <div class="rc-phase-panel" id={`rc-panel-${phase.id}`} role="region" aria-labelledby={`rc-stage-title-${phase.id}`} data-phase-panel>
            <div class="rc-phase-content">
              <p class="rc-kicker">STAGE {phase.number} / {phase.name.toUpperCase()}</p>
              <h3 id={`rc-stage-title-${phase.id}`}>{phase.title}</h3>
              <p>{phase.description}</p>
              <p class="rc-phase-focus"><span aria-hidden="true">↳</span>{phase.focus}</p>
            </div>
            <figure class="rc-phase-art">
              <span class="rc-art-ring rc-art-ring-one" aria-hidden="true"></span><span class="rc-art-ring rc-art-ring-two" aria-hidden="true"></span>
              <img src={phase.image} alt={phase.alt} width="780" height="1080" loading="lazy" decoding="async" />
              <figcaption>RENDERED ILLUSTRATION · CONCEPTUAL, NOT AN OBSERVED RESULT</figcaption>
            </figure>
          </div>
        ))}
        <p class="rc-phase-note">Explore the stages in any order. This is a guide to the growing process, not a current phase indicator.</p>
      </div>
    </div>
  </section>



  <section id="observations" class="rc-section rc-observations" aria-labelledby="observations-heading">
    <div class="rc-container">
      <div class="rc-section-label"><span class="rc-marker"></span> CAMERA & TIMELAPSE <span class="rc-label-rule"></span> A DIFFERENT TIMESCALE</div>
      <div class="rc-observation-grid">
        <div class="rc-photo-viewer" data-photo-viewer>
          {/* The first and last published stills, one over the other: drag the line to see what changed. */}
          <figure class="rc-compare" data-compare style="--split:50%">
            <div class="rc-compare-frame">
              <img class="rc-compare-after" src={last.image} alt={`Real camera photograph from ${last.label}: straw-filled substrate bags hanging from the PVC frame inside the controlled tent.`} width="1600" height="900" loading="lazy" decoding="async" />
              <div class="rc-compare-before"><img src={first.image} alt={`Real camera photograph from ${first.label}: the same view, earlier in incubation.`} width="1600" height="900" loading="lazy" decoding="async" /></div>
              <span class="rc-compare-line" aria-hidden="true"><span class="rc-compare-grip"><span>‹</span><span>›</span></span></span>
              <span class="rc-compare-tag rc-tag-before" aria-hidden="true">{first.shortLabel}</span><span class="rc-compare-tag rc-tag-after" aria-hidden="true">{last.shortLabel}</span>
              <input type="range" class="rc-compare-range" min="0" max="100" step="1" value="50" aria-label={`Compare the photographs from ${first.label} and ${last.label}`} aria-valuetext={`Halfway between ${first.label} and ${last.label}`} data-compare-range hidden />
            </div>
            <figcaption>Drag across the photograph to compare the first and last published stills, 16 days apart.</figcaption>
          </figure>
          <div class="rc-still-strip" role="list" aria-label="The three published photographs">
            {photographs.map((photo, index) => (
              <figure class="rc-still" id={`rc-capture-${photo.date}`} role="listitem" data-capture>
                <a href={photo.image} target="_blank" rel="noopener noreferrer" aria-label={`Open the controlled tent photograph from ${photo.label} in a new tab`}>
                  <img src={photo.image} alt={`Real camera photograph from ${photo.label}: straw-filled substrate bags hanging from the PVC frame inside the controlled tent.`} width="1600" height="900" loading="lazy" decoding="async" />
                  <span class="rc-image-expand" aria-hidden="true">↗</span>
                </a>
                <figcaption><span class="rc-capture-number">0{index + 1}</span><time datetime={photo.date}>{photo.label}</time></figcaption>
              </figure>
            ))}
          </div>
          <p class="rc-photo-context">Source: controlled-camera captures from the first cultivation experiment. Dates shown in Cairo time (UTC+3).</p>
        </div>
        <div class="rc-observation-copy">
          <h2 id="observations-heading">A record of<br /><em>slow change.</em></h2>
          <p class="rc-lead">Some changes are easier to see when you give them time.</p>
          <p>These photographs come from the controlled tent during incubation. They show the bags and their surroundings at selected moments, without turning a visual impression into a growth claim.</p>
          <div class="rc-capture-card">
            <div class="rc-capture-card-head"><img src="/media/camera.webp" alt="" width="76" height="96" loading="lazy" /><p class="rc-kicker">HOW THEY ARE TAKEN</p></div>
            <dl>
              {captureDetails.map(([name, value]) => <div><dt>{name}</dt><dd>{value}</dd></div>)}
            </dl>
            <a class="rc-record-link" href="#architecture-panel-record">How these are captured: the Record path <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
      <div class="rc-timelapse">
        <div class="rc-timelapse-copy">
          <p class="rc-kicker">THE INCUBATION SEQUENCE</p>
          <h3>18 days,<br /><em>in 12 seconds.</em></h3>
          <p>The same tent, photographed over 18 days. This silent sequence brings 73 scheduled incubation stills together, one every six hours.</p>
          <p id="rc-timelapse-description">Hanging substrate bags remain in view as the camera records the interior of the tent. The film shows the captured sequence, without generated frames. Drag along the days beneath it to step through it one photograph at a time.</p>
          <a href="/media/incubation-controlled-2026-08-18-to-09-05.mp4" download>Download the film <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="rc-timelapse-film" data-timelapse>
          <video controls playsinline preload="none" poster="/media/photo-incubation-2026-08-19.webp" width="1280" height="720" aria-label="Silent timelapse of the controlled tent during incubation" aria-describedby="rc-timelapse-description">
            <source src="/media/incubation-controlled-2026-08-18-to-09-05.mp4" type="video/mp4" />
            <p>Your browser cannot play this video. <a href="/media/incubation-controlled-2026-08-18-to-09-05.mp4">Download the incubation timelapse.</a></p>
          </video>
          {/* A day-by-day timeline: 73 stills, one every six hours, each held for five frames of the film. */}
          <div class="rc-scrub" data-scrub hidden>
            <div class="rc-scrub-reading" aria-hidden="true"><span data-scrub-day>Day 0</span><span data-scrub-date>18 Aug 2026</span></div>
            <input type="range" min="0" max="72" step="1" value="0" aria-label="Step through the timelapse, one photograph at a time" aria-valuetext="Day 0, 18 August 2026" data-scrub-range />
            <div class="rc-scrub-days" aria-hidden="true">{[0, 3, 6, 9, 12, 15, 18].map(day => <span style={`left:${day / 18 * 100}%`}>Day {day}</span>)}</div>
          </div>
          <figcaption>73 scheduled stills · 18 Aug-5 Sep 2026 · Controlled tent</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="vision" class="rc-section rc-vision" aria-labelledby="vision-heading">
    <div class="rc-container">
      <div class="rc-section-label"><span class="rc-marker"></span> COMPUTER VISION <span class="rc-label-rule"></span> RESEARCH IN PROGRESS</div>
      <div class="rc-vision-grid">
        <div class="rc-vision-copy">
          <h2 id="vision-heading">From looking<br /><em>to recognizing.</em></h2>
          <p class="rc-lead">Can a camera help us observe mushrooms more consistently?</p>
          <p>A YOLOv8s model has been trained to detect mushrooms. The next ambition is to bring inference onto the Raspberry Pi using the Hailo-10H accelerator, then examine what the detections can reliably tell us.</p>
          <p class="rc-vision-principle">A detection is an observation.<br />It is not, by itself, a growth measurement.</p>
        </div>
        <div class="rc-vision-work">
          <div class="rc-vision-step">
            <span class="rc-vision-index">01</span>
            <div><p class="rc-vision-status">TRAINED</p><h3>A mushroom detector</h3><p>YOLOv8s, with mushroom as the primary class. The reported model result is <strong>mAP50 ≈ 0.9443</strong>.</p><p class="rc-vision-caveat">Evaluation-set details are not supplied here, so this figure does not establish performance in the tent.</p></div>
          </div>
          <div class="rc-vision-step">
            <span class="rc-vision-index">02</span>
            <div><p class="rc-vision-status rc-status-planned">PLANNED INTEGRATION</p><h3>Inference at the edge</h3><p>The Raspberry Pi AI HAT 2 is intended to run the model locally. A complete deployed inference workflow is not yet demonstrated here.</p></div>
          </div>
          <div class="rc-vision-step">
            <span class="rc-vision-index">03</span>
            <div><p class="rc-vision-status rc-status-planned">FUTURE WORK</p><h3>From detections to evidence</h3><p>Publish real annotated examples, inspect errors, and investigate whether visible counts or area can support useful observations over time.</p></div>
          </div>
        </div>
      </div>
      <div class="rc-vision-footnote"><span aria-hidden="true">↗</span><p>Annotated predictions will appear here when actual outputs are ready to share. No demonstration detections are presented as experiment results.</p></div>
    </div>
  </section>


</div>

<script>
  const initializeResearchChapters = () => {
    document.querySelectorAll<HTMLElement>('[data-phase-explorer]').forEach((explorer) => {
      if (explorer.dataset.initialized === 'true') return;
      const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-phase-tab]'));
      const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-phase-panel]'));
      const tablist = explorer.querySelector<HTMLElement>('[role="tablist"]');
      if (!tablist || !tabs.length || tabs.length !== panels.length) return;
      const selectTab = (selectedIndex: number, moveFocus = false) => {
        tabs.forEach((tab, index) => {
          const selected = index === selectedIndex;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          if (panels[index]) panels[index].hidden = !selected;
        });
        if (moveFocus) tabs[selectedIndex]?.focus();
      };
      tabs.forEach((tab, index) => {
        panels[index].setAttribute('role', 'tabpanel');
        panels[index].setAttribute('aria-labelledby', tab.id);
        panels[index].tabIndex = 0;
        tab.addEventListener('click', () => selectTab(index));
        tab.addEventListener('keydown', (event) => {
          let nextIndex: number | undefined;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
          if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
          if (event.key === 'Home') nextIndex = 0;
          if (event.key === 'End') nextIndex = tabs.length - 1;
          if (nextIndex !== undefined) {
            event.preventDefault();
            selectTab(nextIndex, true);
          }
        });
      });
      selectTab(0);
      tablist.hidden = false;
      explorer.dataset.initialized = 'true';
    });
    // The first and last stills, one over the other: drag across the photograph (or use the arrow keys) to move the line.
    document.querySelectorAll<HTMLElement>('[data-compare]').forEach((compare) => {
      if (compare.dataset.initialized === 'true') return;
      const frame = compare.querySelector<HTMLElement>('.rc-compare-frame');
      const range = compare.querySelector<HTMLInputElement>('[data-compare-range]');
      if (!frame || !range) return;
      const [before, after] = [compare.querySelector('.rc-tag-before')?.textContent ?? '', compare.querySelector('.rc-tag-after')?.textContent ?? ''];
      const show = (value: number) => {
        const split = Math.round(Math.min(100, Math.max(0, value)));
        range.value = String(split);
        compare.style.setProperty('--split', `${split}%`);
        range.setAttribute('aria-valuetext', `${split}% ${before}, ${100 - split}% ${after}`);
      };
      range.addEventListener('input', () => show(Number(range.value)));
      // Pointer drags move the line; the page still scrolls vertically over the photograph on touch screens.
      const fromPointer = (event: PointerEvent) => { const box = frame.getBoundingClientRect(); show((event.clientX - box.left) / box.width * 100); };
      let dragging: number | undefined;
      frame.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        dragging = event.pointerId;
        try { frame.setPointerCapture(event.pointerId); } catch { /* the drag still follows moves over the photograph */ }
        fromPointer(event); frame.dataset.dragging = '';
      });
      frame.addEventListener('pointermove', (event) => { if (event.pointerId === dragging) fromPointer(event); });
      const release = () => { dragging = undefined; delete frame.dataset.dragging; };
      frame.addEventListener('pointerup', release);
      frame.addEventListener('pointercancel', release);
      range.hidden = false;
      show(50);
      compare.dataset.initialized = 'true';
    });
    // The workbench key and its markers light each other up.
    document.querySelectorAll<HTMLElement>('.rc-hardware-figure').forEach((figure) => {
      if (figure.dataset.initialized === 'true') return;
      const markers = Array.from(figure.querySelectorAll<HTMLElement>('.rc-photo-marker'));
      figure.querySelectorAll<HTMLAnchorElement>('.rc-photo-key a').forEach((link, index) => {
        const on = () => markers[index]?.setAttribute('data-active', '');
        const off = () => markers[index]?.removeAttribute('data-active');
        link.addEventListener('mouseenter', on); link.addEventListener('focus', on);
        link.addEventListener('mouseleave', off); link.addEventListener('blur', off);
      });
      figure.dataset.initialized = 'true';
    });
    // The film's days: 73 stills, one every six hours from 18 August, each held for five frames (six stills a second).
    document.querySelectorAll<HTMLElement>('[data-timelapse]').forEach((film) => {
      if (film.dataset.initialized === 'true') return;
      const video = film.querySelector<HTMLVideoElement>('video');
      const scrub = film.querySelector<HTMLElement>('[data-scrub]');
      const range = film.querySelector<HTMLInputElement>('[data-scrub-range]');
      const dayText = film.querySelector<HTMLElement>('[data-scrub-day]');
      const dateText = film.querySelector<HTMLElement>('[data-scrub-date]');
      if (!video || !scrub || !range || !dayText || !dateText) return;
      const start = Date.UTC(2026, 7, 18), perSecond = 6, lastStill = 72;
      const dateOf = (day: number, month: 'short' | 'long') => new Date(start + day * 86400000).toLocaleDateString('en-GB', { day: 'numeric', month, year: 'numeric', timeZone: 'UTC' });
      let shown = -1;
      const show = (still: number) => {
        if (still === shown) return;
        shown = still;
        const day = Math.floor(still / 4);
        dayText.textContent = `Day ${day}`;
        dateText.textContent = dateOf(day, 'short');
        range.value = String(still);
        range.setAttribute('aria-valuetext', `Day ${day}, ${dateOf(day, 'long')}`);
      };
      // The film loads only when the visitor plays or scrubs it.
      const whenReady = (then: () => void) => {
        if (video.readyState >= 1) { then(); return; }
        video.preload = 'auto';
        video.addEventListener('loadedmetadata', then, { once: true });
        if (video.networkState === HTMLMediaElement.NETWORK_EMPTY) video.load();
      };
      range.addEventListener('input', () => {
        const still = Number(range.value);
        video.pause();
        show(still);
        whenReady(() => { video.currentTime = (still + .5) / perSecond; });
      });
      video.addEventListener('timeupdate', () => { if (document.activeElement !== range) show(Math.min(lastStill, Math.max(0, Math.floor(video.currentTime * perSecond)))); });
      scrub.hidden = false;
      show(0);
      film.dataset.initialized = 'true';
    });
  };
  initializeResearchChapters();
  document.addEventListener('astro:page-load', initializeResearchChapters);
</script>

