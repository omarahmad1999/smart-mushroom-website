---
import SystemFlow from './SystemFlow.astro';

const routes = [
  {
    id: 'observe',
    name: 'Observe',
    verb: 'From the tent to the record.',
    description: 'Python services collect readings from the tent and the surrounding room. MQTT carries the measurements to a writer, which saves their history. Grafana queries that history and displays the experiment data.',
    eyebrow: 'THE MEASUREMENT PATH',
  },
  {
    id: 'respond',
    name: 'Respond',
    verb: 'A condition becomes a decision.',
    description: 'The controllers consider environmental readings alongside the settings for the cultivation phase. They send commands through MQTT to the services responsible for ventilation, moisture and lighting.',
    eyebrow: 'THE CONTROL PATH',
  },
  {
    id: 'record',
    name: 'Record',
    verb: 'Make the slow changes visible.',
    description: 'A phase-aware scheduler captures still photographs. Selected images and completed timelapses can then be prepared and published with the research, preserving the context of what the cameras observed.',
    eyebrow: 'THE VISUAL RECORD',
  },
] as const;

---

<section id="architecture" class="system-architecture" data-system-architecture aria-labelledby="architecture-heading">
  <div class="architecture-inner">
    <header class="architecture-heading">
      <div>
        <p class="architecture-eyebrow"><span></span> THE CONNECTED SYSTEM</p>
        <h2 id="architecture-heading">A small ecosystem.<br /><em>A considered system.</em></h2>
      </div>
      <p class="architecture-introduction">Behind the growing space, a Raspberry Pi connects observation, automation and a visual record. Follow the three paths that make it work.</p>
    </header>

    <div class="architecture-schematic">
      <div class="schematic-toolbar">
        <div class="flow-tabs" role="tablist" aria-label="Explore a system pathway" aria-orientation="horizontal">
          {routes.map((route, index) => (
            <button
              type="button"
              role="tab"
              id={`architecture-tab-${route.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`architecture-panel-${route.id}`}
              tabindex={index === 0 ? 0 : -1}
              data-route={route.id}
            >
              <span class="tab-number" aria-hidden="true">0{index + 1}</span>
              {route.name}

            </button>
          ))}
        </div>
        <p class="schematic-label"><span class="schematic-mark" aria-hidden="true">⌁</span> Illustrated system flow</p>
      </div>

      {routes.map((route) => (
        <div
          id={`architecture-panel-${route.id}`}
          class="route-panel"
          role="tabpanel"
          aria-labelledby={`architecture-tab-${route.id}`}
          tabindex="0"
          data-panel={route.id}
        >
          <div class="route-introduction">
            <div>
              <p class="route-eyebrow">{route.eyebrow}</p>
              <h3>{route.verb}</h3>
            </div>
            <p class="route-description">{route.description}</p>
          </div>

          <SystemFlow pathway={route.id} />


        </div>
      ))}


    </div>


  </div>
</section>

<style>
  .system-architecture { background: #f6f3eb; color: #172b29; padding: clamp(32px,4vw,48px) 0; scroll-margin-top: 90px; }
  .architecture-inner { width: min(1600px, calc(100% - 2 * var(--page-pad, 5vw))); margin-inline: auto; }
  .architecture-heading { display: grid; grid-template-columns: 1.3fr 0.8fr; gap: 70px; align-items: end; margin-bottom: 42px; }
  .architecture-eyebrow, .route-eyebrow, .schematic-label, .schematic-reference { font-family: var(--font-body, sans-serif); font-size: 10px; letter-spacing: .12em; font-weight: 500; }
  .architecture-eyebrow { display: flex; gap: 9px; align-items: center; margin: 0 0 23px; color: #616d57; font-size: 11px; }
  .architecture-eyebrow > span { width: 5px; height: 5px; background: #d45b36; border-radius: 50%; }
  .architecture-heading h2 { font-family: var(--font-display, Georgia, serif); font-size: clamp(38px, 4.5vw, 61px); font-weight: 400; line-height: 1.1; letter-spacing: -.045em; margin: 0; }
  .architecture-heading h2 em { font-weight: 400; color: #6f7957; }
  .architecture-introduction { font-family: var(--font-body, sans-serif); color: #626a60; line-height: 1.75; font-size: 14px; max-width: 370px; margin: 0 0 5px; }
  .architecture-schematic { border: 1px solid #d5d9ca; border-radius: 3px; background: #eeeee4; overflow: hidden; }
  .schematic-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #d5d9ca; padding: 0 30px; min-height: 75px; gap: 20px; }
  .flow-tabs { display: none; align-self: stretch; gap: 27px; }
  [data-enhanced] .flow-tabs { display: flex; }
  .flow-tabs button { display: inline-flex; align-items: center; gap: 9px; padding: 0 0 1px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: #626a60; font-family: var(--font-body, sans-serif); font-size: 13px; font-weight: 500; cursor: pointer; transition: color .2s, border-color .2s; }
  .flow-tabs button:hover { color: #172b29; }
  .flow-tabs button[aria-selected="true"] { border-bottom-color: #d45b36; color: #172b29; }
  .tab-number { font-size: 9px; color: #76816a; }
  .flow-tabs button[aria-selected="true"] .tab-number { color: #d45b36; }
  .schematic-label { display: flex; align-items: center; gap: 8px; color: #737b6b; letter-spacing: .025em; margin: 0; white-space: nowrap; }
  .schematic-mark { font-size: 23px; color: #6f7957; line-height: 1; }
  .route-panel { padding: 37px 30px 25px; background: #fdfefc; }
  .route-panel[hidden] { display: none; }
  .route-panel + .route-panel { border-top: 1px solid #d5d9ca; }
  [data-enhanced] .route-panel { border-top: 0; }
  .route-introduction { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 35px; margin-bottom: 30px; }
  .route-eyebrow { color: #75806a; font-size: 9px; margin: 0 0 12px; }
  .route-introduction h3 { font-family: var(--font-display, Georgia, serif); font-size: clamp(23px, 2.4vw, 30px); letter-spacing: -.03em; font-weight: 400; margin: 0; line-height: 1.2; }
  .route-description { font-family: var(--font-body, sans-serif); font-size: 12px; line-height: 1.8; color: #646d5e; margin: 0; }
  .flow-tabs button:focus-visible, .route-panel:focus-visible { outline: 2px solid #d45b36; outline-offset: 5px; }
  .route-panel:focus-visible { outline-offset: -6px; }
  @media (max-width: 1000px) {
    .architecture-heading { gap: 35px; }
    .route-panel { padding-inline: 24px; }
    .schematic-toolbar { padding-inline: 24px; }
  }
  @media (max-width: 760px) {
    .architecture-heading { grid-template-columns: 1fr; gap: 24px; margin-bottom: 30px; }
    .architecture-introduction { max-width: 490px; }
    .schematic-toolbar { flex-wrap: wrap; gap: 0; padding: 0 20px; }
    .flow-tabs { min-height: 64px; gap: 25px; flex: 1; }
    .schematic-label { font-size: 9px; padding: 10px 0; }
    .route-panel { padding: 27px 20px 22px; }
    .route-introduction { grid-template-columns: 1fr; gap: 16px; margin-bottom: 25px; }
    .route-description { max-width: 550px; }
  }
  @media (max-width: 420px) {
    .schematic-toolbar { display: block; padding-inline: 16px; }
    .flow-tabs { justify-content: space-between; gap: 12px; }
    .flow-tabs button { gap: 7px; font-size: 12px; }
    .schematic-label { padding-top: 12px; padding-bottom: 12px; border-top: 1px solid #d5d9ca; }
    .route-panel { padding-inline: 16px; }
    .route-introduction h3 { font-size: 25px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-tabs button { transition: none; }
  }
</style>

<script>
  import { mountSystemFlow } from '../scripts/system-flow';
  const architecture = document.querySelector<HTMLElement>('[data-system-architecture]');

  if (architecture) {
    const tabs = [...architecture.querySelectorAll<HTMLButtonElement>('[data-route]')];
    const panels = [...architecture.querySelectorAll<HTMLElement>('[data-panel]')];
    const flows = new Map<string, ReturnType<typeof mountSystemFlow>>();

    const selectRoute = (selected: HTMLButtonElement, animate = true) => {
      const route = selected.dataset.route;
      tabs.forEach((tab) => {
        const active = tab === selected;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        const active = panel.dataset.panel === route;
        panel.hidden = !active;
      });
      flows.forEach((flow,id)=>flow.setActive(id===route,animate));
    };

    architecture.dataset.enhanced = 'true';
    selectRoute(tabs[0], false);
    architecture.querySelectorAll<HTMLElement>('[data-system-flow]').forEach(root=>{
      const flow=mountSystemFlow(root);
      flows.set(root.dataset.systemFlow!,flow);
      flow.setActive(root.dataset.systemFlow===tabs[0].dataset.route);
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectRoute(tab));
      tab.addEventListener('keydown', (event) => {
        let nextIndex: number;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        tabs[nextIndex].focus();
        selectRoute(tabs[nextIndex]);
      });
    });
  }
</script>
