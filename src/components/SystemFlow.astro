---
interface Props { pathway: 'observe' | 'respond' | 'record' }
const { pathway } = Astro.props;
type FlowNode = { id:string; name:string; icon:string[]; lines?:string[] };
type Caption = { id:string; lines:string[]; narrowLines?:string[] };
type Layout = { id:'wide'|'narrow'; viewBox:string; nodes:number[][]; captions:number[][]; paths:{id:string;d:string;target?:string}[] };
const observeNodes: FlowNode[] = [
  { id:'sht31', name:'SHT31', icon:['M10 5v11m-3-1.5a4 4 0 1 0 6 0V5a3 3 0 0 0-6 0v9.5Z','M17 4s-2.5 3-2.5 4.5a2.5 2.5 0 0 0 5 0C19.5 7 17 4 17 4Z'] },
  { id:'scd41', name:'SCD41', icon:['M7 17H6a4 4 0 0 1-.7-7.9A6 6 0 0 1 17 7.5a4.8 4.8 0 0 1 1 9.5h-1','M8 20h.01M12 20h.01M16 20h.01'] },
  { id:'mqtt', name:'MQTT', icon:['M12 10a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z','M7.8 7.8a6 6 0 0 0 0 8.4m8.4-8.4a6 6 0 0 1 0 8.4','M5 5a10 10 0 0 0 0 14M19 5a10 10 0 0 1 0 14'] },
  { id:'writer', name:'Database Writer', icon:['m7 6-5 6 5 6m10-12 5 6-5 6M14 4l-4 16'] },
  { id:'timescale', name:'TimescaleDB', icon:['M20 5c0 1.7-3.6 3-8 3S4 6.7 4 5s3.6-3 8-3 8 1.3 8 3Z','M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3'] },
  { id:'grafana', name:'Grafana', icon:['M18.5 8.5A7 7 0 1 0 19 17','M20 10a5 5 0 1 0-4 8','M15 12a2 2 0 1 0 0 4','m8 4 1-3 3 2m6 2 3-1-.5 4'] },
];
const icons: Record<string,string[]> = {
  sensor: ['M12 5v10', 'M9 14.5a4 4 0 1 0 6 0V5a3 3 0 0 0-6 0v9.5Z', 'M18 6h2M18 10h2'],
  network: ['M4 5h5v5H4zM15 14h5v5h-5zM15 5h5v5h-5z', 'M9 7.5h6M6.5 10v6.5H15'],
  code: ['m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16'],
  database: ['M20 5c0 1.7-3.6 3-8 3S4 6.7 4 5s3.6-3 8-3 8 1.3 8 3Z', 'M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3'],
  window: ['M3 4h18v16H3zM3 9h18M7 6.5h.01M10 6.5h.01', 'M7 13h5M7 16h9'],
  settings: ['M4 6h16M4 12h16M4 18h16', 'M8 3v6M16 9v6M10 15v6'],
  chip: ['M7 7h10v10H7zM10 10h4v4h-4z', 'M9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4'],
  fan: ['M14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z', 'M11 10C5 5 14 0 16 5c1 2-1 4-3 5M14 11c5-6 10 3 5 5-2 1-4-1-5-3M13 14c6 5-3 10-5 5-1-2 1-4 3-5M10 13C5 19 0 10 5 8c2-1 4 1 5 3'],
  clock: ['M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z', 'M12 6v6l4 2'],
  camera: ['M3 7h5l2-3h4l2 3h5v13H3z', 'M16 13a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z'],
  film: ['M3 3h18v18H3zM7 3v18M17 3v18M3 8h4M3 16h4M17 8h4M17 16h4', 'm10 9 5 3-5 3V9Z'],
};
const flows: Record<Props['pathway'],{name:string;nodes:FlowNode[];captions:Caption[];accessible:string[];footer:string;completion:string}> = {
  observe: {
    name:'Observe', nodes:observeNodes,
    captions:[
      {id:'readings',lines:['Send Readings'],narrowLines:['Send','Readings']},
      {id:'published',lines:['Carries Published','Measurements']},
      {id:'stored',lines:['Stores','Measurements']},
      {id:'visualized',lines:['Visualizes Stored','Measurements'],narrowLines:['Visualizes','Stored Measurements']},
    ],
    accessible:[
      'SHT31 and SCD41 sensors send readings together. Their paths merge before MQTT.',
      'MQTT carries published measurements to the Database Writer.',
      'The Database Writer stores measurements in TimescaleDB.',
      'Grafana visualizes stored measurements from TimescaleDB.',
    ],
    footer:'One Path, From Sensing To Seeing',
    completion:'Grafana displays the stored measurements.',
  },
  respond: {
    name:'Respond',
    nodes:[
      {id:'inputs',name:'Readings & Phase Settings',lines:['Readings &','Phase Settings'],icon:icons.settings},
      {id:'controllers',name:'Controllers',icon:icons.code},
      {id:'mqtt',name:'MQTT',icon:observeNodes.find(node=>node.id==='mqtt')!.icon},
      {id:'actuators',name:'Actuator Services',lines:['Actuator','Services'],icon:icons.chip},
      {id:'devices',name:'Fan, Humidifier & LEDs',lines:['Fan, Humidifier','& LEDs'],icon:icons.fan},
    ],
    captions:[
      {id:'evaluate',lines:['Evaluate','Conditions']},
      {id:'commands',lines:['Publish','Commands']},
      {id:'route',lines:['Route','Commands']},
      {id:'drive',lines:['Drive','Devices']},
    ],
    accessible:[
      'Readings & Phase Settings provide the context for a decision.',
      'Controllers are Python services that evaluate the configured conditions.',
      'The MQTT broker carries the published commands.',
      'Actuator Services translate commands into device actions.',
      'Fan, Humidifier & LEDs influence the growing environment.',
    ],
    footer:'From Conditions To A Physical Response',
    completion:'Actuator services drive ventilation, moisture and lighting in the experiment system.',
  },
  record: {
    name:'Record',
    nodes:[
      {id:'schedule',name:'Capture Schedule',icon:icons.clock},
      {id:'cameras',name:'Two Cameras',icon:icons.camera},
      {id:'storage',name:'Image Storage',icon:icons.database},
      {id:'preparation',name:'Media Preparation',icon:icons.film},
    ],
    captions:[
      {id:'capture',lines:['Trigger','Capture']},
      {id:'save',lines:['Save','Images']},
      {id:'prepare',lines:['Produce','Timelapses']},
    ],
    accessible:[
      'Capture Schedule uses a systemd timer, with timing following the cultivation phase.',
      'Two Cameras photograph the tent and ambient view using Camera Module 3 Wide cameras.',
      'Image Storage keeps the captured still photographs as local media files.',
      'Media Preparation selects images and produces completed timelapses.',
    ],
    footer:'From Scheduled Stills To A Visual Record',
    completion:'Selected photographs and completed timelapses form the visual record.',
  },
};
const flow=flows[pathway], nodes=flow.nodes, captions=flow.captions;
const lastId=nodes.at(-1)!.id;
const prefix=`flow-${pathway}`;
let layouts: Layout[];
if(pathway==='observe') {
  layouts=[
    {
      id:'wide',viewBox:'0 0 1160 440',
      nodes:[[100,105],[100,315],[390,210],[610,110],[830,300],[1050,180]],
      captions:[[276,165],[520,246],[715,78],[954,339]],
      paths:[
        {id:'sht31',d:'M142 105H174Q194 105 194 125V190Q194 210 214 210'},
        {id:'scd41',d:'M142 315H174Q194 315 194 295V230Q194 210 214 210'},
        {id:'merged',d:'M214 210H348',target:'mqtt'},
        {id:'published',d:'M432 210H480Q500 210 500 190V130Q500 110 520 110H568',target:'writer'},
        {id:'stored',d:'M652 110H700Q720 110 720 130V280Q720 300 740 300H788',target:'timescale'},
        {id:'visualized',d:'M872 300H920Q940 300 940 280V200Q940 180 960 180H1008',target:'grafana'},
      ],
    },
    {
      id:'narrow',viewBox:'0 0 384 850',
      nodes:[[77,92],[77,252],[300,172],[77,430],[300,600],[77,760]],
      captions:[[210,140],[218,346],[201,516],[180,681]],
      paths:[
        {id:'sht31',d:'M119 92H146Q166 92 166 112V152Q166 172 186 172'},
        {id:'scd41',d:'M119 252H146Q166 252 166 232V192Q166 172 186 172'},
        {id:'merged',d:'M186 172H258',target:'mqtt'},
        {id:'published',d:'M342 172H350Q368 172 368 190V356Q368 374 350 374H95Q77 374 77 392',target:'writer'},
        {id:'stored',d:'M35 430H32Q14 430 14 448V528Q14 546 32 546H282Q300 546 300 564',target:'timescale'},
        {id:'visualized',d:'M342 600H350Q368 600 368 618V688Q368 706 350 706H95Q77 706 77 724',target:'grafana'},
      ],
    },
  ];
} else {
  const wideNodes=pathway==='respond'?[[100,140],[340,310],[580,170],[820,290],[1060,120]]:[[130,150],[430,310],[740,110],[1030,270]];
  const wideCaptions=pathway==='respond'?[[216,96],[466,352],[704,131],[946,330]]:[[279,104],[582,349],[884,68]];
  const bends=pathway==='respond'?[222,472,694,944]:[278,586,902];
  const narrowNodes=pathway==='respond'?[[84,95],[286,310],[98,530],[300,725],[112,950]]:[[84,95],[286,315],[104,520],[280,750]];
  layouts=[
    {
      id:'wide',viewBox:'0 0 1160 440',nodes:wideNodes,
      captions:wideCaptions,
      paths:captions.map((caption,index)=>{
        const [x,y]=wideNodes[index],[nextX,nextY]=wideNodes[index+1],bend=bends[index];
        const direction=nextY>y?1:-1;
        return{id:caption.id,target:nodes[index+1].id,d:`M${x+42} ${y}H${bend-20}Q${bend} ${y} ${bend} ${y+20*direction}V${nextY-20*direction}Q${bend} ${nextY} ${bend+20} ${nextY}H${nextX-42}`};
      }),
    },
    {
      id:'narrow',viewBox:`0 0 384 ${narrowNodes.at(-1)![1]+115}`,nodes:narrowNodes,
      captions:captions.map((_,index)=>[narrowNodes[index+1][0],narrowNodes[index][1]+95]),
      paths:captions.map((caption,index)=>{
        const [x,y]=narrowNodes[index],[nextX,nextY]=narrowNodes[index+1];
        const direction=nextX>x?1:-1,bend=(x+nextX)/2;
        return{id:caption.id,target:nodes[index+1].id,d:`M${x+42*direction} ${y+20}H${bend-18*direction}Q${bend} ${y+20} ${bend} ${y+38}V${nextY-38}Q${bend} ${nextY-20} ${bend+18*direction} ${nextY-20}H${nextX-42*direction}`};
      }),
    },
  ];
}
---
<div class="pathway-flow" data-system-flow={pathway} data-flow-name={flow.name} data-flow-completion={flow.completion} data-flow-state="static" role="group" aria-label={`${flow.name} Pathway Illustration`}>
  <ol class="pathway-accessible-path">{flow.accessible.map(step=><li>{step}</li>)}</ol>
  <div class="pathway-canvas" data-pathway-canvas>
    {layouts.map(layout => (
      <svg class={`pathway-diagram pathway-${layout.id}`} data-flow-layout={layout.id} viewBox={layout.viewBox} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <pattern id={`${prefix}-grid-${layout.id}`} width="64" height="64" patternUnits="userSpaceOnUse"><path d="M64 0H0V64" stroke="#ededed" stroke-width=".8" /></pattern>
          <linearGradient id={`${prefix}-tile-${layout.id}`} x1="0" y1="0" x2="0" y2="1"><stop stop-color="#ffffff"/><stop offset="1" stop-color="#fcfcfc"/></linearGradient>
          <filter id={`${prefix}-shadow-${layout.id}`} x="-60%" y="-60%" width="220%" height="240%"><feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#585858" flood-opacity=".09"/><feDropShadow dx="0" dy="1" stdDeviation="1" flood-color="#585858" flood-opacity=".08"/></filter>
          <filter id={`${prefix}-glow-${layout.id}`} x="-70%" y="-70%" width="240%" height="240%"><feGaussianBlur stdDeviation="3.5"/></filter>
          <filter id={`${prefix}-grain-${layout.id}`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur in="SourceGraphic" stdDeviation=".8" result="soft"/><feTurbulence type="fractalNoise" baseFrequency=".72" numOctaves="3" seed="7"/><feColorMatrix type="saturate" values="0"/><feComponentTransfer result="noise"><feFuncA type="linear" slope=".28"/></feComponentTransfer><feComposite in="noise" in2="soft" operator="in" result="grain"/><feBlend in="soft" in2="grain" mode="soft-light"/></filter>
          <filter id={`${prefix}-aura-${layout.id}`} x="-70%" y="-70%" width="240%" height="240%"><feGaussianBlur stdDeviation="9"/></filter>
        </defs>
        <rect width="100%" height="100%" fill={`url(#${prefix}-grid-${layout.id})`} opacity=".56"/>
        <g class="pathway-connections" stroke-linecap="round" stroke-linejoin="round">
          {layout.paths.map(({id,d,target}) => <g class:list={['pathway-connection',{'pathway-green':target===lastId}]}>
            <path d={d} stroke="#ffffff" stroke-width="3.8" transform="translate(0 1.2)"/>
            <path d={d} stroke="#e6e8e8" stroke-width="3.2"/>
            <path d={d} data-flow-path={id} data-flow-target={target} class="pathway-path" stroke="#cdd1d3" stroke-width=".7"/>
            <path d={d} data-flow-pulse={id} class="pathway-pulse pathway-pulse-glow" pathLength="1" stroke-width="7" filter={`url(#${prefix}-glow-${layout.id})`}/>
            <path d={d} data-flow-pulse={id} class="pathway-pulse pathway-pulse-body" pathLength="1" stroke-width="1.2"/>
            <path class="pathway-liquid" data-liquid-link={id} fill="currentColor" opacity="0"/>
            <path d={d} data-flow-pulse={id} class="pathway-pulse pathway-pulse-core" pathLength="1" stroke-width=".55"/>
          </g>)}
          {pathway==='observe'&&<circle cx={layout.id==='wide'?214:186} cy={layout.id==='wide'?210:172} r="2.5" fill="#cdd1d3" data-flow-junction/>}
        </g>
        {nodes.map((node,index) => <g class:list={['pathway-node',{'pathway-green':node.id===lastId}]} data-flow-node={node.id} data-flow-node-name={node.name} transform={`translate(${layout.nodes[index].join(' ')})`}>
          <rect x="-49" y="-49" width="98" height="98" rx="19" fill="none"/>
          <path d="M-40-53H40Q40-40 53-40V40Q40 40 40 53H-40Q-40 40-53 40V-40Q-40-40-40-53Z" fill="#e6e8e8"/>
          {[-1,1].flatMap(x=>[-1,1].map(y=><circle class="pathway-corner-dot" cx={x*51} cy={y*51} r="1.8" fill="#cdd1d3"/>))}
          <rect class="pathway-aura" x="-49" y="-49" width="98" height="98" rx="19" fill="var(--flow-halo)" opacity="0" filter={`url(#${prefix}-aura-${layout.id})`}/>
          <path class="pathway-light" d="M-40-53H40Q40-40 53-40V40Q40 40 40 53H-40Q-40 40-53 40V-40Q-40-40-40-53Z" fill="var(--flow-halo)" opacity="0" filter={`url(#${prefix}-grain-${layout.id})`}/>
          <path class="pathway-halo" d="M-40-53H40Q40-40 53-40V40Q40 40 40 53H-40Q-40 40-53 40V-40Q-40-40-40-53Z" stroke="var(--flow-halo)" stroke-width=".9" opacity="0"/>
          <rect x="-42" y="-42" width="84" height="84" rx="15" fill={`url(#${prefix}-tile-${layout.id})`} stroke="white" stroke-width="2" filter={`url(#${prefix}-shadow-${layout.id})`}/>
          <rect x="-37" y="-37" width="74" height="74" rx="11" stroke="#eeeeee" stroke-width=".7"/>
          <rect class="pathway-rim pathway-rim-glow" x="-42" y="-42" width="84" height="84" rx="15" pathLength="1" stroke="currentColor" stroke-width="9" opacity="0" filter={`url(#${prefix}-glow-${layout.id})`}/>
          <rect class="pathway-rim pathway-rim-body" x="-42" y="-42" width="84" height="84" rx="15" pathLength="1" stroke="currentColor" stroke-width="1.2" opacity="0"/>
          <path class="pathway-liquid" data-liquid-node={node.id} fill="currentColor" opacity="0"/>
          <rect class="pathway-rim pathway-rim-core" x="-42" y="-42" width="84" height="84" rx="15" pathLength="1" stroke="var(--flow-core)" stroke-width=".55" opacity="0"/>
          <g class="pathway-glyph" transform="translate(-16 -16) scale(1.3333)" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">{node.icon.map(d=><path d={d}/>)}{node.id==='scd41'&&<text x="12" y="14.5" text-anchor="middle" fill="currentColor" stroke="none" font-size="6.2" font-family="Arial,sans-serif">CO₂</text>}</g>
          <circle cx="25" cy="-25" r="8.5" fill="#f5f5f5"/>
          <text x="25" y="-22" class="pathway-index" text-anchor="middle">{index+1}</text>
          <rect class="pathway-name-highlight" x={-Math.max(46,...(node.lines??[node.name]).map(line=>line.length*7.5+14))/2} y="59" width={Math.max(46,...(node.lines??[node.name]).map(line=>line.length*7.5+14))} height={21+((node.lines?.length??1)-1)*16} rx="3" fill="currentColor" opacity="0"/>
          {(node.lines??[node.name]).map((line,row)=><text x="0" y={73+row*16} class="pathway-name" data-flow-title={line} text-anchor="middle">{line}</text>)}
        </g>)}
        {captions.map((caption,index) => <g data-flow-caption={caption.id} class:list={['pathway-caption',{'pathway-caption-final':index===captions.length-1}]}>
          {(layout.id==='narrow'&&caption.narrowLines?caption.narrowLines:caption.lines).map((line,row)=><text x={layout.captions[index][0]} y={layout.captions[index][1]+row*15} text-anchor="middle" xml:space="preserve">{Array.from(line).map(letter=><tspan data-flow-letter>{letter}</tspan>)}</text>)}
        </g>)}
      </svg>
    ))}
  </div>
  <div class="pathway-playback" data-pathway-controls hidden>
    <span class="pathway-playback-caption">{flow.footer}</span>
    <div class="pathway-playback-buttons">
      <button type="button" data-pathway-pause aria-label={`Pause ${flow.name} Animation`}><span data-pathway-pause-icon aria-hidden="true">Ⅱ</span><span data-pathway-pause-label>Pause</span></button>
      <button type="button" data-pathway-replay aria-label={`Replay ${flow.name} Animation`}><span aria-hidden="true">↺</span>Replay</button>
    </div>
  </div>
  <p class="pathway-accessible-path" data-pathway-status role="status" aria-live="polite"></p>
</div>

<style>
  .pathway-flow{--flow-orange:#c65b16;--flow-green:#4e9b78;--flow-halo:#ff8b26;--flow-label-orange:#985727;--flow-label-green:#35755a;--flow-core:#f4a35b;position:relative;min-width:0;margin:8px -10px 0;background:#fdfefc}
  .pathway-canvas{position:relative;isolation:isolate}
  .pathway-diagram{display:block;width:100%;height:auto;overflow:visible}
  .pathway-narrow{display:none}
  .pathway-node,.pathway-connection{color:var(--flow-orange)}
  .pathway-green{color:var(--flow-green);--flow-halo:#d8e9df;--flow-core:#effff7}
  .pathway-glyph{color:#a0a0a0}
  .pathway-name,.pathway-index,.pathway-caption{font-family:ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace;font-weight:400}
  .pathway-name{fill:#888888;font-size:12.5px;letter-spacing:.025em}
  .pathway-index{fill:#aaaaaa;font-size:9px}
  .pathway-caption{color:var(--flow-label-green);fill:currentColor;font-size:12.5px;letter-spacing:-.035em}
  .pathway-caption-final{color:var(--flow-label-orange)}
  .pathway-pulse{stroke:currentColor;opacity:0;stroke-dasharray:.12 1}
  .pathway-pulse-core{stroke:var(--flow-core)}
  .pathway-pulse-glow,.pathway-rim-glow{stroke-opacity:.3}
  .pathway-playback{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:9px 14px 3px}
  .pathway-playback-caption{font-size:9px;letter-spacing:.09em;color:#92998c;line-height:1.7}
  .pathway-playback-buttons{display:flex;align-items:center;gap:9px;flex:none}
  .pathway-playback button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;border:0;border-radius:3px;background:transparent;color:#69785f;padding:0 10px;font:11px var(--font-body,sans-serif);cursor:pointer}
  .pathway-playback button>span[aria-hidden]{font-size:16px;line-height:1}
  .pathway-playback button:hover{color:var(--flow-label-orange)}
  .pathway-playback button:focus-visible{outline:2px solid #d45b36;outline-offset:3px}
  .pathway-playback button:disabled{opacity:.45;cursor:default;box-shadow:none}
  .pathway-accessible-path{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:760px){.pathway-flow{margin:0 -5px}.pathway-wide{display:none}.pathway-narrow{display:block;max-width:430px;margin:auto}.pathway-playback{padding:9px 10px;gap:9px}.pathway-playback-caption{max-width:130px;font-size:8px}.pathway-playback-buttons{gap:6px}.pathway-playback button{padding-inline:8px;font-size:10px}}
  @media(prefers-reduced-motion:reduce){.pathway-playback{display:none}}
</style>
