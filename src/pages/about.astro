---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Myko from '../components/Myko.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/about/profile.jpg';
import '@fontsource/caveat/400.css';
const chapters=[
  {id:'story',label:'My story',expression:'happy',title:'Where data meets cultivation.',text:'',note:'',href:'',link:''},
  {id:'build',label:'What I build',expression:'curious',title:'Making an idea tangible.',text:'I couldn’t find a Martha tent locally in Egypt, so I built the structure from PVC pipes. From cutting and reinforcing the frame to connecting sensors and writing software, this project has been a sequence of small decisions, practical problems, and things learnt along the way.',note:'Measure. Make. Learn. Try again.',href:'/documentation/#notebook-journey',link:'Follow the build'},
  {id:'explore',label:'What I’m exploring',expression:'curious',title:'Still plenty of questions.',text:'I’m exploring how controlled conditions affect mushroom yield and health, and how scheduled photographs and computer vision can help document growth. The field notes hold the decisions and observations, including the attempts that didn’t go to plan.',note:'The unfinished parts belong in the notebook, too.',href:'/documentation/#notebook-vision',link:'Visit the vision lab'},
];
const personalJourney=[
  {stage:'EARLY YEARS',place:'Riyadh, Saudi Arabia',detail:'Born and raised in Riyadh, where I lived through elementary school.'},
  {stage:'SCHOOL YEARS',place:'Cairo, Egypt',detail:'Continued my education in Cairo through secondary school.'},
  {stage:'UNIVERSITY',place:'Kuala Lumpur, Malaysia',detail:'Earned my bachelor’s degree in Computer Science and Artificial Intelligence from the University of Malaya.'},
];
const socials=[
  {name:'X',handle:'@mycolabz',icon:'x',href:'https://x.com/mycolabz',className:'social-x'},
  {name:'LinkedIn',handle:'Omar Ahmad',icon:'linkedin',href:'https://www.linkedin.com/in/omar-ahmad-916378186/',className:'social-linkedin'},
  {name:'TikTok',handle:'@mycolabs',icon:'tiktok',href:'https://www.tiktok.com/@mycolabs',className:'social-tiktok'},
];
---
<BaseLayout title="About Me — Smart Mushroom Hub" description="Meet the maker behind Smart Mushroom Hub, and Myko, a little companion for a growing experiment.">
  <article class="about-page" data-about-page>
    <header class="about-header"><p class="eyebrow"><span class="eyebrow-dot"></span> THE PERSON BEHIND THE HABITAT</p><h1>Omar Ahmad</h1></header>
    <div class="about-introduction">
      <figure class="profile profile-main"><Image src={portrait} alt="The maker of Smart Mushroom Hub beside a peacock" widths={[640,1000,1400]} sizes="(max-width:650px) 92vw, 48vw" width={1400} format="webp" quality={85} loading="eager" /><figcaption>the person behind the experiment</figcaption></figure>
      <section class="maker-story" aria-label="About the maker">
        <div class="story-tabs" role="tablist" aria-label="Read about the maker" hidden>{chapters.map((chapter,i)=><button type="button" role="tab" id={`tab-${chapter.id}`} aria-controls={`story-${chapter.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-story={chapter.id} data-expression={chapter.expression}>{chapter.label}</button>)}</div>
        <div class="story-pages">{chapters.map(chapter=><section class="story-page" id={`story-${chapter.id}`} data-story-page={chapter.id} aria-labelledby={`heading-${chapter.id}`}><h3 id={`heading-${chapter.id}`}>{chapter.title}</h3>{chapter.id==='story'?<><div class="story-copy"><p>I’m a data analyst with a passion for farming. My work has taught me to look for patterns, ask questions, and learn from evidence. Farming gives that curiosity a living context.</p><p>I have been fascinated by mushrooms since I first learned how they grow—and honestly, how could you not be? Their unusual shapes, vivid colours, and varied habitats can make them seem almost extraterrestrial. Some fungi can even take over living insects, so yes: zombies are real, in a way.</p><p>This project brings those interests together through cultivation, technology, observation, and experimentation.</p></div><section class="personal-journey" aria-labelledby="personal-journey-heading"><p class="eyebrow" id="personal-journey-heading">MY JOURNEY</p><ol>{personalJourney.map(item=><li><span>{item.stage}</span><div><h4>{item.place}</h4><p>{item.detail}</p></div></li>)}</ol></section></>:<><p>{chapter.text}</p><p class="pencil-note">{chapter.note}</p><a href={chapter.href}>{chapter.link}<Icon name="arrow-right" size={15}/></a></>}</section>)}</div>
        <section class="social-notes" aria-labelledby="social-notes-heading">
          <div class="social-heading"><h2 id="social-notes-heading">Find me <em>elsewhere.</em></h2><span aria-hidden="true">↘</span></div>
          <nav class="social-stack" aria-label="Omar’s social profiles">
            {socials.map(social => <a class={`social-paper ${social.className}`} href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`${social.name}: ${social.handle}`}><span class="social-mark" aria-hidden="true"><Icon name={social.icon} size={17} class="social-logo" /></span><span><small>{social.name}</small><strong>{social.handle}</strong></span><span class="social-arrow" aria-hidden="true">↗</span></a>)}
          </nav>
        </section>
      </section>
    </div>
    <Myko />
  </article>
</BaseLayout>
<script>import '../scripts/about-page';</script>
<style>
.about-page{width:min(1450px,calc(100% - 2 * var(--page-pad)));margin:auto;padding:65px 0 85px}.about-header{position:relative}.about-header .eyebrow{font-size:9px;color:var(--olive)}h1{font-size:clamp(55px,6.4vw,92px);letter-spacing:-.05em;line-height:.97;margin-top:26px}h1 em,h2 em{color:var(--olive)}.header-note{position:absolute;right:4%;bottom:8px;transform:rotate(-4deg);font:26px/1.3 'Caveat',cursive;color:#8a8e72}.about-introduction{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(25px,5vw,85px);align-items:center;margin:48px 0 70px}.maker-intro{display:flex;align-items:center;gap:26px}.profile{width:145px;flex:none;position:relative;padding:8px 8px 0;background:#fffaf0;margin:0;transform:rotate(4deg);box-shadow:0 7px 20px #4d49331a}.profile:before{content:'';position:absolute;width:65px;height:20px;left:40px;top:-9px;background:#c6cdab99;transform:rotate(-9deg);z-index:1}.profile img{width:100%;height:155px;object-fit:cover;object-position:57% 54%}.profile figcaption{font:20px/1.6 'Caveat',cursive;text-align:center;color:var(--olive)}.maker-intro .eyebrow{font-size:8px;color:var(--olive);margin-bottom:13px}.maker-intro h2{font-size:clamp(26px,2.8vw,39px);line-height:1.1;letter-spacing:-.03em}.introduction-copy{font-size:14px;line-height:1.9;color:var(--muted);margin:28px 0}.story-tabs{display:flex;gap:22px;border-bottom:1px solid var(--line);margin-bottom:24px}.story-tabs button{background:none;min-height:48px;font-size:12px;padding:8px 0;color:var(--muted);border-bottom:2px solid transparent;margin-bottom:-1px}.story-tabs button[aria-selected=true]{color:var(--ink);border-color:var(--orange)}.story-page h3{font:30px/1.15 var(--font-display);margin-bottom:16px}.story-page>p:not(.pencil-note){font-size:13px;line-height:1.95;color:var(--muted)}.pencil-note{font:25px/1.3 'Caveat',cursive;color:#a56b4e;margin:22px 0}.story-page>a{display:inline-flex;align-items:center;gap:18px;min-height:44px;font-size:11px;text-decoration:none;color:#576b4e}.story-page+.story-page{margin-top:28px}[data-about-ready] .story-pages{min-height:310px}[data-about-ready] .story-page{margin-top:0}.about-interests{padding-top:30px;border-top:1px solid var(--line)}.about-interests>.eyebrow{font-size:9px;color:var(--olive)}.about-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:45px;margin-top:28px}.about-grid article>span{font-size:9px;color:var(--orange)}.about-grid h3{font:30px var(--font-display);margin:14px 0 12px}.about-grid p{font-size:13px;line-height:1.8;color:var(--muted);max-width:350px}.about-next{border-top:1px solid var(--line);margin-top:50px;padding-top:32px;display:flex;align-items:center;justify-content:space-between;gap:24px}.about-next p{font:italic 27px var(--font-display);color:var(--olive)}.about-next>div{display:flex;gap:24px;align-items:center}@media(max-width:850px){.header-note{font-size:22px;right:0}.about-introduction{gap:25px}.maker-intro{gap:18px}.profile{width:112px}.profile img{height:127px}.maker-intro h2{font-size:27px}.story-tabs{gap:15px}.story-tabs button{font-size:11px}}@media(max-width:650px){.about-page{padding-top:40px}.about-header h1{font-size:58px}.header-note{position:static;margin-top:22px;transform:none;font-size:23px}.about-introduction{grid-template-columns:1fr;margin-top:15px;gap:24px}.maker-intro{gap:24px}.profile{width:132px}.profile img{height:145px}.maker-intro h2{font-size:29px}.story-tabs{justify-content:space-between;gap:10px}.story-tabs button{font-size:12px}[data-about-ready] .story-pages{min-height:350px}.about-grid{grid-template-columns:1fr;gap:28px}.about-next{align-items:start;flex-direction:column}.about-next p{font-size:25px}.about-introduction{margin-bottom:35px}}
</style>
<style>
.social-notes{margin-top:30px;padding-top:21px;border-top:1px solid var(--line)}.social-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}.social-heading h2{font-size:clamp(27px,2.3vw,36px);line-height:1.08;letter-spacing:-.025em}.social-heading>span{font:31px 'Caveat',cursive;color:#a56b4e;transform:rotate(8deg)}.social-stack{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.social-paper{position:relative;display:flex;align-items:center;gap:10px;min-width:0;min-height:88px;padding:17px 12px 13px;background:#ebe6cf;border:1px solid #d8d0ad;color:var(--ink);text-decoration:none;box-shadow:0 5px 12px #3e432b12;transition:transform .2s,box-shadow .2s}.social-paper:before{content:'';position:absolute;width:38px;height:10px;left:calc(50% - 19px);top:-6px;background:#c6cdab99;transform:rotate(-3deg)}.social-paper:nth-child(1){transform:rotate(-1.5deg)}.social-paper:nth-child(2){background:#e3ebdf;border-color:#c9d5c4;transform:translateY(4px) rotate(1deg)}.social-paper:nth-child(3){background:#efe0d6;border-color:#dfc6b8;transform:rotate(-.7deg)}.social-paper:hover{transform:translateY(-4px) rotate(0);box-shadow:0 9px 18px #3e432b1c}.social-mark{display:grid;place-items:center;width:31px;height:31px;flex:0 0 31px;border:1px solid currentColor;border-radius:50%}.social-mark :global(.social-logo){display:block}.social-paper>span:nth-child(2){display:grid;gap:3px;min-width:0}.social-paper small{font-size:7px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.social-paper strong{overflow:hidden;text-overflow:ellipsis;font-size:9px;font-weight:500;white-space:nowrap}.social-arrow{position:absolute;right:7px;top:7px;color:#a56b4e;font-size:13px}@media(max-width:1000px) and (min-width:651px){.social-stack{grid-template-columns:1fr}.social-paper{min-height:64px;padding-block:12px}}@media(max-width:650px){.social-notes{margin-top:24px;padding-top:18px}.social-heading{margin-bottom:15px}.social-stack{gap:8px}.social-paper{min-height:82px;padding-inline:9px;display:grid;justify-items:center;text-align:center}.social-paper>span:nth-child(2){justify-items:center}.social-paper strong{max-width:92px}.social-arrow{display:none}}
</style>
<style>
.story-copy{display:grid;gap:12px}.story-copy p{font-size:13px;line-height:1.85;color:var(--muted)}.personal-journey{margin-top:25px;padding-top:20px;border-top:1px solid var(--line)}.personal-journey>.eyebrow{font-size:8px;color:var(--olive);letter-spacing:.18em;margin-bottom:16px}.personal-journey ol{display:grid;gap:0;list-style:none;margin:0;padding:0}.personal-journey li{position:relative;display:grid;grid-template-columns:92px minmax(0,1fr);gap:15px;padding:0 0 17px 18px}.personal-journey li:not(:last-child):before{content:'';position:absolute;left:4px;top:10px;bottom:-1px;border-left:1px dashed #aab294}.personal-journey li:after{content:'';position:absolute;left:0;top:5px;width:9px;height:9px;border:2px solid #f8f5eb;border-radius:50%;background:#bd5837;box-shadow:0 0 0 1px #bd5837}.personal-journey li>span{padding-top:2px;font-size:7px;line-height:1.4;letter-spacing:.12em;color:#9a6b51}.personal-journey h4{font:19px/1.1 var(--font-display);color:var(--ink);margin-bottom:5px}.personal-journey li p{font-size:11px;line-height:1.55;color:var(--muted)}@media(max-width:650px){.story-copy p{font-size:13px;line-height:1.8}.personal-journey li{grid-template-columns:78px minmax(0,1fr);gap:10px;padding-left:17px}.personal-journey h4{font-size:18px}}
</style>
<style>
.about-introduction{align-items:start;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:clamp(30px,5vw,75px)}.profile-main{width:100%;padding:12px 12px 0;transform:rotate(-1.5deg)}.profile-main img{width:100%;height:clamp(520px,49vw,700px);object-fit:cover;object-position:62% 50%}.profile-main:before{width:115px;height:28px;left:calc(50% - 58px);top:-14px}.profile-main figcaption{font-size:26px;line-height:2}.maker-story{position:relative;padding:18px 0 0;min-width:0}.header-note{font-size:23px}[data-about-ready] .story-pages{min-height:320px}@media(max-width:650px){.about-introduction{grid-template-columns:1fr;gap:38px;margin-top:35px}.profile-main{width:100%;padding:8px 8px 0}.profile-main img{height:470px}.profile-main figcaption{font-size:23px}.maker-story{padding-top:0;padding-bottom:0}.maker-intro h2{font-size:35px}}
</style>
