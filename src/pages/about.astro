---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Myko from '../components/Myko.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/about/profile.jpg';
import '@fontsource/caveat/400.css';
const chapters=[
  {id:'story',label:'My story',stage:'spore',expression:'happy',myko:'That’s where it all started.',title:'Where data meets cultivation.',text:'',note:'',href:'',link:''},
  {id:'build',label:'What I build',stage:'mycelium',expression:'curious',myko:'PVC, sensors and patience.',title:'Making an idea tangible.',text:'I couldn’t find a Martha tent locally in Egypt, so I built the structure from PVC pipes. From cutting and reinforcing the frame to connecting sensors and writing software, this project has been a sequence of small decisions, practical problems, and things learnt along the way.',note:'Measure. Make. Learn. Try again.',href:'/documentation/#notebook-journey',link:'Follow the build'},
  {id:'explore',label:'What I’m exploring',stage:'fruiting',expression:'curious',myko:'So many questions. Good ones.',title:'Still plenty of questions.',text:'I’m exploring how controlled conditions affect mushroom yield and health, and how scheduled photographs and computer vision can help document growth. The field notes hold the decisions and observations, including the attempts that didn’t go to plan.',note:'The unfinished parts belong in the notebook, too.',href:'/documentation/#notebook-vision',link:'Visit the vision lab'},
];
const personalJourney=[
  {stage:'EARLY YEARS',place:'Riyadh, Saudi Arabia',detail:'Born and raised in Riyadh, where I lived through elementary school.',myko:'So dry! My moss would crisp.',mood:'melancholic'},
  {stage:'SCHOOL YEARS',place:'Cairo, Egypt',detail:'Continued my education in Cairo through secondary school.',myko:'Cairo! Sunny. Very sunny.',mood:'happy'},
  {stage:'UNIVERSITY',place:'Kuala Lumpur, Malaysia',detail:'Earned my bachelor’s degree in Computer Science and Artificial Intelligence from the University of Malaya.',myko:'So humid. Mushrooms would love it.',mood:'happy'},
];
// Each journey stop inks a thread down to the next one; its side branch stops dead, like the attempts that didn't go to plan.
const threads=[
  {main:'M4.5 0C9 18 0 36 5 55S8 84 4.5 100',branch:'M5 50C15 53 21 62 33 63S49 70 55 77',tip:'M55 77h.01'},
  {main:'M4.5 0C0 20 9 40 4 60S2 88 4.5 100',branch:'M4.5 64C13 67 17 76 29 79Q37 81 42 86',tip:'M42 86h.01'},
  {main:'M4.5 0C8 25 1 45 5 65S7 90 4.5 100',branch:'M5 42C17 45 24 41 36 48S48 50 52 57',tip:'M52 57h.01'},
];
const socials=[
  {name:'X',handle:'@mycolabz',icon:'x',href:'https://x.com/mycolabz',className:'social-x'},
  {name:'LinkedIn',handle:'Omar Ahmad',icon:'linkedin',href:'https://www.linkedin.com/in/omar-ahmad-916378186/',className:'social-linkedin'},
  {name:'TikTok',handle:'@mycolabs',icon:'tiktok',href:'https://www.tiktok.com/@mycolabs',className:'social-tiktok'},
];
---
<BaseLayout title="About Me | Smart Mushroom Hub" description="Meet the maker behind Smart Mushroom Hub, and Myko, a little companion for a growing experiment.">
  <article class="about-page" data-about-page>
    <header class="about-header"><p class="eyebrow"><span class="eyebrow-dot"></span> THE PERSON BEHIND THE HABITAT</p><h1>Omar Ahmad</h1></header>
    <div class="about-introduction">
      <figure class="profile profile-main" data-myko-glance="That peacock was taller than me." data-myko-mood="curious"><Image src={portrait} alt="The maker of Smart Mushroom Hub beside a peacock" widths={[640,1000,1400]} sizes="(max-width:650px) 92vw, 48vw" width={1400} format="webp" quality={85} loading="eager" /><figcaption>the person behind the experiment</figcaption></figure>
      <section class="maker-story" aria-label="About the maker">
        <div class="story-tabs" role="tablist" aria-label="Read about the maker" hidden>{chapters.map((chapter,i)=><button type="button" role="tab" id={`tab-${chapter.id}`} aria-controls={`story-${chapter.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-story={chapter.id} data-expression={chapter.expression} data-myko-line={chapter.myko}>{chapter.label}<span class="stage-note" aria-hidden="true">{chapter.stage}</span></button>)}</div>
        <div class="story-pages">
          <svg class="growth" viewBox="0 0 100 100" aria-hidden="true" data-growth data-grow="0">
            <path class="soil" d="M6 84Q28 82.5 50 84T94 83.5"/>
            <g class="spores"><circle cx="50" cy="81" r="3.1"/><circle class="drift" cx="36" cy="60" r="2.4"/><circle class="drift" cx="62" cy="46" r="2"/><circle class="drift" cx="45" cy="31" r="1.6"/><circle class="drift" cx="70" cy="24" r="1.2"/></g>
            <path class="hypha" pathLength="1" d="M50 84Q44 90 34 91Q26 92 20 97"/><path class="hypha" pathLength="1" d="M50 84Q57 91 68 90Q77 89 83 95"/><path class="hypha" pathLength="1" d="M50 84Q51 92 49 99"/>
            <path class="hypha late" pathLength="1" d="M34 91Q33 96 30 99"/><path class="hypha late" pathLength="1" d="M68 90Q70 95 74 99"/><path class="hypha late" pathLength="1" d="M20 97Q14 95 9 97"/><path class="hypha late" pathLength="1" d="M83 95Q88 93 93 95"/>
            <path class="stem" pathLength="1" d="M47 84Q49 70 47.5 58"/><path class="stem" pathLength="1" d="M53 84Q51.5 70 53 58"/>
            <path class="cap" pathLength="1" d="M30 59Q32 37 50 35Q68 37 70 59Q50 54 30 59"/>
            <path class="gills" pathLength="1" d="M37 58L45 55.5"/><path class="gills" pathLength="1" d="M44 57.5L48 55.6"/><path class="gills" pathLength="1" d="M56 57.5L52 55.6"/><path class="gills" pathLength="1" d="M63 58L55 55.5"/>
          </svg>
          {chapters.map(chapter=><section class="story-page" id={`story-${chapter.id}`} data-story-page={chapter.id} aria-labelledby={`heading-${chapter.id}`}><h3 id={`heading-${chapter.id}`}>{chapter.title}</h3>{chapter.id==='story'?<><div class="story-copy"><p>I’m a data analyst with a passion for farming. My work has taught me to look for patterns, ask questions, and learn from evidence. Farming gives that curiosity a living context.</p><p>I have been fascinated by mushrooms since I first learned how they grow, and honestly, how could you not be? Their unusual shapes, vivid colours, and varied habitats can make them seem almost extraterrestrial. Some fungi can even take over living insects, so yes: zombies are real, in a way.</p><p>This project brings those interests together through cultivation, technology, observation, and experimentation.</p></div><section class="personal-journey" aria-labelledby="personal-journey-heading" data-journey><p class="eyebrow" id="personal-journey-heading">MY JOURNEY</p><ol>
            {personalJourney.map((item,i)=><li style={`--i:${i}`} data-myko-glance={item.myko} data-myko-mood={item.mood}><svg class="thread" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path class="main" pathLength="1" d={threads[i].main}/><path class="branch" pathLength="1" d={threads[i].branch}/><path class="tip" d={threads[i].tip}/></svg><span>{item.stage}</span><div><h4>{item.place}</h4><p>{item.detail}</p></div></li>)}
            <li class="journey-today" style={`--i:${personalJourney.length}`} data-myko-glance="That’s where I live!" data-myko-mood="happy"><svg class="journey-mushroom" viewBox="6 6 32 30" aria-hidden="true"><path d="M8 23c0-8 6-15 14-15s14 7 14 15H8Z"/><path d="M18 23v9c0 3 8 3 8 0v-9"/></svg><span>TODAY</span><div><h4><a href="/documentation/">The habitat<Icon name="arrow-right" size={14}/></a></h4><p>Building a mushroom habitat and documenting it in the field notes.</p></div></li>
          </ol></section></>:<><p>{chapter.text}</p><p class="pencil-note">{chapter.note}</p><a href={chapter.href}>{chapter.link}<Icon name="arrow-right" size={15}/></a></>}</section>)}
        </div>
        <section class="social-notes" aria-labelledby="social-notes-heading">
          <div class="social-heading"><h2 id="social-notes-heading">Find me <em>elsewhere.</em></h2><span aria-hidden="true">↘</span></div>
          <nav class="social-stack" aria-label="Omar’s social profiles">
            {socials.map(social => <a class={`social-paper ${social.className}`} href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`${social.name}: ${social.handle}`}><span class="social-mark" aria-hidden="true"><Icon name={social.icon} size={17} class="social-logo" /></span><span><small>{social.name}</small><strong>{social.handle}</strong></span><span class="social-arrow" aria-hidden="true">↗</span></a>)}
          </nav>
        </section>
      </section>
    </div>
    <Myko />
  </article>
</BaseLayout>
<script>import '../scripts/about-page';</script>
<style>
.about-page{width:min(1450px,calc(100% - 2 * var(--page-pad)));margin:auto;padding:65px 0 85px}.about-header{position:relative}.about-header .eyebrow{font-size:9px;color:var(--olive)}h1{font-size:clamp(55px,6.4vw,92px);letter-spacing:-.05em;line-height:.97;margin-top:26px}h1 em,h2 em{color:var(--olive)}.header-note{position:absolute;right:4%;bottom:8px;transform:rotate(-4deg);font:26px/1.3 'Caveat',cursive;color:#8a8e72}.about-introduction{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(25px,5vw,85px);align-items:center;margin:48px 0 70px}.maker-intro{display:flex;align-items:center;gap:26px}.profile{width:145px;flex:none;position:relative;padding:8px 8px 0;background:#fffaf0;margin:0;transform:rotate(4deg);box-shadow:0 7px 20px #4d49331a}.profile:before{content:'';position:absolute;width:65px;height:20px;left:40px;top:-9px;background:#c6cdab99;transform:rotate(-9deg);z-index:1}.profile img{width:100%;height:155px;object-fit:cover;object-position:57% 54%}.profile figcaption{font:20px/1.6 'Caveat',cursive;text-align:center;color:var(--olive)}.maker-intro .eyebrow{font-size:8px;color:var(--olive);margin-bottom:13px}.maker-intro h2{font-size:clamp(26px,2.8vw,39px);line-height:1.1;letter-spacing:-.03em}.introduction-copy{font-size:14px;line-height:1.9;color:var(--muted);margin:28px 0}.story-tabs{display:flex;gap:22px;border-bottom:1px solid var(--line);margin-bottom:24px}.story-tabs button{background:none;min-height:48px;font-size:12px;padding:8px 0;color:var(--muted);border-bottom:2px solid transparent;margin-bottom:-1px}.story-tabs button[aria-selected=true]{color:var(--ink);border-color:var(--orange)}.story-page h3{font:30px/1.15 var(--font-display);margin-bottom:16px}.story-page>p:not(.pencil-note){font-size:13px;line-height:1.95;color:var(--muted)}.pencil-note{font:25px/1.3 'Caveat',cursive;color:#a56b4e;margin:22px 0}.story-page>a{display:inline-flex;align-items:center;gap:18px;min-height:44px;font-size:11px;text-decoration:none;color:#576b4e}.story-page+.story-page{margin-top:28px}[data-about-ready] .story-pages{min-height:310px}[data-about-ready] .story-page{margin-top:0}.about-interests{padding-top:30px;border-top:1px solid var(--line)}.about-interests>.eyebrow{font-size:9px;color:var(--olive)}.about-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:45px;margin-top:28px}.about-grid article>span{font-size:9px;color:var(--orange)}.about-grid h3{font:30px var(--font-display);margin:14px 0 12px}.about-grid p{font-size:13px;line-height:1.8;color:var(--muted);max-width:350px}.about-next{border-top:1px solid var(--line);margin-top:50px;padding-top:32px;display:flex;align-items:center;justify-content:space-between;gap:24px}.about-next p{font:italic 27px var(--font-display);color:var(--olive)}.about-next>div{display:flex;gap:24px;align-items:center}@media(max-width:850px){.header-note{font-size:22px;right:0}.about-introduction{gap:25px}.maker-intro{gap:18px}.profile{width:112px}.profile img{height:127px}.maker-intro h2{font-size:27px}.story-tabs{gap:15px}.story-tabs button{font-size:11px}}@media(max-width:650px){.about-page{padding-top:40px}.about-header h1{font-size:58px}.header-note{position:static;margin-top:22px;transform:none;font-size:23px}.about-introduction{grid-template-columns:1fr;margin-top:15px;gap:24px}.maker-intro{gap:24px}.profile{width:132px}.profile img{height:145px}.maker-intro h2{font-size:29px}.story-tabs{justify-content:space-between;gap:10px}.story-tabs button{font-size:12px}[data-about-ready] .story-pages{min-height:350px}.about-grid{grid-template-columns:1fr;gap:28px}.about-next{align-items:start;flex-direction:column}.about-next p{font-size:25px}.about-introduction{margin-bottom:35px}}
</style>
<style>
.social-notes{margin-top:30px;padding-top:21px;border-top:1px solid var(--line)}.social-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}.social-heading h2{font-size:clamp(27px,2.3vw,36px);line-height:1.08;letter-spacing:-.025em}.social-heading>span{font:31px 'Caveat',cursive;color:#a56b4e;transform:rotate(8deg)}.social-stack{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.social-paper{position:relative;display:flex;align-items:center;gap:10px;min-width:0;min-height:88px;padding:17px 12px 13px;background:#ebe6cf;border:1px solid #d8d0ad;color:var(--ink);text-decoration:none;box-shadow:0 5px 12px #3e432b12;transition:transform .2s,box-shadow .2s}.social-paper:before{content:'';position:absolute;width:38px;height:10px;left:calc(50% - 19px);top:-6px;background:#c6cdab99;transform:rotate(-3deg)}.social-paper:nth-child(1){transform:rotate(-1.5deg)}.social-paper:nth-child(2){background:#e3ebdf;border-color:#c9d5c4;transform:translateY(4px) rotate(1deg)}.social-paper:nth-child(3){background:#efe0d6;border-color:#dfc6b8;transform:rotate(-.7deg)}.social-paper:hover{transform:translateY(-4px) rotate(0);box-shadow:0 9px 18px #3e432b1c}.social-mark{display:grid;place-items:center;width:31px;height:31px;flex:0 0 31px;border:1px solid currentColor;border-radius:50%}.social-mark :global(.social-logo){display:block}.social-paper>span:nth-child(2){display:grid;gap:3px;min-width:0}.social-paper small{font-size:7px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.social-paper strong{overflow:hidden;text-overflow:ellipsis;font-size:9px;font-weight:500;white-space:nowrap}.social-arrow{position:absolute;right:7px;top:7px;color:#a56b4e;font-size:13px}@media(max-width:1000px) and (min-width:651px){.social-stack{grid-template-columns:1fr}.social-paper{min-height:64px;padding-block:12px}}@media(max-width:650px){.social-notes{margin-top:24px;padding-top:18px}.social-heading{margin-bottom:15px}.social-stack{gap:8px}.social-paper{min-height:82px;padding-inline:9px;display:grid;justify-items:center;text-align:center}.social-paper>span:nth-child(2){justify-items:center}.social-paper strong{max-width:92px}.social-arrow{display:none}}
</style>
<style>
.story-copy{display:grid;gap:12px}.story-copy p{font-size:13px;line-height:1.85;color:var(--muted)}.personal-journey{margin-top:25px;padding-top:20px;border-top:1px solid var(--line)}.personal-journey>.eyebrow{font-size:8px;color:var(--olive);letter-spacing:.18em;margin-bottom:16px}.personal-journey ol{display:grid;gap:0;list-style:none;margin:0;padding:0}.personal-journey li{position:relative;display:grid;grid-template-columns:92px minmax(0,1fr);gap:15px;padding:0 0 17px 18px}.personal-journey li:after{content:'';position:absolute;z-index:1;left:0;top:4px;width:10px;height:10px;border:1.6px solid #7b6f55;border-radius:50%;background:var(--paper);transition:border-color .25s,box-shadow .25s}.personal-journey li:first-child:after{background:#7b6f55;box-shadow:0 0 0 2.5px var(--paper),0 0 0 3.6px #7b6f5566}.personal-journey li>span{padding-top:2px;font-size:7px;line-height:1.4;letter-spacing:.12em;color:#9a6b51}.personal-journey h4{font:19px/1.1 var(--font-display);color:var(--ink);margin-bottom:5px}.personal-journey li p{font-size:11px;line-height:1.55;color:var(--muted)}@media(max-width:650px){.story-copy p{font-size:13px;line-height:1.8}.personal-journey li{grid-template-columns:78px minmax(0,1fr);gap:10px;padding-left:17px}.personal-journey h4{font-size:18px}}
</style>
<style>
.about-introduction{align-items:start;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:clamp(30px,5vw,75px)}.profile-main{width:100%;padding:12px 12px 0;transform:rotate(-1.5deg)}.profile-main img{width:100%;height:clamp(520px,49vw,700px);object-fit:cover;object-position:62% 50%}.profile-main:before{width:115px;height:28px;left:calc(50% - 58px);top:-14px}.profile-main figcaption{font-size:26px;line-height:2}.maker-story{position:relative;padding:18px 0 0;min-width:0}.header-note{font-size:23px}[data-about-ready] .story-pages{min-height:320px}@media(max-width:650px){.about-introduction{grid-template-columns:1fr;gap:38px;margin-top:35px}.profile-main{width:100%;padding:8px 8px 0}.profile-main img{height:470px}.profile-main figcaption{font-size:23px}.maker-story{padding-top:0;padding-bottom:0}.maker-intro h2{font-size:35px}}
</style>
<style>
/* Life cycle: each chapter is a growth stage, drawn in ink at 12 frames a second like Myko's stop-motion film. */
.story-tabs button{position:relative}.stage-note{position:absolute;left:0;top:-9px;font:15px/1 'Caveat',cursive;letter-spacing:0;color:#a59a7c;transform:rotate(-4deg);white-space:nowrap;pointer-events:none;transition:color .2s}.story-tabs button[aria-selected=true] .stage-note{color:#a56b4e}
.growth{float:right;width:96px;height:96px;margin:-10px 0 6px 18px;fill:none;stroke:#7b6f55;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;overflow:visible}.growth .soil{stroke:#c3bba0;stroke-width:1.4}.growth .spores circle{fill:#7b6f55;stroke:none;transition:opacity .35s steps(4)}.growth:not([data-grow="0"]) .drift{opacity:0}
.growth [pathLength]{stroke-dasharray:1 1.1;stroke-dashoffset:1.02;transition:stroke-dashoffset .75s steps(9)}.growth[data-grow="1"] .hypha,.growth[data-grow="2"] .hypha,.growth[data-grow="2"] .stem,.growth[data-grow="2"] .cap,.growth[data-grow="2"] .gills{stroke-dashoffset:0}
.growth[data-grow="1"] .late,.growth[data-grow="2"] .late{transition-delay:.45s}.growth[data-grow="2"] .stem{transition-delay:.25s}.growth[data-grow="2"] .cap{transition-delay:.85s}.growth[data-grow="2"] .gills{transition-delay:1.45s}
/* Journey: an inked mycelium thread from stop to stop that draws itself once in view, ending at the habitat. */
.thread{position:absolute;left:0;top:9px;width:100px;height:100%;overflow:visible;pointer-events:none;fill:none;stroke:#8c8468;stroke-width:1.3;stroke-linecap:round;transition:stroke .25s}.thread path{vector-effect:non-scaling-stroke}.thread .branch{stroke:#aaa287;stroke-width:1}.thread .tip{stroke-width:3.4}
.personal-journey[data-thread] .thread [pathLength]{stroke-dasharray:1 1.1;stroke-dashoffset:1.02}.personal-journey[data-thread] .thread .tip{opacity:0}
.personal-journey[data-thread=grown] .thread [pathLength]{stroke-dashoffset:0;transition:stroke-dashoffset .8s steps(10) calc(var(--i) * .8s)}.personal-journey[data-thread=grown] .thread .branch{transition-delay:calc(var(--i) * .8s + .55s)}.personal-journey[data-thread=grown] .thread .tip{opacity:1;transition:opacity 0s calc(var(--i) * .8s + 1.35s)}
.personal-journey li:hover .thread,.personal-journey li:focus-within .thread{stroke:#46aebd}.personal-journey li:hover:after,.personal-journey li:focus-within:after{border-color:#46aebd;box-shadow:0 0 0 3px #98e3eb59,0 0 10px 2px #59ddeb66}.personal-journey li:first-child:hover:after{background:#46aebd}
/* Social cards carry a spore print: long gills with short ones between, left under the logo like a cap lifted off paper. */
.social-mark{position:relative;--print-size:-16px}.social-mark:before,.social-mark:after{content:'';position:absolute;inset:var(--print-size);z-index:-1;border-radius:50%;pointer-events:none;opacity:.34;transition:opacity .35s,transform .6s cubic-bezier(.34,1.56,.64,1)}
.social-mark:before{background:repeating-conic-gradient(from 2deg,var(--print) 0 .8deg,transparent .8deg 6deg),radial-gradient(circle,transparent 30%,color-mix(in srgb,var(--print) 22%,transparent) 46%,transparent 71%);-webkit-mask:radial-gradient(circle,transparent 0 23%,#000 25%,#000 58%,transparent 71%);mask:radial-gradient(circle,transparent 0 23%,#000 25%,#000 58%,transparent 71%)}
.social-mark:after{background:repeating-conic-gradient(from 5deg,var(--print) 0 .6deg,transparent .6deg 6deg);-webkit-mask:radial-gradient(circle,transparent 0 42%,#000 46%,#000 56%,transparent 69%);mask:radial-gradient(circle,transparent 0 42%,#000 46%,#000 56%,transparent 69%)}
.social-paper:nth-child(1){--print:#5b4630}.social-paper:nth-child(2){--print:#3f5a45}.social-paper:nth-child(3){--print:#8a4631}
.social-paper:hover .social-mark:before,.social-paper:hover .social-mark:after,.social-paper:focus-visible .social-mark:before,.social-paper:focus-visible .social-mark:after{opacity:.58;transform:rotate(4deg) scale(1.04)}
.social-paper{gap:18px;padding-left:21px}@media(max-width:1000px) and (min-width:651px){.social-mark{--print-size:-15px}}@media(max-width:650px){.social-paper{gap:0;padding-left:9px}.social-mark{--print-size:-13px;margin-bottom:13px}}
.journey-today:after{content:none!important}.journey-mushroom{position:absolute;z-index:1;left:-4.5px;top:-3px;width:19px;height:19px;fill:var(--paper);stroke:#7b6f55;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;transition:stroke .25s,filter .25s}.journey-today:hover .journey-mushroom,.journey-today:focus-within .journey-mushroom{stroke:#46aebd;filter:drop-shadow(0 0 5px #59ddeb99)}
.journey-today h4 a{display:inline-flex;align-items:center;gap:8px;color:inherit;text-decoration:none;border-bottom:1px solid #cfc7ad;padding-bottom:1px;transition:color .2s,border-color .2s}.journey-today h4 a:hover{color:#a05437;border-color:currentColor}
@media(max-width:650px){.growth{width:74px;height:74px;margin:-6px 0 4px 12px}.thread{width:86px}}@media(prefers-reduced-motion:reduce){.growth [pathLength],.growth .spores circle,.personal-journey .thread [pathLength],.personal-journey .thread .tip{transition:none!important}}
</style>
