---
import FieldNotebook from '../components/FieldNotebook.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ResourceLink from '../components/ResourceLink.astro';
import { site } from '../config/site';

const contents = [
  { id: 'overview', title: 'The experiment' },
  { id: 'physical-setup', title: 'The physical setup' },
  { id: 'software', title: 'Services & system flow' },
  { id: 'camera-schedules', title: 'The camera schedule' },
  { id: 'computer-vision', title: 'Computer vision' },
  { id: 'publication', title: 'What the website publishes' },
  { id: 'limitations', title: 'Limitations & open work' },
];

const hardware = [
  ['Computing', 'Raspberry Pi 5, 16 GB RAM; Raspberry Pi AI HAT 2 with a Hailo-10H accelerator.'],
  ['Environment', 'Two SHT31 temperature/humidity sensors and two SCD41 CO₂ sensors: one of each for the tent and the ambient room.'],
  ['Imaging', 'Two Raspberry Pi Camera Module 3 Wide cameras, identified as controlled_camera and ambient_camera.'],
  ['Ventilation', 'Thermalright TL-C12C-S V3 120 mm PWM fan, mounted at the top of the tent.'],
  ['Moisture & light', 'Xiaomi Humidifier 2, connected by a flexible duct and controlled through Miot; approximately one metre of LED lighting.'],
  ['Power & storage', 'Schneider BVS 800 VA UPS, MOSFET switching modules housed in enclosures, and SSD storage in a UGREEN enclosure.'],
];
---

<BaseLayout title="System notes — Smart Mushroom Hub" description="Documented hardware, service architecture, camera schedules, and research limitations for the Smart Mushroom Hub cultivation experiment.">
  <div class="documentation-page section-wrap">
    <a href="/#experiment" class="return-link"><span aria-hidden="true">←</span> Back to the experiment</a>

    <FieldNotebook />
    <header id="reference-notes" class="reference-heading"><p class="eyebrow">THE REFERENCE SHELF</p><h2>The details behind the pages.</h2><p>Hardware, schedules, software, and the limits of what we know.</p></header>

    <div class="documentation-layout">
      <aside class="documentation-sidebar">
        <nav aria-label="Documentation contents">
          <p class="eyebrow">IN THIS NOTEBOOK</p>
          <ol>
            {contents.map((item, index) => <li><a href={`#${item.id}`}><span>0{index + 1}</span>{item.title}</a></li>)}
          </ol>
          <a href="/#architecture" class="diagram-link">Explore the system diagram <Icon name="arrow-up-right" size={15} /></a>
        </nav>
      </aside>

      <article class="documentation-content" aria-label="System documentation">
        <div class="document-context">
          <Icon name="book" size={19} />
          <p>These notes describe the setup and design recorded in the project brief. They are an editorial snapshot, not a verification of current device operation or service status.</p>
        </div>

        <section id="overview" aria-labelledby="overview-heading">
          <p class="section-number">01 / THE EXPERIMENT</p>
          <h2 id="overview-heading">Cultivation as a way to learn.</h2>
          <p>Smart Mushroom Hub brings oyster mushroom cultivation together with environmental sensing, partial automation and computer vision. Hanging bags of pasteurized straw grow inside a compact tent, while a second sensor set records the surrounding room.</p>
          <p>The room provides an ambient environmental reference. The documented setup does not establish a separate biological control crop, so environmental comparisons alone cannot establish the effect of a particular intervention on yield or growth.</p>
          <p>The research question is practical: how do environmental conditions, controller decisions and visible changes in the substrate relate over the course of cultivation? The first incubation phase began on 28 July 2026.</p>
        </section>

        <section id="physical-setup" aria-labelledby="physical-heading">
          <p class="section-number">02 / THE PHYSICAL SETUP</p>
          <h2 id="physical-heading">A tent, with room for curiosity.</h2>
          <p>The documented frame is approximately <strong>185 cm high × 82 cm wide × 55 cm deep</strong>, built from 1.5-inch PVC pipe with diagonal reinforcement. Plastic covering, zippered access and acrylic camera windows enclose the growing space.</p>
          <dl class="hardware-list">
            {hardware.map(([name, detail]) => <div><dt>{name}</dt><dd>{detail}</dd></div>)}
          </dl>
          <p class="small-note">The website illustration simplifies cable routing and component placement for explanation. It is not an electrical wiring diagram or a pin assignment reference.</p>
        </section>

        <section id="software" aria-labelledby="software-heading">
          <p class="section-number">03 / SERVICES & SYSTEM FLOW</p>
          <h2 id="software-heading">Three paths through one system.</h2>
          <p>The Raspberry Pi hosts Python services alongside Docker containers. Mosquitto handles MQTT messages, TimescaleDB/PostgreSQL stores experiment history, Grafana displays that data, and Home Assistant provides device visibility and manual control within the experiment system.</p>
          <div class="path-notes">
            <div><span>01</span><div><h3>Observe</h3><p>Sensor services publish temperature, humidity and CO₂ measurements through MQTT. A database writer stores the readings in TimescaleDB. Grafana queries the stored history.</p></div></div>
            <div><span>02</span><div><h3>Respond</h3><p>Environment and lighting controllers evaluate readings and cultivation-phase settings. Commands pass through MQTT to device services, which operate ventilation, humidification and lighting.</p></div></div>
            <div><span>03</span><div><h3>Record</h3><p>A phase-aware scheduler triggers still-image capture. Images remain in local media storage; selected photographs and produced timelapses can later be published with the research.</p></div></div>
          </div>
          <h3>How the services are organized</h3>
          <p>Dedicated systemd services manage the sensor publisher, database writer, environment controller, lighting controller and actuators. Camera capture uses a one-shot service and a timer that checks for scheduled work approximately once per minute.</p>
          <p>Phase settings provide the context for control decisions. Environmental targets, lighting schedules and capture schedules can change between incubation and later cultivation stages.</p>
          <a href="/#architecture" class="text-link">Follow the illustrated system flow <Icon name="arrow-right" size={16} /></a>
        </section>

        <section id="camera-schedules" aria-labelledby="camera-heading">
          <p class="section-number">04 / THE CAMERA SCHEDULE</p>
          <h2 id="camera-heading">Watching at the pace of growth.</h2>
          <p>The cameras take scheduled still images. The design recorded in the brief uses the following capture intervals; the table describes that schedule and does not indicate that captures are currently arriving.</p>
          <div class="schedule-table-wrap" role="region" aria-label="Documented capture schedule" tabindex="0">
            <table>
              <caption>Documented, phase-dependent capture schedule</caption>
              <thead><tr><th scope="col">Cultivation phase</th><th scope="col">Tent camera</th><th scope="col">Ambient camera</th></tr></thead>
              <tbody>
                <tr><th scope="row">Incubation</th><td>Full-resolution still<br /><strong>Every 6 hours</strong></td><td>Full-resolution still<br /><strong>Every 6 hours</strong></td></tr>
                <tr><th scope="row">Pinning, fruiting & growth</th><td>Full-resolution still<br /><strong>Every 3 hours</strong></td><td>Full-resolution still<br /><strong>Every 6 hours</strong></td></tr>
                <tr><th scope="row">Timelapse frames during pinning, fruiting & growth</th><td>2304 × 1296 frame<br /><strong>Every 5 minutes</strong></td><td>No separate timelapse-frame schedule documented</td></tr>
              </tbody>
            </table>
          </div>
          <p>Full-resolution captures are 4608 × 2592 pixels. The scheduler aligns capture timing to the experiment timeline, and a separate timelapse-building process turns the selected frame sequence into a finished video.</p>
          <p class="small-note">A published photograph represents its capture time. A finished timelapse represents the interval used to produce it. Neither should be presented as a live camera stream.</p>
        </section>

        <section id="computer-vision" aria-labelledby="vision-heading">
          <p class="section-number">05 / COMPUTER VISION</p>
          <h2 id="vision-heading">Learning to recognize a mushroom.</h2>
          <p>A YOLOv8s model has been trained with <em>mushroom</em> as the primary class. The project brief reports an mAP50 of approximately 0.9443. This is a reported model-evaluation result, not a measure of deployed camera-system reliability.</p>
          <div class="status-note"><span class="status-label">TRAINED MODEL · EDGE DEPLOYMENT PLANNED</span><p>The Raspberry Pi AI HAT 2 and Hailo-10H accelerator are intended to support local inference. The brief does not establish that the complete capture-to-inference pipeline is deployed.</p></div>
          <p>Prepared detection examples can be published when actual model outputs are available. Claims about growth tracking, counting performance or inference reliability require their own evaluation. Illustrative mushroom artwork is not evidence of a model prediction or an experimental observation.</p>
        </section>

        <section id="publication" aria-labelledby="publication-heading">
          <p class="section-number">06 / WHAT THE WEBSITE PUBLISHES</p>
          <h2 id="publication-heading">The story here. The data in Grafana.</h2>
          <p>This site is a static research presentation. Its interactive tent, component highlights and animated routes explain the system visually. Authored text, selected camera images and finished videos are published as part of the site.</p>
          <p><strong>Grafana is responsible for displaying actual experiment measurements and history.</strong> The website provides a clearly labelled link to it. It does not query the experiment database, ingest sensor readings, compute aggregates or recreate Grafana panels.</p>
          <p>There is no experiment-data API, background polling, WebSocket connection, data cache or public-data manifest in the website. Publication is an editorial step: prepare the material, review its context, then publish the static site.</p>
          <ResourceLink href={site.grafanaUrl} resource="Grafana" class="button button-dark" label="View Data in Grafana" />
        </section>

        <section id="limitations" aria-labelledby="limitations-heading">
          <p class="section-number">07 / LIMITATIONS & OPEN WORK</p>
          <h2 id="limitations-heading">Keep the gaps in the story.</h2>
          <p>The documented experiment includes reliability problems and unresolved decisions. They matter when interpreting both the environmental record and the cultivation narrative.</p>
          <ul class="limitations-list">
            <li><strong>Shared sensor-service failure.</strong> By 31 August, the brief recorded that sensor history stopped after 24 August. Repeated SCD41 initialization failures appeared to terminate the shared publisher, interrupting records from the other sensors too. These dates describe the reported incident; they do not establish the current recovery status.</li>
            <li><strong>Service lifecycle issues.</strong> Previously inactive services required re-enabling. Restarting the camera timer once caused an unexpected additional capture, highlighting the need to review scheduling behavior around restarts.</li>
            <li><strong>Unsettled control settings.</strong> Final CO₂ thresholds were not established in the brief. A rejected configuration change, database constraints and retained MQTT message behavior required further review.</li>
            <li><strong>Limits of interpretation.</strong> A single cultivation setup and an ambient environmental reference cannot isolate every influence on growth. Missing measurements, sensor reliability, substrate variation and incomplete vision evaluation limit the conclusions that can be drawn.</li>
          </ul>
          <p>Research updates should distinguish observed results, working interpretations and planned improvements. Missing observations should remain explicit, and illustrative media should remain labelled.</p>
        </section>

        <div class="documentation-closing">
          <p>Return to the growing space.</p>
          <a href="/#material-study" class="text-link">Explore the interactive tent <Icon name="arrow-right" size={17} /></a>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .reference-heading{border-top:1px solid var(--line);padding-top:45px;scroll-margin-top:120px}.reference-heading .eyebrow{color:var(--olive)}.reference-heading h2{font-size:clamp(32px,4vw,46px);margin:17px 0 12px}.reference-heading>p:last-child{font-size:13px;color:var(--muted)}
  .documentation-page { padding-top: 35px; padding-bottom: 110px; }
  .return-link { display: inline-flex; align-items: center; gap: 12px; color: var(--muted); text-decoration: none; font-size: 11px; padding-block: 7px; }
  .return-link span { font-size: 18px; }
  .return-link:hover { color: var(--orange); }
  .documentation-layout { display: grid; grid-template-columns: 245px minmax(0, 700px); justify-content: space-between; column-gap: 70px; padding-top: 55px; }
  .documentation-sidebar nav { position: sticky; top: 35px; }
  .documentation-sidebar .eyebrow { color: var(--olive); font-size: 8px; letter-spacing: 1.5px; }
  .documentation-sidebar ol { list-style: none; margin: 18px 0 26px; padding: 0; }
  .documentation-sidebar li a { display: flex; align-items: baseline; gap: 13px; padding: 11px 0; font-size: 11px; line-height: 1.5; text-decoration: none; color: #52604f; }
  .documentation-sidebar li a > span { color: #959e87; font-size: 8px; }
  .documentation-sidebar li a:hover { color: var(--orange); }
  .diagram-link { display: inline-flex; align-items: center; gap: 10px; border-top: 1px solid var(--line); padding-top: 22px; font-size: 10px; text-decoration: none; color: var(--olive); }
  .document-context { display: flex; align-items: flex-start; gap: 15px; padding: 20px 23px; background: var(--paper-deep); border-left: 2px solid #9aa885; margin-bottom: 49px; }
  .document-context :global(svg) { flex-shrink: 0; margin-top: 2px; color: var(--olive); }
  .document-context p { font-size: 11px; line-height: 1.8; color: #626e59; }
  .documentation-content section { margin-bottom: 49px; padding-bottom: 45px; border-bottom: 1px solid var(--line); scroll-margin-top: 35px; }
  .section-number { font-size: 8px; font-weight: 500; letter-spacing: 1.4px; color: #82916e; margin-bottom: 16px; }
  .documentation-content h2 { font-size: clamp(30px, 3vw, 40px); line-height: 1.12; letter-spacing: -.035em; margin-bottom: 21px; }
  .documentation-content h3 { font-size: 14px; font-weight: 500; margin: 27px 0 12px; }
  .documentation-content section > p:not(.section-number) { font-size: 15px; line-height: 1.85; color: #5d685b; margin-top: 16px; }
  .documentation-content strong { color: #3f523f; font-weight: 500; }
  .hardware-list { margin: 27px 0; }
  .hardware-list > div { display: grid; grid-template-columns: 135px 1fr; padding: 17px 0; gap: 20px; border-bottom: 1px solid var(--line); }
  .hardware-list > div:first-child { border-top: 1px solid var(--line); }
  .hardware-list dt { font-size: 12px; font-weight: 500; color: #44583f; }
  .hardware-list dd { margin: 0; color: #69715f; font-size: 13px; line-height: 1.8; }
  .documentation-content section > .small-note { color: #7b836f; font-size: 11px; line-height: 1.8; }
  .path-notes { margin: 25px 0; border: 1px solid #d4dac9; padding: 5px 23px; background: #eeeee4; }
  .path-notes > div { display: flex; gap: 19px; padding: 23px 0; }
  .path-notes > div + div { border-top: 1px solid #d4dac9; }
  .path-notes > div > span { font-size: 9px; margin-top: 4px; color: #879872; }
  .path-notes h3 { margin: 0 0 8px; font-weight: 500; font-size: 13px; }
  .path-notes p { font-size: 13px; line-height: 1.8; color: #67745d; }
  .documentation-content .text-link { margin-top: 18px; font-size: 11px; }
  .schedule-table-wrap { overflow-x: auto; margin: 25px 0; }
  .schedule-table-wrap:focus-visible { outline: 2px solid var(--orange); outline-offset: 4px; }
  table { width: 100%; min-width: 480px; border-collapse: collapse; text-align: left; font-size: 12px; line-height: 1.7; }
  caption { text-align: left; color: #839075; font-size: 9px; letter-spacing: .03em; padding-bottom: 13px; }
  th, td { padding: 16px; border: 1px solid var(--line); vertical-align: top; }
  thead th { background: #e9ecdf; color: #4b6042; font-size: 10px; font-weight: 500; }
  tbody th { font-weight: 500; color: #4d5c47; width: 33%; }
  td { color: #727a68; }
  td strong { display: inline-block; margin-top: 3px; }
  .status-note { padding: 23px; margin: 24px 0; background: #edf0e3; border-left: 2px solid #899a6e; }
  .status-label { font-size: 8px; letter-spacing: .9px; color: #637a4d; font-weight: 500; }
  .status-note p { font-size: 13px; line-height: 1.85; color: #63715a; margin-top: 12px; }
  .documentation-content :global(.button) { margin-top: 23px; font-size: 11px; }
  .limitations-list { list-style: none; margin: 25px 0; padding: 0; }
  .limitations-list li { position: relative; padding-left: 21px; font-size: 14px; line-height: 1.85; color: #697160; margin-bottom: 20px; }
  .limitations-list li::before { content: ''; width: 5px; height: 5px; position: absolute; left: 1px; top: 9px; background: #c58463; border-radius: 50%; }
  .documentation-closing { padding-top: 2px; }
  .documentation-closing p { font-family: var(--font-display); font-size: 30px; color: var(--olive); font-style: italic; }
  @media (max-width: 1050px) {
    .documentation-layout { grid-template-columns: 210px minmax(0, 1fr); gap: 40px; }
    .hardware-list > div { grid-template-columns: 110px 1fr; gap: 18px; }
  }
  @media (max-width: 760px) {
    .documentation-page { padding-top: 23px; padding-bottom: 75px; }
    .documentation-layout { display: block; padding-top: 30px; }
    .documentation-sidebar { border-bottom: 1px solid var(--line); padding-bottom: 24px; margin-bottom: 33px; }
    .documentation-sidebar nav { position: static; }
    .documentation-sidebar ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 22px; margin: 11px 0 7px; }
    .documentation-sidebar li a { font-size: 10px; gap: 8px; padding-block: 9px; }
    .diagram-link { border: 0; padding-top: 14px; }
    .document-context { margin-bottom: 37px; padding: 18px; }
    .documentation-content section { padding-bottom: 32px; margin-bottom: 36px; }
    .documentation-content section > p:not(.section-number) { font-size: 14px; }
    .hardware-list > div { grid-template-columns: 1fr; gap: 7px; }
    .hardware-list dd { font-size: 13px; }
    .path-notes { padding-inline: 18px; }
    .path-notes > div { gap: 14px; padding-block: 20px; }
    .schedule-table-wrap { margin-right: 0; }
    th, td { padding: 12px; }
  }
  @media print {
    .documentation-sidebar, .return-link, .documentation-closing { display: none; }
    .documentation-layout { display: block; }
    .documentation-content section { break-inside: avoid; }
    .documentation-page { padding: 20px; }
  }
</style>
