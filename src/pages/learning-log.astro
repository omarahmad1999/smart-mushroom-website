---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const lessons = [
  {
    number: '01',
    title: 'One failing sensor can silence the whole system.',
    tag: 'RELIABILITY',
    body: 'By 31 August, the investigation found that sensor records had stopped after 24 August. Repeated SCD41 initialization failures appeared to make the shared sensor publisher exit, interrupting the other sensors too.',
    takeaway: 'The lesson: isolate device failures so one unavailable sensor does not take the rest of the observations with it. This describes a historical incident, not the current service status.',
  },
  {
    number: '02',
    title: 'A restart is not the same as a recovery.',
    tag: 'OPERATIONS',
    body: 'The sensor service entered a large restart loop. In a separate incident, restarting the camera timer produced an unexpected additional capture. A process can be running while its behavior is still wrong.',
    takeaway: 'The lesson: judge recovery by the intended outcome, and make scheduled actions safe to repeat.',
  },
  {
    number: '03',
    title: 'An environmental reference has limits.',
    tag: 'EXPERIMENT DESIGN',
    body: 'The room provides an ambient reference for the tent’s environmental measurements. That alone does not establish a matched mushroom crop outside the tent, or a biological control experiment.',
    takeaway: 'The lesson: explain what the comparison can support before making claims about growth, yield, or causation.',
  },
  {
    number: '04',
    title: 'An incomplete record is still part of the story.',
    tag: 'RESEARCH PRACTICE',
    body: 'Missing observations, unsettled control thresholds, and unfinished integrations all affect how this project should be interpreted. They belong alongside the hardware and the successful parts of the build.',
    takeaway: 'The lesson: keep the uncertainty visible. Use Grafana to inspect the measurement record, and distinguish demonstrated results from the work still ahead.',
  },
];
---
<BaseLayout title="Learning Log — Smart Mushroom Hub" description="Challenges, failures, and lessons from the first mushroom cultivation run.">
  <article class="learning-page">
    <a href="/#experiment" class="text-link">Back to the experiment <Icon name="arrow-right" /></a>
    <header><p class="eyebrow"><span class="eyebrow-dot"></span> THE LEARNING LOG</p><h1>The failures<br /><em>belong here, too.</em></h1><p>A useful experiment leaves room for inconvenient evidence. The interruptions and unfinished work are part of understanding this system.</p><p class="context">Notes from the first cultivation run. Historical incidents, not live status.</p></header>
    <div class="learning-entries">{lessons.map(lesson=><section class="learning-entry" aria-labelledby={`lesson-${lesson.number}`}><span class="entry-number">{lesson.number}</span><div><p class="eyebrow">{lesson.tag}</p><h2 id={`lesson-${lesson.number}`}>{lesson.title}</h2><p>{lesson.body}</p><p class="takeaway">{lesson.takeaway}</p></div></section>)}</div>
    <a href="/documentation/" class="text-link">Explore the field notes <Icon /></a>
  </article>
</BaseLayout>
<style>
.learning-page{width:min(var(--page-width),calc(100% - 2 * var(--page-pad)));margin:auto;padding:60px 0 110px}.learning-page header{padding:65px 0 55px;max-width:760px}.learning-page h1{font-size:clamp(48px,6vw,82px);letter-spacing:-.04em;line-height:1.04;margin:26px 0}.learning-page h1 em{color:var(--olive)}.learning-page p{font-size:14px;line-height:1.85;color:var(--muted)}.learning-page .eyebrow{font-size:10px;color:var(--olive)}.learning-page .context{font-size:11px;margin-top:20px}.learning-entry{display:grid;grid-template-columns:50px 1fr;gap:30px;border-top:1px solid var(--line);padding:38px 0}.entry-number{font-family:var(--font-display);font-size:30px;color:var(--olive)}.learning-entry h2{font-size:clamp(27px,3vw,38px);line-height:1.14;margin:14px 0 22px}.learning-entry .takeaway{margin-top:20px;color:var(--ink);border-left:2px solid var(--orange);padding-left:20px}.learning-entries{max-width:1000px;margin-bottom:30px}@media(max-width:600px){.learning-page{padding-top:30px}.learning-page header{padding-top:40px}.learning-entry{grid-template-columns:24px 1fr;gap:15px}}
</style>
